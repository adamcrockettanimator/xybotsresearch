+void xybots_state::xybots_write_playfield_metadata(const char *path, screen_device &screen, const rectangle &cliprect)
+{
+	rapidjson::StringBuffer buffer;
+	rapidjson::PrettyWriter<rapidjson::StringBuffer> writer(buffer);
+
+	writer.StartObject();
+	writer.Key("game");
+	writer.String("xybots");
+	writer.Key("emulated_frame");
+	writer.Uint64(screen.frame_number());
+
+	writer.Key("screen");
+	writer.StartObject();
+	writer.Key("width");
+	writer.Int(cliprect.width());
+	writer.Key("height");
+	writer.Int(cliprect.height());
+	writer.EndObject();
+
+	writer.Key("playfield");
+	writer.StartObject();
+	writer.Key("columns");
+	writer.Int(64);
+	writer.Key("rows");
+	writer.Int(32);
+	writer.Key("tile_width");
+	writer.Int(8);
+	writer.Key("tile_height");
+	writer.Int(8);
+	writer.Key("width_pixels");
+	writer.Int(512);
+	writer.Key("height_pixels");
+	writer.Int(256);
+	writer.EndObject();
+
+	writer.Key("tiles");
+	writer.StartArray();
+	for (int tile_index = 0; tile_index < 64 * 32; tile_index++)
+	{
+		u16 const data = m_playfield_tilemap->basemem_read(tile_index);
+		int const map_x = tile_index % 64;
+		int const map_y = tile_index / 64;
+		int const code = data & 0x1fff;
+		int const color = (data >> 11) & 0x0f;
+		int const flag = (data >> 15) & 1;
+
+		writer.StartObject();
+		writer.Key("tile_index");
+		writer.Int(tile_index);
+		writer.Key("map_x");
+		writer.Int(map_x);
+		writer.Key("map_y");
+		writer.Int(map_y);
+		writer.Key("screen_x");
+		writer.Int(map_x * 8);
+		writer.Key("screen_y");
+		writer.Int(map_y * 8);
+		writer.Key("raw");
+		std::string const raw = util::string_format("0x%04X", data);
+		writer.String(raw.c_str());
+		writer.Key("code");
+		writer.Int(code);
+		writer.Key("code_hex");
+		std::string const code_hex = util::string_format("0x%04X", code);
+		writer.String(code_hex.c_str());
+		writer.Key("color");
+		writer.Int(color);
+		writer.Key("flag");
+		writer.Int(flag);
+		writer.EndObject();
+	}
+	writer.EndArray();
+	writer.EndObject();
+
+	emu_file file(machine().options().snapshot_directory(), OPEN_FLAG_WRITE | OPEN_FLAG_CREATE | OPEN_FLAG_CREATE_PATHS);
+	std::error_condition const filerr = file.open(path);
+	if (filerr)
+	{
+		osd_printf_error("[xybots-capture] Error opening %s (%s)\n", path, filerr.message().c_str());
+		return;
+	}
+	auto const [writeerr, actual] = util::write(file, buffer.GetString(), buffer.GetSize());
+	if (writeerr || (actual != buffer.GetSize()))
+		osd_printf_error("[xybots-capture] Error writing %s (%s)\n", path, writeerr.message().c_str());
+}
