+
+void xybots_state::xybots_create_capture_dirs(const std::string &capture_dir, bool objects_dir)
+{
+	std::filesystem::path path = std::filesystem::path(xybots_snapshot_root()) / capture_dir;
+	if (objects_dir)
+		path /= "objects";
+	std::error_code direrr;
+	std::filesystem::create_directories(path, direrr);
+	if (direrr)
+		osd_printf_error("[xybots-capture] Error creating %s (%s)\n", capture_dir.c_str(), direrr.message().c_str());
+}
+
+
+int xybots_state::xybots_latest_wall_recording_index()
+{
+	std::filesystem::path const recordings_dir = std::filesystem::path(xybots_snapshot_root()) / "xybots_capture" / "wall_turn_recordings";
+	std::error_code direrr;
+	if (!std::filesystem::is_directory(recordings_dir, direrr))
+		return 0;
+
+	int latest = 0;
+	for (std::filesystem::directory_iterator it(recordings_dir, direrr), end; !direrr && (it != end); it.increment(direrr))
+	{
+		if (!it->is_directory(direrr))
+			continue;
+
+		std::string const name = it->path().filename().string();
+		if ((name.length() != 12) || (name.compare(0, 8, "session_") != 0))
+			continue;
+
+		char const *const digits = name.c_str() + 8;
+		bool numeric = true;
+		for (int i = 0; i < 4; i++)
+			if ((digits[i] < '0') || (digits[i] > '9'))
+				numeric = false;
+
+		if (numeric)
+			latest = std::max(latest, std::atoi(digits));
+	}
+
+	if (direrr)
+		osd_printf_error("[xybots-capture] Error scanning %s (%s)\n", recordings_dir.string().c_str(), direrr.message().c_str());
+
+	return latest;
+}
