+
+bool xybots_state::xybots_screen_rect(const xybots_mo_capture_record &object, const rectangle &cliprect, rectangle &rect)
+{
+	rect = rectangle(object.rendered_x, object.rendered_x + object.width_tiles * 8 - 1, object.rendered_y, object.rendered_y + object.height_tiles * 8 - 1);
+	rect &= cliprect;
+	return !rect.empty();
+}
+
+
+bool xybots_state::xybots_group_rects_touch(const rectangle &left, const rectangle &right)
+{
+	rectangle expanded(left.left() - 2, left.right() + 2, left.top() - 2, left.bottom() + 2);
+	expanded &= right;
+	return !expanded.empty();
+}
+
+
+bool xybots_state::xybots_group_rects_character_related(const rectangle &left, const rectangle &right)
+{
+	rectangle expanded(left.left() - 16, left.right() + 16, left.top() - 16, left.bottom() + 16);
+	expanded &= right;
+	if (expanded.empty())
+		return false;
+
+	rectangle bounds = left;
+	bounds |= right;
+	if (bounds.width() > 96 || bounds.height() > 112)
+		return false;
+
+	bool const horizontal_overlap = !(left.right() < right.left() || right.right() < left.left());
+	bool const vertical_overlap = !(left.bottom() < right.top() || right.bottom() < left.top());
+	if (horizontal_overlap || vertical_overlap)
+		return true;
+
+	int const left_cx = (left.left() + left.right()) / 2;
+	int const left_cy = (left.top() + left.bottom()) / 2;
+	int const right_cx = (right.left() + right.right()) / 2;
+	int const right_cy = (right.top() + right.bottom()) / 2;
+	return std::abs(left_cx - right_cx) <= 48 && std::abs(left_cy - right_cy) <= 64;
+}
+
+
+void xybots_state::xybots_blit_argb(bitmap_argb32 &dest, const bitmap_argb32 &src, int dest_x, int dest_y)
+{
+	for (int y = 0; y < src.height(); y++)
+	{
+		int const target_y = dest_y + y;
+		if (target_y < 0 || target_y >= dest.height())
+			continue;
+
+		for (int x = 0; x < src.width(); x++)
+		{
+			int const target_x = dest_x + x;
+			if (target_x < 0 || target_x >= dest.width())
+				continue;
+
+			u32 const pixel = src.pix(y, x);
+			if (rgb_t(pixel).a())
+				dest.pix(target_y, target_x) = pixel;
+		}
+	}
+}
+
+
+void xybots_state::xybots_collect_motion_objects(std::vector<xybots_mo_capture_record> &objects)
+{
+	u16 const *const spriteram = m_mob->spriteram();
+	objects.clear();
+	objects.reserve(64);
+
+	for (int slot = 0; slot < 64; slot++)
+	{
+		u16 const *const entry = &spriteram[slot * 4];
+		xybots_mo_capture_record object;
+		object.slot = slot;
+		object.raw = { entry[0], entry[1], entry[2], entry[3] };
+		object.code = entry[0] & 0x3fff;
+		object.color = entry[3] & 0x000f;
+		object.raw_x = (entry[3] & 0xff80) >> 7;
+		object.raw_y = (entry[2] & 0xff80) >> 7;
+		object.rendered_x = object.raw_x;
+		object.rendered_y = -object.raw_y;
+		object.width_tiles = 1;
+		object.height_tiles = (entry[2] & 0x0007) + 1;
+		object.hflip = bool(entry[0] & 0x8000);
+		object.vflip = false;
+		object.priority = entry[1] & 0x000f;
+
+		object.rendered_y -= object.height_tiles * 8;
+		object.rendered_x &= 0x1ff;
+		object.rendered_y &= 0x1ff;
+		if (object.rendered_x >= m_mob->bitmap().width())
+			object.rendered_x -= 0x200;
+		if (object.rendered_y >= m_mob->bitmap().height())
+			object.rendered_y -= 0x200;
+
+		for (int tile = 0; tile < object.height_tiles; tile++)
+			object.source_tiles.push_back(object.code + tile);
+
+		objects.push_back(std::move(object));
+	}
+}
+
+
+void xybots_state::xybots_render_object_bitmap(const xybots_mo_capture_record &object, bitmap_ind16 &bitmap)
+{
+	bitmap.fill(0xffff);
+
+	gfx_element *const gfx = m_gfxdecode->gfx(1);
+	u32 const color = 0x100 + (object.color * gfx->granularity()) + (object.priority << atari_motion_objects_device::PRIORITY_SHIFT);
+	rectangle const cliprect = bitmap.cliprect();
+
+	for (int tile = 0; tile < object.height_tiles; tile++)
+	{
+		int const local_y = object.vflip ? ((object.height_tiles - 1 - tile) * 8) : (tile * 8);
+		gfx->transpen_raw(bitmap, cliprect, object.code + tile, color, object.hflip, object.vflip, 0, local_y, 0);
+	}
+}
+
+
+void xybots_state::xybots_convert_mobitmap(bitmap_argb32 &dest, const bitmap_ind16 &src, const rectangle &cliprect)
+{
+	rgb_t const *const palette = m_screen->palette().palette()->entry_list_adjusted();
+
+	for (int y = 0; y < dest.height(); y++)
+	{
+		u32 *const dst = &dest.pix(y);
+		u16 const *const source = &src.pix(cliprect.top() + y, cliprect.left());
+		for (int x = 0; x < dest.width(); x++)
+		{
+			u16 const pixel = source[x];
+			dst[x] = (pixel == 0xffff) ? rgb_t::transparent() : palette[pixel & atari_motion_objects_device::DATA_MASK];
+		}
+	}
+}
+
+
+void xybots_state::xybots_convert_indexed_bitmap(bitmap_argb32 &dest, const bitmap_ind16 &src, const rectangle &cliprect)
+{
+	rgb_t const *const palette = m_screen->palette().palette()->entry_list_adjusted();
+
+	for (int y = 0; y < dest.height(); y++)
+	{
+		u32 *const dst = &dest.pix(y);
+		u16 const *const source = &src.pix(cliprect.top() + y, cliprect.left());
+		for (int x = 0; x < dest.width(); x++)
+		{
+			u16 const pixel = source[x];
+			dst[x] = (pixel == 0xffff) ? rgb_t::transparent() : palette[pixel];
+		}
+	}
+}
+
+
+void xybots_state::xybots_write_png(const char *path, const bitmap_argb32 &bitmap)
+{
+	emu_file file(machine().options().snapshot_directory(), OPEN_FLAG_WRITE | OPEN_FLAG_CREATE | OPEN_FLAG_CREATE_PATHS);
+	std::error_condition const filerr = file.open(path);
+	if (filerr)
+	{
+		osd_printf_error("[xybots-capture] Error opening %s (%s)\n", path, filerr.message().c_str());
+		return;
+	}
+
+	util::png_info pnginfo;
+	std::error_condition const pngerr = util::png_write_bitmap(file, &pnginfo, bitmap, 0, nullptr);
+	if (pngerr)
+		osd_printf_error("[xybots-capture] Error writing %s (%s)\n", path, pngerr.message().c_str());
+}
