+void xybots_state::xybots_write_playfield_debug_layer(const char *path, const bitmap_argb32 &playfield_layer)
+{
+	bitmap_argb32 debug(playfield_layer.width(), playfield_layer.height());
+	for (int y = 0; y < playfield_layer.height(); y++)
+	{
+		u32 *const dst = &debug.pix(y);
+		u32 const *const src = &playfield_layer.pix(y);
+		for (int x = 0; x < playfield_layer.width(); x++)
+			dst[x] = src[x];
+	}
+
+	for (int y = 0; y < debug.height(); y += 8)
+		for (int x = 0; x < debug.width(); x++)
+			debug.pix(y, x) = rgb_t(64, 64, 64);
+
+	for (int x = 0; x < debug.width(); x += 8)
+		for (int y = 0; y < debug.height(); y++)
+			debug.pix(y, x) = rgb_t(64, 64, 64);
+
+	for (int tile_index = 0; tile_index < 64 * 32; tile_index++)
+	{
+		int const map_x = tile_index % 64;
+		int const map_y = tile_index / 64;
+		int const screen_x = map_x * 8;
+		int const screen_y = map_y * 8;
+		if (screen_x < 0 || screen_x >= debug.width() || screen_y < 0 || screen_y >= debug.height())
+			continue;
+
+		u16 const data = m_playfield_tilemap->basemem_read(tile_index);
+		int const code = data & 0x1fff;
+		xybots_draw_debug_text(debug, screen_x + 1, screen_y + 1, util::string_format("%03X", code & 0xfff), rgb_t(255, 255, 0));
+	}
+
+	xybots_write_png(path, debug);
+}
+
+
+void xybots_state::xybots_write_debug_layer(const char *path, const bitmap_argb32 &sprite_layer, const std::vector<xybots_mo_capture_record> &objects)
+{
+	bitmap_argb32 debug(sprite_layer.width(), sprite_layer.height());
+	for (int y = 0; y < sprite_layer.height(); y++)
+	{
+		u32 *const dst = &debug.pix(y);
+		u32 const *const src = &sprite_layer.pix(y);
+		for (int x = 0; x < sprite_layer.width(); x++)
+			dst[x] = src[x];
+	}
+
+	for (xybots_mo_capture_record const &object : objects)
+	{
+		if (!object.visible)
+			continue;
+
+		xybots_draw_debug_rect(debug, object.rendered_x, object.rendered_y, object.width_tiles * 8, object.height_tiles * 8, rgb_t(255, 255, 0));
+		xybots_draw_debug_text(debug, object.rendered_x, object.rendered_y, util::string_format("%02d", object.slot), rgb_t(255, 255, 255));
+		xybots_draw_debug_text(debug, object.rendered_x, object.rendered_y + 6, util::string_format("C:%04X", object.code), rgb_t(255, 255, 0));
+	}
+
+	xybots_write_png(path, debug);
+}
