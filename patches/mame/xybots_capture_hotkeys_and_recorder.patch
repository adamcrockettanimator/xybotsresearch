+void xybots_state::xybots_auto_script_start_recording(const char *label)
+{
+	if (m_xybots_wall_recording)
+		xybots_auto_script_stop_recording();
+
+	m_xybots_wall_recording_index++;
+	m_xybots_wall_recording_frame = 0;
+	m_xybots_last_wall_recording_frame = ~u64(0);
+
+	std::string const session_dir = util::string_format("xybots_capture/wall_turn_recordings/session_%04d", m_xybots_wall_recording_index);
+	xybots_create_capture_dirs(session_dir + "/playfield", false);
+	xybots_create_capture_dirs(session_dir + "/tiles", false);
+
+	std::filesystem::path const label_path = std::filesystem::path(xybots_snapshot_root()) / session_dir / "label.txt";
+	std::ofstream label_file(label_path);
+	label_file << label << "\n";
+
+	m_xybots_wall_recording = true;
+	osd_printf_info("[xybots-auto-script] recording %s: %s\n", session_dir.c_str(), label);
+}
+
+
+void xybots_state::xybots_auto_script_stop_recording()
+{
+	if (!m_xybots_wall_recording)
+		return;
+
+	osd_printf_info("[xybots-auto-script] recording off after %d frames\n", m_xybots_wall_recording_frame);
+	m_xybots_wall_recording = false;
+}
+
+
+void xybots_state::xybots_update_auto_script()
+{
+	if (!m_xybots_auto_script)
+		return;
+
+	if (m_xybots_auto_script_wait_trigger && (m_xybots_auto_script_frame == 0))
+	{
+		std::filesystem::path const trigger_path = std::filesystem::path(xybots_snapshot_root()) / "xybots_capture" / "start_controlled_capture.txt";
+		std::error_code err;
+		if (!std::filesystem::exists(trigger_path, err))
+			return;
+
+		std::filesystem::remove(trigger_path, err);
+		m_xybots_auto_script_frame = 699;
+		osd_printf_info("[xybots-auto-script] Trigger received; recording controlled movement sessions\n");
+	}
+
+	m_xybots_auto_script_frame++;
+
+	switch (m_xybots_auto_script_frame)
+	{
+	case 720: xybots_auto_script_start_recording("forward_one_tile_up"); break;
+	case 860: xybots_auto_script_stop_recording(); break;
+	case 900: xybots_auto_script_start_recording("backward_one_tile_down"); break;
+	case 1040: xybots_auto_script_stop_recording(); break;
+	case 1080: xybots_auto_script_start_recording("turn_left_button2"); break;
+	case 1200: xybots_auto_script_stop_recording(); break;
+	case 1240: xybots_auto_script_start_recording("turn_right_button3"); break;
+	case 1360: xybots_auto_script_stop_recording(); break;
+	case 1400: xybots_auto_script_start_recording("strafe_left"); break;
+	case 1540: xybots_auto_script_stop_recording(); break;
+	case 1580: xybots_auto_script_start_recording("strafe_right"); break;
+	case 1720: xybots_auto_script_stop_recording(); break;
+	default: break;
+	}
+}
