+void xybots_state::xybots_wall_record_frame(screen_device &screen)
+{
+	u64 const frame_number = screen.frame_number();
+	if (m_xybots_last_wall_recording_frame == frame_number)
+		return;
+
+	m_xybots_last_wall_recording_frame = frame_number;
+	m_xybots_wall_recording_frame++;
+
+	rectangle const capture_rect = screen.visible_area();
+	bitmap_ind16 playfield_ind(capture_rect.width(), capture_rect.height());
+	playfield_ind.fill(0xffff);
+	m_playfield_tilemap->draw(screen, playfield_ind, capture_rect, 0, 0);
+
+	bitmap_argb32 playfield_layer(capture_rect.width(), capture_rect.height());
+	xybots_convert_indexed_bitmap(playfield_layer, playfield_ind, playfield_ind.cliprect());
+
+	std::string const session_dir = util::string_format("xybots_capture/wall_turn_recordings/session_%04d", m_xybots_wall_recording_index);
+	std::string const basename = util::string_format("frame_%05d", m_xybots_wall_recording_frame);
+	xybots_write_png((session_dir + "/playfield/" + basename + ".png").c_str(), playfield_layer);
+	xybots_write_playfield_metadata((session_dir + "/tiles/" + basename + ".json").c_str(), screen, capture_rect);
+
+	if ((m_xybots_wall_recording_frame % 30) == 0)
+		osd_printf_info("[xybots-capture] Wall turn recording %d frames\n", m_xybots_wall_recording_frame);
+}
