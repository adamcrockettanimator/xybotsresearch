+
+u16 xybots_state::xybots_auto_script_input_mask()
+{
+	if (!m_xybots_auto_script)
+		return 0;
+
+	switch (m_xybots_auto_script_frame)
+	{
+	case 60 ... 90: return 0x0100; // any key / P1 start
+	case 300 ... 360: return 0x0100; // P1 start
+	case 750 ... 762: return 0x8000; // P1 joystick up
+	case 930 ... 942: return 0x4000; // P1 joystick down
+	case 1110 ... 1122: return 0x0800; // P1 twist left
+	case 1270 ... 1282: return 0x0400; // P1 twist right
+	case 1430 ... 1442: return 0x2000; // P1 joystick left
+	case 1610 ... 1622: return 0x1000; // P1 joystick right
+	default: return 0;
+	}
+}
