# _nearest_projectile_player_hit: Finds the closest opposing body intersected by this projectile path.
func _nearest_projectile_player_hit(owner: int, origin: Vector2, direction: Vector2, maximum_distance: float, shot_crouched: bool) -> Dictionary:
	var nearest_distance := maximum_distance + 0.001                                           # Keep the first body beyond any possible hit by default.
	var nearest_player := -1                                                                    # Track which body owns that nearest intersection.
	for player_index in range(player_states.size()):                                           # Check each currently active local player.
		if player_index == owner or (player_index < player_joined.size() and not player_joined[player_index]) or PLAYER_TEAMS[player_index] == PLAYER_TEAMS[owner]: # No self hits, unjoined ghosts, or friendly fire.
			continue                                                                                   # Skip this candidate.
		if bool(player_states[player_index].get("is_dying", false)):                            # Do not let stray bullets repeatedly hit a fallen or respawning body.
			continue                                                                                   # The player becomes targetable again only after the reverse Death animation finishes.
		if bool(player_states[player_index].get("character_is_crouching", false)) and not shot_crouched:
			continue                                                                                   # Standing shots pass over a crouched body; crouched shots still hit both stances.
		var distance := _ray_circle_hit_distance(origin, direction, _player_state_world_position(player_states[player_index]), PROJECTILE_PLAYER_RADIUS) # Test the compact player body circle.
		if distance < 0.0 or distance > maximum_distance:                                        # Ignore bodies that the projectile ray does not reach during this segment.
			continue                                                                                   # Leave the candidate out of the nearest-hit test.
		var wall_distance := _nearest_projectile_wall_distance(origin, direction, distance)       # Re-test the exact body-contact interval against every physical wall edge.
		if wall_distance <= distance + PROJECTILE_WALL_EPSILON:                                   # A wall at or before the body contact always owns this shot.
			continue                                                                                   # Reject the body so neither immediate nor later simulation can damage through it.
		if distance < nearest_distance:                                                            # Retain only a nearer, unobstructed body hit.
			nearest_distance = distance                                                               # Store the collision distance.
			nearest_player = player_index                                                            # Store the player index.
	if nearest_player < 0:                                                                      # Return empty data when no opposing body was hit.
		return {}                                                                                   # Let wall/no-hit logic continue.
	return {"player_index": nearest_player, "distance": nearest_distance}                   # Return the nearest player collision.


# _ray_circle_hit_distance: Returns a first forward ray hit against a small world-space player circle.
func _ray_circle_hit_distance(origin: Vector2, direction: Vector2, circle_center: Vector2, radius: float) -> float:
	var offset := origin - circle_center                                                        # Measure from target center to ray origin.
	var b := offset.dot(direction)                                                              # Solve the quadratic's linear term for normalized direction.
	var c := offset.length_squared() - radius * radius                                         # Solve the quadratic's constant term.
	var discriminant := b * b - c                                                               # Check whether the ray actually reaches the circle.
	if discriminant < 0.0:                                                                      # No real intersection exists.
		return -1.0                                                                                # Report no body hit.
	var root := sqrt(discriminant)                                                              # Read the positive discriminant square root.
	var near_distance := -b - root                                                             # Prefer the entering contact point.
	return near_distance if near_distance >= 0.0 else -b + root                                # Use the exiting point only when the ray starts inside the body.


# _spawn_blood_splatter: Emits one-pixel red droplets through a struck character along the bullet path, optionally retaining every killing-shot surface mark through its respawn countdown.
func _spawn_blood_splatter(world_position: Vector2, direction: Vector2, victim_player_index := -1, persist_killing_shot := false) -> void:
	var shot_direction := direction.normalized()                                                # Preserve the real projectile trajectory so an entry from the back exits toward the character's front.
	var lateral := Vector2(-shot_direction.y, shot_direction.x)                                # Spread a smaller portion of the spray sideways around that forward-biased exit path.
	for particle_index in range(BLOOD_SPLATTER_PARTICLE_COUNT):
		var forward_speed := randf_range(0.32, 0.92)                                              # Make most droplets continue in the same direction as the bullet after passing through the target.
		if randf() < 0.18:
			forward_speed *= -randf_range(0.12, 0.38)                                               # Permit a restrained minority of back-spray without reversing the overall visual trajectory.
		var horizontal_velocity := shot_direction * forward_speed + lateral * randf_range(-0.20, 0.20) # Combine strong bullet-direction exit with a narrow natural sideways burst.
		var initial_position := world_position + shot_direction * 0.025                          # Start just beyond the entering contact so the spray reads as exiting the struck character.
		var initial_height := randf_range(0.56, 0.88)                                            # Release droplets around the raised body hit point rather than from the floor.
		active_blood_splatters.append({"id": next_combat_visual_id, "position": initial_position, "display_position": initial_position, "horizontal_velocity": horizontal_velocity, "direction": horizontal_velocity.normalized(), "height": initial_height, "display_height": initial_height, "vertical_velocity": randf_range(-0.45, 1.05), "visual_step_timer": BLOOD_SPLATTER_VISUAL_FRAME_DURATION, "stuck": false, "stuck_surface": "", "wall_edge_key": "", "victim_player_index": victim_player_index, "persistent_killing_shot": persist_killing_shot, "timer": BLOOD_SPLATTER_FLIGHT_LIFETIME}) # Keep every blood drop as a literal one-pixel world particle until it sticks to its first surface.
		next_combat_visual_id += 1                                                               # Give each cached red pixel a stable per-view visual key.

# _nearest_joined_player_distance: Returns the closest active viewer in grid-cell world units for shared effect spawn LOD.
func _nearest_joined_player_distance(world_position: Vector2) -> float:
	var nearest_distance := INF
	for player_index in range(player_states.size()):
		if player_index >= player_joined.size() or not player_joined[player_index]:
			continue                                                                                  # Unjoined slots have spawn positions but no camera that can benefit from a close-impact effect.
		nearest_distance = minf(nearest_distance, _player_state_world_position(player_states[player_index]).distance_to(world_position))
	return nearest_distance


# _spawn_impact: Emits only wall-strike debris and a decal at an actual shared-world collision point; player hits retain their existing body reaction without a wall effect.
func _spawn_impact(world_position: Vector2, direction: Vector2, hit_player_index: int, wall_edge_key := "", impact_height := 0.72, barrel_hit := false, barrel_id := -1) -> void:
	if hit_player_index >= 0 or (wall_edge_key.is_empty() and not barrel_hit):
		return                                                                                    # A body strike uses its dedicated hit reaction; only a physical wall dislodges wood splinters and receives a decal.
	var barrel_center := world_position
	if barrel_hit:
		for barrel in world_barrels:
			if int(barrel.get("id", -1)) == barrel_id:
				barrel_center = Vector2(barrel["position"])
				break
	var away_from_wall := -direction.normalized()                                               # Send debris back into the side from which the bullet arrived.
	var tangent := Vector2(-away_from_wall.y, away_from_wall.x)                                # Spread square chunks along the struck wall as well as straight back from it.
	var nearest_player_distance := _nearest_joined_player_distance(world_position)               # Pick one shared particle tier from the closest camera so a near split-screen player never receives a reduced impact.
	var use_far_debris_lod := nearest_player_distance > WALL_DEBRIS_LOD_DISTANCE_CELLS
	var debris_count := randi_range(WALL_DEBRIS_FAR_COUNT_MIN, WALL_DEBRIS_FAR_COUNT_MAX) if use_far_debris_lod else randi_range(WALL_DEBRIS_NEAR_COUNT_MIN, WALL_DEBRIS_NEAR_COUNT_MAX)
	var debris_bounce_count := randi_range(WALL_DEBRIS_FAR_BOUNCE_COUNT_MIN, WALL_DEBRIS_FAR_BOUNCE_COUNT_MAX) if use_far_debris_lod else randi_range(WALL_DEBRIS_NEAR_BOUNCE_COUNT_MIN, WALL_DEBRIS_NEAR_BOUNCE_COUNT_MAX)
	var debris_visual_frame_duration := 1.0 / (WALL_DEBRIS_FAR_VISUAL_FPS if use_far_debris_lod else WALL_DEBRIS_NEAR_VISUAL_FPS)
	var debris_ground_fade_seconds := WALL_DEBRIS_FAR_GROUND_FADE_SECONDS if use_far_debris_lod else WALL_DEBRIS_NEAR_GROUND_FADE_SECONDS
	for smoke_card_index in range(randi_range(WALL_IMPACT_SMOKE_MIN_CARDS, WALL_IMPACT_SMOKE_MAX_CARDS)):
		var dust_position := world_position + away_from_wall * 0.006                              # Separate the card slightly from the wall face so it never appears buried in the texture.
		var dust_velocity := away_from_wall * randf_range(0.027, 0.120) + tangent * randf_range(-.4, .4) # Spread the three wall cards 50% farther away and sideways so the burst reads as several material puffs rather than one round cloud.
		var dust_vertical_velocity := randf_range(-.4, .4)                                   # Fill the third dimension: most cards lift from the impact, while a few drop below it like heavier disturbed material.
		active_wall_impact_smokes.append({"id": next_combat_visual_id, "position": dust_position, "display_position": dust_position, "velocity": dust_velocity, "turbulence": Vector2(randf_range(-0.018, 0.018), randf_range(-0.018, 0.018)), "height": impact_height - 0.72, "display_height": impact_height - 0.72, "vertical_velocity": dust_vertical_velocity, "rotation": float(randi() % 4) * MUZZLE_SMOKE_ROTATION_INCREMENT, "display_rotation": 0.0, "angular_velocity": randf_range(-6.0, 6.0), "visual_step_timer": MUZZLE_SMOKE_VISUAL_FRAME_DURATION, "visual_frame": 0, "base_scale": randf_range(0.90, 1.35), "cloud_variant": randi() % MUZZLE_SMOKE_CLOUD_VARIANTS, "color_sample_index": randi() % 4, "opacity": randf_range(0.72, 0.95), "direction": direction, "wall_edge_key": wall_edge_key, "sample_position": world_position, "barrel_center": barrel_center, "barrel_impact_height": impact_height, "barrel_hit": barrel_hit, "timer": WALL_IMPACT_SMOKE_LIFETIME})
		next_combat_visual_id += 1                                                                # Give each wall-dust card a stable cache identity.
	active_wall_bullet_holes.append({"id": next_combat_visual_id, "position": world_position, "direction": direction, "wall_edge_key": wall_edge_key, "height": impact_height, "barrel_hit": barrel_hit, "barrel_id": barrel_id, "timer": WALL_BULLET_HOLE_DURATION})
	next_combat_visual_id += 1                                                                  # Reserve a stable decal key.
	for chunk_index in range(debris_count):
		var lateral_spread := randf_range(-0.72, 0.72)                                             # Let some chunks peel strongly sideways along the wall instead of every splinter following the same path.
		var horizontal_velocity := away_from_wall * randf_range(WALL_DEBRIS_AWAY_SPEED_MIN, WALL_DEBRIS_AWAY_SPEED_MAX) + tangent * lateral_spread # Mix the top-level tunable short/far backward throws with broad side throws.
		var launch_speed := horizontal_velocity.length()                                           # Use actual launch speed as a proxy for how close this chunk will remain to the impact.
		var near_fraction := 1.0 - clampf(launch_speed / 1.05, 0.0, 1.0)                          # Slow chunks receive a stronger near-impact weighting.
		var large_chance := lerpf(WALL_DEBRIS_LARGE_FAR_CHANCE, WALL_DEBRIS_LARGE_NEAR_CHANCE, near_fraction) # Make two-pixel chunks increasingly likely near the impact point.
		var large_shapes := ["domino_h", "domino_v", "block", "l"]                           # Keep every non-dot candidate within a two-by-two footprint.
		var shape := String(large_shapes[randi() % large_shapes.size()]) if randf() < large_chance else "dot" # Choose a nearby chunk shape or a single-pixel distant splinter.
		var color_variation := Color.WHITE if barrel_hit else Color(randf_range(0.88, 1.08), randf_range(0.82, 1.02), randf_range(0.74, 0.96), 1.0) # Add a subtle warm brightness/color variation over the sampled wall texel.
		var initial_position := world_position + away_from_wall * 0.008                            # Start just off the struck wall so every visible splinter begins on its own side of the impact face.
		active_wall_debris.append({"id": next_combat_visual_id, "position": initial_position, "display_position": initial_position, "horizontal_velocity": horizontal_velocity, "height": impact_height, "display_height": impact_height, "visual_step_timer": debris_visual_frame_duration, "visual_frame_duration": debris_visual_frame_duration, "visual_frame": 0, "vertical_velocity": randf_range(-0.42, 1.55), "rotation": randf_range(-PI, PI), "angular_velocity": randf_range(-14.0, 14.0), "shape": shape, "color_sample_index": randi() % 4, "color_variation": color_variation, "ground_fade_seconds": debris_ground_fade_seconds, "remaining_bounces": debris_bounce_count, "timer": WALL_DEBRIS_LIFETIME, "wall_edge_key": wall_edge_key, "direction": direction, "sample_position": world_position, "barrel_hit": barrel_hit, "barrel_center": barrel_center, "barrel_impact_height": impact_height})
		next_combat_visual_id += 1                                                                # Give every square particle a stable cache identity in both player views.


# _impact_layer_for_current_view: Keeps a wall-hit flash above the rendered wall that received it.
func _impact_layer_for_current_view(wall_edge_key: String, projectile_direction: Vector2, fallback_layer: int) -> int:
	if wall_edge_key.is_empty() or active_player_index < 0 or active_player_index >= coordinate_renderers.size(): # Player impacts and unavailable views retain ordinary point-depth layering.
		return fallback_layer                                                                     # No wall-specific layer applies.
	var renderer := coordinate_renderers[active_player_index]                                  # Read this camera's already-built visible wall list.
	if not is_instance_valid(renderer) or not renderer.has_method("runtime_wall_impact_layer"):
		return fallback_layer                                                                     # Keep the normal layer until a renderer is available.
	return int(renderer.call("runtime_wall_impact_layer", wall_edge_key, projectile_direction)) # Let the renderer accept only the struck front face from this camera.


# _wall_impact_colors_for_current_view: Returns four sampled wood colors from the active wall texture around the real contact point.
func _wall_impact_colors_for_current_view(wall_edge_key: String, world_position: Vector2) -> Array[Color]:
	var fallback_colors: Array[Color] = [Color(0.45, 0.28, 0.12, 1.0), Color(0.38, 0.22, 0.09, 1.0), Color(0.52, 0.33, 0.15, 1.0), Color(0.31, 0.18, 0.07, 1.0)] # Keep a four-color wood fallback for unavailable renderers.
	if active_player_index < 0 or active_player_index >= coordinate_renderers.size():
		return fallback_colors                                                                     # Preserve a visible wood-colored fallback before a local renderer is available.
	var renderer := coordinate_renderers[active_player_index]
	if not is_instance_valid(renderer) or not renderer.has_method("runtime_wall_impact_colors"):
		return fallback_colors                                                                     # Keep debris visible if an alternate renderer does not expose its active source image.
	var sampled: Variant = renderer.call("runtime_wall_impact_colors", wall_edge_key, world_position)
	if sampled is Array and sampled.size() >= 4:
		var colors: Array[Color] = []
		for item in sampled:
			if item is Color:
				colors.append(item)                                                                    # Copy only actual Color values from the renderer's dynamic call result.
		if colors.size() >= 4:
			return colors                                                                           # Return the complete 2×2 wall-color patch for per-chunk selection.
	return fallback_colors                                                                      # Fall back only if the renderer supplied an incomplete or malformed patch.


# Sample the actual directional barrel image. Impact effects use the projected
# contact on its sprite; break fragments sample individual points across its surface.
func _barrel_surface_colors_for_current_view(effect: Dictionary) -> Array[Color]:
	var texture := _barrel_texture_for_current_camera()
	var texture_id := texture.get_instance_id()
	var image: Image = barrel_source_images.get(texture_id, null)
	if image == null:
		image = texture.get_image()
		if image == null or image.is_empty():
			return [Color.WHITE, Color.WHITE, Color.WHITE, Color.WHITE]
		barrel_source_images[texture_id] = image
		barrel_source_bounds[texture_id] = image.get_used_rect()
	var bounds: Rect2i = barrel_source_bounds[texture_id]
	if bounds.size.x <= 0 or bounds.size.y <= 0:
		return [Color.WHITE, Color.WHITE, Color.WHITE, Color.WHITE]
	var uv: Vector2
	if effect.has("barrel_sample_uv"):
		uv = effect["barrel_sample_uv"]
	else:
		var offset := Vector2(effect.get("sample_position", Vector2.ZERO)) - Vector2(effect.get("barrel_center", Vector2.ZERO))
		uv = Vector2(0.5 + offset.dot(_view_right_vector()) / (BARREL_PROJECTILE_RADIUS * 2.0), 1.0 - float(effect.get("barrel_impact_height", BARREL_PROJECTILE_HEIGHT * 0.5)) / BARREL_PROJECTILE_HEIGHT)
	var sample_x := bounds.position.x + roundi(clampf(uv.x, 0.0, 1.0) * float(bounds.size.x - 1))
	var sample_y := bounds.position.y + roundi(clampf(uv.y, 0.0, 1.0) * float(bounds.size.y - 1))
	var cache_key := "%d:%d:%d" % [texture_id, sample_x, sample_y]
	if barrel_surface_color_cache.has(cache_key):
		return barrel_surface_color_cache[cache_key]
	var colors: Array[Color] = []
	for offset in [Vector2i(0, 0), Vector2i(1, 0), Vector2i(0, 1), Vector2i(1, 1)]:
		var point := Vector2i(clampi(sample_x + offset.x, 0, image.get_width() - 1), clampi(sample_y + offset.y, 0, image.get_height() - 1))
		var color := image.get_pixelv(point)
		if color.a <= 0.01:
			# Sprite silhouettes have transparent corners; find the closest real texel.
			var nearest_distance := INF
			for y in range(bounds.position.y, bounds.end.y):
				for x in range(bounds.position.x, bounds.end.x):
					var candidate := image.get_pixel(x, y)
					var distance := Vector2(x - point.x, y - point.y).length_squared()
					if candidate.a > 0.01 and distance < nearest_distance:
						color = candidate
						nearest_distance = distance
		color.a = 1.0
		colors.append(color)
	barrel_surface_color_cache[cache_key] = colors
	return colors


# _projectile_owner_has_clear_path_to_player: Final gameplay authority for combat line-of-sight, using the same cell-edge wall ownership as movement.
func _projectile_owner_has_clear_path_to_player(owner_index: int, target_index: int, record_debug := true) -> bool:
	if owner_index < 0 or owner_index >= player_states.size() or target_index < 0 or target_index >= player_states.size(): # Reject malformed combat references defensively.
		if record_debug: _set_projectile_hit_debug("P%s -> P%s  INVALID ACTOR INDEX  BLOCKED" % [owner_index + 1, target_index + 1]) # Preserve the actual final-gate reason for F3 inspection.
		return false                                                                               # Invalid combat actors can never receive damage.
	var owner_cell: Vector2i = player_states[owner_index].get("grid_position", Vector2i(-1, -1)) # Use the canonical maze cell, not camera-local art offsets that rotate with each player's view.
	var target_cell: Vector2i = player_states[target_index].get("grid_position", Vector2i(-1, -1)) # Use the target's matching canonical cell ownership.
	if not _is_open_cell(owner_cell) or not _is_open_cell(target_cell):                         # Treat invalid cell state as blocked rather than permitting a speculative hit.
		if record_debug: _set_projectile_hit_debug("P%s %s -> P%s %s  INVALID CELL  BLOCKED" % [owner_index + 1, owner_cell, target_index + 1, target_cell]) # Expose stale player-state cells directly.
		return false                                                                               # Keep combat contained by the maze footprint.
	var owner_world := _player_state_world_position(player_states[owner_index])                # Revalidate along the same real in-cell body path used when the projectile initially found this target.
	var target_world := _player_state_world_position(player_states[target_index])              # Do not replace a visible corner-to-corner shot with a different cell-centre ray.
	var path := target_world - owner_world                                                      # Build the top-down segment joining the two actual collision bodies.
	var path_distance := path.length()                                                          # Preserve its real world length for the cell-edge trace.
	if path_distance <= PROJECTILE_PLAYER_RADIUS:                                               # Bodies already overlapping cannot have a wall between their collision centers.
		if record_debug: _set_projectile_hit_debug("P%s %s -> P%s %s  OVERLAP  ALLOWED" % [owner_index + 1, owner_cell, target_index + 1, target_cell]) # Record the exceptional close-contact case.
		return true                                                                                # Keep close-quarter combat responsive.
	var target_contact_distance := maxf(path_distance - PROJECTILE_PLAYER_RADIUS, 0.0)          # Stop at the target's near collision surface so a wall beyond the visible body cannot reject the hit.
	var wall_distance := _nearest_projectile_wall_distance(owner_world, path / path_distance, target_contact_distance) # Reuse the identical finite wall-segment test already used by the projectile's body collision.
	if wall_distance <= target_contact_distance + PROJECTILE_WALL_EPSILON:                     # A crossed movement edge blocks the real body-to-body route.
		if record_debug: _set_projectile_hit_debug("P%s %s -> P%s %s  TRACE %.3f/%.3f  WALL  BLOCKED" % [owner_index + 1, owner_cell, target_index + 1, target_cell, wall_distance, path_distance]) # Show whether the topological trace itself found a wall.
		return false                                                                               # Reject the hit before any health mutation.
	if record_debug: _set_projectile_hit_debug("P%s %s -> P%s %s  ACTUAL TRACE %.3f/%.3f  CLEAR  ALLOWED" % [owner_index + 1, owner_cell, target_index + 1, target_cell, wall_distance, path_distance]) # Report the exact projectile/body segment rather than a wider unrelated wall-proximity approximation.
	return true                                                                                  # The projectile's exact finite-wall and topology checks already accepted this real body-to-body line.


# _set_projectile_hit_debug: Records final gameplay LOS evidence without putting debug text into live player HUDs.
func _set_projectile_hit_debug(message: String) -> void:
	last_projectile_hit_debug = message                                                         # Keep the latest result available after the shot or impact expires.
	if debug_combat_hit_label != null:                                                          # Update an already-open F3 panel immediately.
		debug_combat_hit_label.text = "LAST COMBAT LOS\n" + last_projectile_hit_debug           # Prefix the compact evidence consistently.
	print("[Combat LOS] " + message)                                                           # Mirror the same evidence to the Godot output panel for screenshot-free capture.


# _projectile_path_grazes_wall: Treats physical wall edges as slightly thick only when confirming a player hit.
func _projectile_path_grazes_wall(origin: Vector2, target: Vector2) -> bool:
	var path := target - origin                                                                 # Measure the owner-to-target center line once.
	var path_distance := path.length()                                                          # Keep sampling in world units rather than screen pixels.
	if path_distance <= PROJECTILE_PLAYER_RADIUS:                                               # Overlapping bodies have no intervening hit-confirmation path.
		return false                                                                               # Preserve close-range contact behavior.
	var direction := path / path_distance                                                       # Normalize the sampled line.
	var tested_distance := maxf(path_distance - PROJECTILE_PLAYER_RADIUS, 0.0)                # Stop at the target's near body contact so a wall behind a visible target does not block the shot.
	var sample_count := maxi(1, ceili(tested_distance / 0.025))                                # Sample more densely than the smallest intended diagonal corner clearance.
	var guard_radius_squared := PROJECTILE_WALL_GUARD_RADIUS * PROJECTILE_WALL_GUARD_RADIUS   # Avoid square roots inside the wall/sample loop.
	for sample_index in range(sample_count + 1):                                               # Visit the complete path up to the target's near body surface.
		var sample_distance := tested_distance * float(sample_index) / float(sample_count)       # Place this sample evenly in world space.
		var point := origin + direction * sample_distance                                         # Convert the sample back into a maze coordinate.
		for edge in _all_physical_wall_edges():                                                   # Test every authoritative movement wall segment.
			if _point_to_segment_distance_squared(point, Vector2(edge["a"]), Vector2(edge["b"])) <= guard_radius_squared: # Any near-corner wall footprint blocks an otherwise invisible hit.
				return true                                                                            # Report the first thick-wall contact.
	return false                                                                                # The complete player-hit route had real clearance from every wall.


# _point_to_segment_distance_squared: Returns squared distance from one world point to a finite thin-wall segment.
func _point_to_segment_distance_squared(point: Vector2, a: Vector2, b: Vector2) -> float:
	var segment := b - a                                                                        # Measure the finite wall direction.
	var segment_length_squared := segment.length_squared()                                     # Avoid a division by zero on malformed map data.
	if segment_length_squared <= 0.000001:                                                     # Treat a degenerate wall as one point.
		return point.distance_squared_to(a)                                                       # Return direct point distance.
	var blend := clampf((point - a).dot(segment) / segment_length_squared, 0.0, 1.0)          # Find the closest finite segment point.
	return point.distance_squared_to(a + segment * blend)                                      # Return squared distance for guard-radius comparison.


# _camera_blood_blob_texture: Builds a small irregular opaque mask for a close camera-blood droplet, never larger than the requested nine-pixel square.
func _camera_blood_blob_texture(variant: int) -> ImageTexture:
	var normalized_variant := posmod(variant, CAMERA_BLOOD_SHAPE_VARIANTS)                     # Keep all random callers inside the cached set of close-screen blob silhouettes.
	var cached: ImageTexture = camera_blood_blob_textures.get(normalized_variant, null)
	if cached != null:
		return cached                                                                             # Reuse the generated low-resolution decal mask without allocating during damage.
	var rng := RandomNumberGenerator.new()                                                     # Seed each shape deterministically so its random blob form is stable on every view refresh.
	rng.seed = 12889 + normalized_variant * 3571                                               # Separate each reusable close-screen decal into a distinct irregular silhouette.
	var image := Image.create(CAMERA_BLOOD_MAX_SIZE, CAMERA_BLOOD_MAX_SIZE, false, Image.FORMAT_RGBA8) # Bound every source mask to the explicit nine-by-nine-pixel maximum.
	image.fill(Color(1.0, 1.0, 1.0, 0.0))                                                       # Leave all pixels outside the blood blob completely transparent.
	var blobs: Array[Dictionary] = []                                                           # Combine a few tiny overlapping clots into one irregular, non-geometric blood mark.
	for blob_index in range(rng.randi_range(1, 3)):
		blobs.append({"center": Vector2(rng.randf_range(1.2, 7.8), rng.randf_range(1.2, 7.8)), "radius": rng.randf_range(0.65, 2.75)}) # Keep every random lobe safely inside the nine-pixel source card.
	for y in range(CAMERA_BLOOD_MAX_SIZE):
		for x in range(CAMERA_BLOOD_MAX_SIZE):
			var point := Vector2(float(x) + 0.5, float(y) + 0.5)                                   # Test each authored source pixel independently for a crisp blob outline.
			var density := 0.0                                                                     # Merge the small clots into a varied single close-screen splatter.
			for blob in blobs:
				density = maxf(density, clampf(1.0 - point.distance_to(Vector2(blob["center"])) / float(blob["radius"]), 0.0, 1.0)) # Retain only hard nearest-neighbor source pixels inside the random blob form.
			if density > 0.38:
				image.set_pixel(x, y, Color.WHITE)                                                    # Tint the opaque shape red at render time while retaining a transparent background.
	var texture := ImageTexture.create_from_image(image)                                       # Upload the complete small blob mask once for all player views.
	camera_blood_blob_textures[normalized_variant] = texture                                   # Cache this stable mask for future damage events.
	return texture                                                                              # Return the one-to-nine-pixel irregular blood shape.


# _add_camera_blood_for_damage: Builds close red GUI splatters on only the injured player's view, favoring the lower screen.
func _add_camera_blood_for_damage(player_index: int) -> void:
	if player_index < 0 or player_index >= combat_camera_blood_layers.size() or player_index >= combat_camera_blood_droplets.size():
		return                                                                                    # Avoid UI work before the per-player HUD has been created.
	var layer := combat_camera_blood_layers[player_index]                                      # Keep the damage overlay local to this player's camera window.
	if not is_instance_valid(layer):
		return                                                                                    # Safely ignore an editor-reloaded or released HUD layer.
	var droplets: Array = combat_camera_blood_droplets[player_index]                           # Preserve existing injuries so additional hits visibly build up the overlay.
	for drop_index in range(CAMERA_BLOOD_DROPS_PER_HEALTH):
		var droplet := Sprite2D.new()                                                             # Use a native Sprite2D inside the HUD canvas for a literal close-screen pixel blob.
		droplet.texture = _camera_blood_blob_texture(randi() % CAMERA_BLOOD_SHAPE_VARIANTS)      # Pick an irregular opaque mark rather than a circle or repeated decal.
		droplet.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST                                # Preserve its hand-pixel silhouette at the enlarged player-view scale.
		droplet.position = Vector2(randf_range(4.0, VIEWPORT_SIZE.x - 4.0), randf_range(VIEWPORT_SIZE.y * 0.56, VIEWPORT_SIZE.y - 5.0)).round() # Bias close blood toward the lower camera while retaining a broad natural spread.
		droplet.self_modulate = Color(0.66, 0.012, 0.012, randf_range(0.58, 0.92))               # Keep every close drop visibly red, with modest opacity variety from fresh to thin blood.
		layer.add_child(droplet)                                                                   # Draw above the player's world but beneath compact HUD information.
		droplets.append(droplet)                                                                   # Retain the newest decal so a recovered heart can remove the exact matching amount.
	combat_camera_blood_droplets[player_index] = droplets                                      # Save the expanded per-player damage overlay.
	_add_player_blood_decals(player_index)                                                      # Mirror this same health-loss event onto the injured character's visible body in every world view.


# _add_player_blood_decals: Adds individual source-pixel blood marks in the injured character's sprite space for every player view that can see them.
func _add_player_blood_decals(player_index: int) -> void:
	if player_index < 0 or player_index >= combat_player_blood_decals.size():
		return                                                                                    # Avoid body-decal state before the player HUD/combat presentation has been initialized.
	var decals: Array = combat_player_blood_decals[player_index]                               # Preserve earlier wounds so the sprite presentation accumulates with the camera blood.
	for decal_index in range(PLAYER_BLOOD_PIXELS_PER_HEALTH):
		decals.append({"pattern_slot": randi() % PLAYER_BLOOD_PATTERN_PIXELS.size(), "alpha": randf_range(0.72, 1.0)}) # Retain only a pattern slot so the same physical injury adopts the appropriate cardinal-layout position when the character turns.
	combat_player_blood_decals[player_index] = decals                                          # Save the matching set of player-body wounds.


# _player_blood_offset_for_cardinal_facing: Rotates one deterministic source-pixel wound pattern between four cardinal character directions.
func _player_blood_offset_for_cardinal_facing(decal: Dictionary, state: Dictionary) -> Vector2:
	var pattern_slot := posmod(int(decal.get("pattern_slot", 0)), PLAYER_BLOOD_PATTERN_PIXELS.size()) # Resolve one persistent injury into its matching base-layout pixel.
	var base_offset: Vector2 = PLAYER_BLOOD_PATTERN_PIXELS[pattern_slot]                       # Use the North-oriented source-pixel pattern as the canonical layout.
	var facing_direction := String(state.get("world_aim_dir", _direction_string_for_facing(int(state.get("facing", 0))))) # Read the shared facing that changes as the player turns around the maze.
	if facing_direction == DIR_E or facing_direction == DIR_NE or facing_direction == DIR_SE:
		return Vector2(-base_offset.y, base_offset.x)                                             # Rotate the pattern clockwise for East-facing character art.
	if facing_direction == DIR_S or facing_direction == DIR_SE or facing_direction == DIR_SW:
		return -base_offset                                                                       # Rotate the pattern 180 degrees for South-facing character art.
	if facing_direction == DIR_W or facing_direction == DIR_NW or facing_direction == DIR_SW:
		return Vector2(base_offset.y, -base_offset.x)                                             # Rotate the pattern counter-clockwise for West-facing character art.
	return base_offset                                                                          # Preserve the canonical pattern for North-facing character art.


# _clear_camera_blood_for_heart: Removes exactly one damage event's worth of close-screen blood when a player recovers one health point.
func _clear_camera_blood_for_heart(player_index: int) -> void:
	if player_index < 0 or player_index >= combat_camera_blood_droplets.size():
		return                                                                                    # Heart collection can occur only after HUD creation, but retain a safe setup guard.
	var droplets: Array = combat_camera_blood_droplets[player_index]                           # Read this player's accumulated damage marks only; other players retain their own injuries.
	for drop_index in range(CAMERA_BLOOD_DROPS_PER_HEALTH):
		if droplets.is_empty():
			break                                                                                   # A healthy player simply has no close-screen blood left to clean away.
		var droplet: Sprite2D = droplets.pop_back()                                               # Remove the most recently added injury mark so healing visibly reverses recent damage buildup.
		if is_instance_valid(droplet):
			droplet.queue_free()                                                                     # Release the transient UI node; no world asset or persistent data is removed.
	combat_camera_blood_droplets[player_index] = droplets                                      # Save the reduced overlay after this one-heart recovery.
	_clear_player_blood_for_heart(player_index)                                                 # Remove the matching one-health batch from the character's visible wound decals.


# _clear_player_blood_for_heart: Removes one damage event's worth of world-body blood marks whenever a heart restores one health.
func _clear_player_blood_for_heart(player_index: int) -> void:
	if player_index < 0 or player_index >= combat_player_blood_decals.size():
		return                                                                                    # Retain a safe initialization guard for rare early setup calls.
	var decals: Array = combat_player_blood_decals[player_index]                               # Read only the healed player's stored body marks.
	for decal_index in range(PLAYER_BLOOD_PIXELS_PER_HEALTH):
		if decals.is_empty():
			break                                                                                   # A fully cleaned character simply has no marks left to remove.
		decals.pop_back()                                                                         # Remove the newest injury mark, matching the close-screen overlay's recovery behavior.
	combat_player_blood_decals[player_index] = decals                                          # Save the reduced visible-wound stack.


# _clear_camera_blood_overlay: Removes only one player's close-screen injury marks, leaving their world-body decal state untouched until full respawn restoration.
func _clear_camera_blood_overlay(player_index: int) -> void:
	if player_index < 0 or player_index >= combat_camera_blood_droplets.size():
		return                                                                                    # Avoid UI work if a respawn occurs during initial scene setup or editor reload.
	var droplets: Array = combat_camera_blood_droplets[player_index]                           # Read only this respawning player's camera overlay.
	for droplet in droplets:
		if is_instance_valid(droplet):
			droplet.queue_free()                                                                     # Remove the temporary visual node; no gameplay/world data is affected.
	combat_camera_blood_droplets[player_index] = []                                            # Leave the returning player with a completely clean camera.


# _clear_all_camera_blood: Removes every close-screen injury mark and body decal when that player's respawn fully restores their health state.
func _clear_all_camera_blood(player_index: int) -> void:
	_clear_camera_blood_overlay(player_index)                                                  # The later full reset reuses the countdown's GUI-only cleanup.
	if player_index < combat_player_blood_decals.size():
		combat_player_blood_decals[player_index] = []                                            # Clear the matching character decal descriptions when respawn restores their body and health.


# _clear_killing_shot_blood: Removes the persistent wall and floor marks created by one defeated player as their body begins its actual respawn.
func _clear_killing_shot_blood(player_index: int) -> void:
	var remaining_blood: Array[Dictionary] = []                                                # Rebuild the shared blood list without only this victim's retained killing-shot marks.
	for blood in active_blood_splatters:
		var is_this_victims_persistent_mark := bool(blood.get("persistent_killing_shot", false)) and int(blood.get("victim_player_index", -1)) == player_index and bool(blood.get("stuck", false)) # Preserve airborne blood and every other player's surface marks.
		if not is_this_victims_persistent_mark:
			remaining_blood.append(blood)
	active_blood_splatters = remaining_blood


# _apply_projectile_hit: Damages one player, chooses authored hit side art, and begins a readable staged respawn at zero health.
func _apply_projectile_hit(player_index: int, shot_direction: Vector2, owner_index := -1) -> bool:
	if owner_index >= 0 and not _projectile_owner_has_clear_path_to_player(owner_index, player_index): # Make wall blocking decisive at the final damage boundary.
		return false                                                                              # Do not permit health, score, death, or body-blood updates through a movement-blocking edge.
	var state := player_states[player_index]                                                    # Read the target's current state.
	if bool(state.get("is_dying", false)):                                                     # Ignore stray simultaneous bullets once this player is already down.
		return false                                                                              # Keep one death sequence and one countdown per defeat.
	var target_forward := _view_forward_vector_for_state(state).normalized()                   # Use target facing to choose front/side impact art.
	var target_right := Vector2(-target_forward.y, target_forward.x).normalized()              # Build target-local right.
	var incoming := -shot_direction                                                             # The impact direction points from bullet toward target.
	var front_dot := incoming.dot(target_forward)                                               # Positive means the shot arrived from the target's front.
	var side_dot := incoming.dot(target_right)                                                  # Sign chooses left versus right side.
	state["hit_reaction"] = "front" if front_dot > absf(side_dot) else ("right" if side_dot > 0.0 else "left") # Pick the requested one-frame reaction pose.
	state["hit_timer"] = HIT_REACTION_DURATION                                                 # Hold that pose long enough to read.
	state["health"] = maxi(int(state.get("health", PLAYER_MAX_HEALTH)) - 1, 0)                # Remove one hatch.
	player_states[player_index] = state                                                        # Save the immediate hit result.
	_add_camera_blood_for_damage(player_index)                                                  # Add one health-loss worth of lower-screen close blood to only the injured player's camera.
	if int(state["health"]) <= 0:                                                             # Begin an explicit fall, three-second count, and reverse-animation respawn.
		state["deaths"] = int(state.get("deaths", 0)) + 1
		player_states[player_index] = state
		if owner_index >= 0 and owner_index < player_states.size() and PLAYER_TEAMS[owner_index] != PLAYER_TEAMS[player_index]:
			var owner := player_states[owner_index]
			owner["kills"] = int(owner.get("kills", 0)) + 1
			player_states[owner_index] = owner
			_maybe_drop_heart_for_kill(player_index)                                                # A kill can leave a rare one-health recovery item at the defeat location.
		_begin_combat_death(player_index)                                                          # Choose a safe corner now while preserving the fallen body at its old location.
	return true                                                                                 # Let the caller render blood only when this exact call changed the target's health.


# _begin_combat_death: Stores a safe respawn destination while leaving the defeated body visible at its old location.
func _begin_combat_death(player_index: int) -> void:
	_drop_coins_for_defeat(player_index)                                                        # Transfer a small random share of this player's score into collectable world coins.
	_drop_machine_gun_for_defeat(player_index)                                                  # Return an equipped machine gun to this exact defeat point with its remaining rounds.
	var state := player_states[player_index]                                                    # Preserve this player's visible position until the countdown completes.
	var respawn := _combat_respawn_destination(player_index)                                   # Select a far corner from the other living player.
	state["is_dying"] = true                                                                   # Freeze input, shooting, and further damage immediately.
	state["death_phase"] = "fall"                                                            # Start the authored Death frames from first to last.
	state["death_timer"] = 0.0                                                                # Begin the fall animation at frame zero.
	state["death_respawn_cell"] = respawn["cell"]                                            # Remember the future map cell without moving there yet.
	state["death_respawn_facing"] = respawn["facing"]                                       # Remember its inward-facing camera direction.
	state["character_is_moving"] = false                                                      # Stop normal locomotion before the death pose takes over.
	state["fire_cooldown"] = 0.0                                                              # Ensure no held trigger survives into the respawn moment.
	state["hit_timer"] = 0.0                                                                  # Let the explicit Death frames replace the one-frame hit reaction.
	player_states[player_index] = state                                                        # Save the staged sequence.


# _combat_respawn_destination: Finds a free map cell with the greatest path distance from living enemies.
func _combat_respawn_destination(player_index: int) -> Dictionary:
	var best_cells: Array[Vector2i] = []
	var best_safety := -1
	for y in range(MAP_HEIGHT):
		for x in range(MAP_WIDTH):
			var candidate := Vector2i(x, y)
			var occupied := false
			var nearest_enemy_distance := MAP_WIDTH * MAP_HEIGHT + 1
			var has_living_enemy := false
			for other_index in range(player_states.size()):
				if other_index == player_index or other_index >= player_joined.size() or not player_joined[other_index]:
					continue
				var other_state := player_states[other_index]
				if bool(other_state.get("is_dying", false)):
					continue
				var other_cell: Vector2i = other_state.get("grid_position", Vector2i(-1, -1))
				if candidate == other_cell:
					occupied = true
					break
				if PLAYER_TEAMS[other_index] != PLAYER_TEAMS[player_index]:
					has_living_enemy = true
					nearest_enemy_distance = mini(nearest_enemy_distance, _maze_cell_path_distance(candidate, other_cell))
			if occupied:
				continue
			var safety := nearest_enemy_distance if has_living_enemy else 0
			if safety > best_safety:
				best_safety = safety
				best_cells = [candidate]
			elif safety == best_safety:
				best_cells.append(candidate)
	var chosen := best_cells[randi() % best_cells.size()] if not best_cells.is_empty() else Vector2i(0, MAP_HEIGHT - 1)
	var respawn_facing := 0 if chosen.y == MAP_HEIGHT - 1 else 2
	return {"cell": chosen, "facing": respawn_facing}


func _maze_cell_path_distance(from_cell: Vector2i, target_cell: Vector2i) -> int:
	if from_cell == target_cell:
		return 0
	var frontier: Array[Vector2i] = [from_cell]
	var distances: Dictionary = {from_cell: 0}
	var directions: Array[Vector2i] = [Vector2i(0, -1), Vector2i(1, 0), Vector2i(0, 1), Vector2i(-1, 0)]
	while not frontier.is_empty():
		var cell: Vector2i = frontier.pop_front()
		var distance: int = distances[cell]
		for direction: Vector2i in directions:
			var next_cell: Vector2i = cell + direction
			if not _is_open_cell(next_cell) or _has_wall_edge(cell, direction) or distances.has(next_cell):
				continue
			if next_cell == target_cell:
				return distance + 1
			distances[next_cell] = distance + 1
			frontier.append(next_cell)
	return MAP_WIDTH * MAP_HEIGHT + 1


# _advance_combat_death_state: Runs Death forward, holds the 3/2/1 countdown, then plays the same frames backwards at the new spawn.
func _advance_combat_death_state(state: Dictionary, delta: float) -> Dictionary:
	var phase := String(state.get("death_phase", "fall"))                                    # Read the current staged respawn phase.
	var timer := float(state.get("death_timer", 0.0)) + delta                                 # Advance its elapsed time exactly once per frame.
	if phase == "fall" and timer >= DEATH_FALL_SECONDS:                                       # Let the complete death animation finish before counting down.
		phase = "countdown"                                                                      # Hold the final Death frame at the old location.
		timer = 0.0                                                                                # Start the three-second count exactly at three.
		_clear_camera_blood_overlay(int(state.get("player_index", 0)))                           # The blackout countdown starts with a clean camera, while world/body blood remains visible through the death hold.
	elif phase == "countdown" and timer >= DEATH_COUNTDOWN_SECONDS:                          # After 3, 2, 1, relocate the still-fallen sprite.
		phase = "respawn"                                                                        # Begin playing Death backwards at the chosen safe corner.
		timer = 0.0                                                                                # Start the reverse animation on its fully fallen pose.
		_clear_killing_shot_blood(int(state.get("player_index", 0)))                             # Remove the fatal wall and floor spray as this character actually leaves the old death location.
		var fresh_respawn := _combat_respawn_destination(int(state.get("player_index", 0)))     # Re-evaluate just before re-entry so enemies cannot camp the cell chosen at death time.
		state["death_respawn_cell"] = fresh_respawn["cell"]
		state["death_respawn_facing"] = fresh_respawn["facing"]
		state["grid_position"] = state.get("death_respawn_cell", state.get("grid_position", Vector2i.ZERO)) # Move only after the countdown is complete.
		state["local_floor_position"] = HOME_LOCAL_FLOOR_POSITION                               # Restore the normal in-cell resting point.
		state["facing"] = int(state.get("death_respawn_facing", 0))                            # Restore the intended inward-facing camera.
		state["turn_45_direction"] = 0                                                          # Clear any old turn interpolation data.
		state["turn_step"] = 0                                                                   # Clear any old turn interpolation data.
		state["world_position"] = _world_position_from_state_fields(state["grid_position"], state["local_floor_position"], state) # Teleport the actual capsule with the respawning actor, rather than leaving old collision at the corpse.
		state["forward_step"] = 0                                                                # Clear any old forward interpolation data.
		state["strafe_step"] = 0                                                                 # Clear any old strafe interpolation data.
		state["is_transitioning"] = false                                                        # Do not carry a transition from the death location to the respawn.
		state["is_turn_passthrough"] = false                                                     # Do not carry a turn frame into the respawn.
		state["active_sequence"] = []                                                            # Clear captured sequence playback.
		state["active_sequence_name"] = "idle"                                                  # Return to an ordinary stable camera state.
		state["phase_index"] = 0                                                                 # Reset the captured-frame index.
		state["phase_timer"] = 0.0                                                               # Reset the captured-frame timer.
		state["pending_grid_delta"] = Vector2i.ZERO                                              # Clear pending cell movement from the old location.
		state["last_blocked_direction"] = ""                                                    # Clear stale blocked-edge debug text.
		state["world_run_dir"] = _direction_string_for_facing(int(state["facing"]))            # Face the restored actor consistently in other players' views.
		state["world_aim_dir"] = _direction_string_for_facing(int(state["facing"]))            # Face the restored actor consistently in other players' views.
	elif phase == "respawn" and timer >= DEATH_RESPAWN_SECONDS:                               # Finish the reverse Death animation.
		state["is_dying"] = false                                                                # Return player control and vulnerability only after the body is visibly back.
		state["death_phase"] = ""                                                               # Clear the staged-respawn marker.
		state["death_timer"] = 0.0                                                               # Reset timer for the next defeat.
		state["health"] = PLAYER_STARTING_HEALTH                                                 # Return with the same three-heart baseline as the start of a round.
		_clear_all_camera_blood(int(state.get("player_index", 0)))                               # A completed respawn returns the player to a clean, healthy camera view.
		state["last_animation"] = &""                                                          # Force the normal idle animation to restart cleanly next frame.
		return state                                                                               # Do not overwrite the cleared phase below.
	state["death_phase"] = phase                                                              # Save the current or newly entered phase.
	state["death_timer"] = timer                                                              # Save elapsed time for rendering and HUD countdown text.
	return state                                                                                # Return the updated serializable combat state.


# _combat_sprite: Returns one cached nearest-neighbor Sprite2D inside the bound player's combat layer.
func _combat_sprite(key: String) -> Sprite2D:
	var view := player_views[active_player_index]                                              # Read the currently rendered view bundle.
	var nodes: Dictionary = view.get("combat_nodes", {})                                      # Read its retained visual cache.
	var node: Sprite2D = nodes.get(key, null)                                                  # Reuse a previous effect node whenever possible.
	if node == null or not is_instance_valid(node):                                            # Create the node only the first time this key appears.
		node = Sprite2D.new()                                                                      # Build a basic pixel sprite.
		node.centered = true                                                                       # Register impacts and shots at their collision point.
		node.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST                                   # Preserve authored pixels.
		var layer: Node2D = view.get("combat_layer", null)                                       # Find this camera's clipped effects layer.
		if layer != null:
			layer.add_child(node)                                                                    # Attach it to the player's viewport.
		nodes[key] = node                                                                          # Cache it by stable shared ID.
		view["combat_nodes"] = nodes                                                             # Store cache changes.
		player_views[active_player_index] = view                                                  # Save the expanded bundle.
	return node                                                                                 # Return the cached visual node.


# _render_projectile_tracer_pixel: Draws one already-projected square in the compact live tracer without creating a separate world-space particle.
func _render_projectile_tracer_pixel(key: String, screen_position: Vector2, color: Color, z_layer: int, pixel_size: float, used: Dictionary) -> void:
	var sprite := _combat_sprite(key)                                                          # Reuse the view-local cached sprite for this world-space particle.
	sprite.texture = _projectile_pixel_texture()                                                # Draw every hot projectile element from the same one-texel source.
	sprite.material = null                                                                      # Preserve the exact fire color rather than applying a world-character palette shader.
	sprite.self_modulate = color                                                                # Color the yellow head, white hot core, or translucent grey cooling tail at this screen-space tracer position.
	sprite.position = screen_position.round()                                                   # Keep every attached tracer point locked to the logical screen-pixel grid.
	sprite.scale = Vector2.ONE * pixel_size                                                     # Allow a readable head while every tail point remains one crisp pixel.
	sprite.z_index = z_layer                                                                    # Keep the bright head readable over its cooler attached pixels.
	sprite.visible = true                                                                       # Reveal this visible world-space particle.
	used[key] = true                                                                            # Preserve it through stale-node cleanup this frame.


# _muzzle_anchor_debug_sprite: Returns one overlay pixel from the layer that deliberately draws above every cowboy PNG.
func _muzzle_anchor_debug_sprite(key: String) -> Sprite2D:
	var view := player_views[active_player_index]
	var nodes: Dictionary = view.get("muzzle_anchor_debug_nodes", {})
	var node: Sprite2D = nodes.get(key, null)
	if node == null or not is_instance_valid(node):
		node = Sprite2D.new()
		node.centered = true
		node.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		var layer: Node2D = view.get("muzzle_anchor_debug_layer", null)
		if layer != null:
			layer.add_child(node)
		nodes[key] = node
		view["muzzle_anchor_debug_nodes"] = nodes
		player_views[active_player_index] = view
	return node



# _render_muzzle_anchor_debug_cross: Draws a five-pixel camera-local marker without changing gameplay or VFX state.
func _render_muzzle_anchor_debug_cross(key: String, center: Vector2, color: Color, used: Dictionary) -> void:
	var offsets := [Vector2.ZERO, Vector2.LEFT, Vector2.RIGHT, Vector2.UP, Vector2.DOWN]       # Make the origin readable at native resolution without obscuring the cowboy or projectile.
	for pixel_index in range(offsets.size()):
		var sprite := _muzzle_anchor_debug_sprite("%s_%d" % [key, pixel_index])                  # Keep diagnostics out of the depth-sorted combat layer entirely.
		sprite.texture = _projectile_pixel_texture()
		sprite.material = null
		sprite.self_modulate = color
		sprite.position = (center + offsets[pixel_index]).round()
		sprite.scale = Vector2.ONE
		sprite.z_index = 0
		sprite.visible = true
		used["%s_%d" % [key, pixel_index]] = true



# _render_muzzle_anchor_debug_for_shot: Shows the two coordinate systems being compared for one live shot in the active camera.
func _render_muzzle_anchor_debug_for_shot(shot: Dictionary, used: Dictionary) -> void:
	if not show_muzzle_anchor_debug:
		return
	var shot_id := int(shot.get("id", -1))                                                     # Keep every shot marker cache independent while it is alive.
	var shared_muzzle_world: Vector2 = shot.get("authored_muzzle_position", shot.get("spawn_position", Vector2.ZERO)) # Read the canonical world point produced from the firing PNG anchor.
	var muzzle_height := float(shot.get("muzzle_height", shot.get("height", 0.72)))          # Lift that shared point by the normalized body height used for the shot.
	var world_projection := _opponent_projection_from_current_camera(shared_muzzle_world, true, true) # Deliberately use the existing world-effect path; cyan is where bullet/smoke currently believe the muzzle is.
	if bool(world_projection.get("visible", false)):
		var projected_height := float(world_projection.get("continuous_actor_height", world_projection.get("actor_height", 0.0)))
		var cyan_center := Vector2(float(world_projection.get("screen_x", 0.0)), float(world_projection.get("feet_y", 0.0)) - projected_height * muzzle_height)
		_render_muzzle_anchor_debug_cross("muzzle_world_%d" % shot_id, cyan_center, Color(0.0, 0.95, 1.0, 1.0), used) # Cyan means canonical shared-world muzzle after the current effect projection.
	var owner := int(shot.get("owner", -1))                                                    # Locate this camera's currently rendered version of the firing cowboy.
	var owner_sprite := _character_sprite_for_current_view(owner)
	if owner_sprite == null or not is_instance_valid(owner_sprite) or not owner_sprite.visible or owner_sprite.sprite_frames == null:
		return                                                                                    # Do not invent a magenta point when this camera has no rendered owner PNG.
	var muzzle_hand := StringName(shot.get("muzzle_hand", &"right"))
	if not _character_has_muzzle_anchor(owner_sprite, muzzle_hand):
		return
	var magenta_center := _screen_muzzle_anchor_offset(owner, muzzle_hand, Vector2.ZERO)        # Reuse the same rendered-PNG conversion used by the existing visual muzzle path.
	_render_muzzle_anchor_debug_cross("muzzle_png_%d" % shot_id, magenta_center, Color(1.0, 0.10, 0.85, 1.0), used) # Magenta means the authored muzzle pixel on the visible cowboy PNG.



# _append_projectile_tracer_wu_point: Merges one Xiaolin Wu coverage sample into its pixel, retaining the strongest coverage if endpoint math revisits it.
func _append_projectile_tracer_wu_point(points_by_pixel: Dictionary, pixel: Vector2i, coverage: float, progress: float, head_pixel: Vector2i) -> void:
	if pixel == head_pixel or coverage <= 0.001:
		return                                                                                     # The yellow head is its own opaque pixel; invisible coverage needs no cached Sprite2D.
	var prior: Dictionary = points_by_pixel.get(pixel, {})                                      # Keep each coverage pixel unique even when a shallow endpoint produces overlapping samples.
	if prior.is_empty() or coverage > float(prior.get("coverage", 0.0)):
		points_by_pixel[pixel] = {"position": Vector2(pixel), "coverage": coverage, "progress": progress} # Store both edge coverage and distance along the tail for the final opacity calculation.


# _projectile_tracer_wu_points: Rasterizes the projected tail with Xiaolin Wu coverage pairs, excluding the separately rendered opaque head.
func _projectile_tracer_wu_points(head_screen_position: Vector2, tail_direction: Vector2, length_pixels: int) -> Array[Dictionary]:
	var points: Array[Dictionary] = []                                                          # Return coverage-bearing tail pixels; the yellow head remains a single crisp Sprite2D.
	if length_pixels <= 0 or tail_direction.length_squared() < 0.000001:
		return points                                                                               # Avoid inventing an arbitrary line when the projection degenerates at the camera axis.
	var endpoint := head_screen_position + tail_direction.normalized() * float(length_pixels)   # Keep the vector's true projected angle and authored depth-scaled length continuous.
	var tail_unit_direction := tail_direction.normalized()                                       # Preserve physical head-to-tail direction separately from Wu's internal left-to-right scan order.
	var x0 := head_screen_position.x
	var y0 := head_screen_position.y
	var x1 := endpoint.x
	var y1 := endpoint.y
	var steep := absf(y1 - y0) > absf(x1 - x0)                                                  # Step along whichever screen axis spans more pixels, as Xiaolin Wu's algorithm requires.
	if steep:
		var swap_x0 := x0
		x0 = y0
		y0 = swap_x0
		var swap_x1 := x1
		x1 = y1
		y1 = swap_x1
	if x0 > x1:
		var reverse_x0 := x0
		x0 = x1
		x1 = reverse_x0
		var reverse_y0 := y0
		y0 = y1
		y1 = reverse_y0
	var delta_x := x1 - x0
	if absf(delta_x) < 0.000001:
		return points                                                                               # The steep-axis swap should prevent this, but keep the rasterizer safe for a numerically degenerate projection.
	var gradient := (y1 - y0) / delta_x
	var head_pixel := Vector2i(roundi(head_screen_position.x), roundi(head_screen_position.y)) # Do not let the translucent coverage samples weaken or widen the solid yellow head.
	var points_by_pixel: Dictionary = {}
	var first_x := ceili(x0)
	var last_x := floori(x1)
	for x in range(first_x, last_x + 1):
		var y := y0 + gradient * (float(x) - x0)
		var lower_y := floori(y)
		var fractional_y := y - float(lower_y)
		var first_pixel := Vector2i(lower_y, x) if steep else Vector2i(x, lower_y)
		var second_pixel := Vector2i(lower_y + 1, x) if steep else Vector2i(x, lower_y + 1)
		var first_progress := clampf((Vector2(first_pixel) - head_screen_position).dot(tail_unit_direction) / float(length_pixels), 0.0, 1.0) # Measure fade from the physical yellow head, not the scan endpoint Wu may have reversed.
		var second_progress := clampf((Vector2(second_pixel) - head_screen_position).dot(tail_unit_direction) / float(length_pixels), 0.0, 1.0)
		_append_projectile_tracer_wu_point(points_by_pixel, first_pixel, 1.0 - fractional_y, first_progress, head_pixel) # Put the complementary coverage on the nearer scanline.
		_append_projectile_tracer_wu_point(points_by_pixel, second_pixel, fractional_y, second_progress, head_pixel) # Feather into the neighboring scanline without reversing the gradient.
	for point: Dictionary in points_by_pixel.values():
		points.append(point)
	return points


# _projectile_screen_position: Projects a bullet/trail point at a stable world height, independent of the deliberately stepped character LOD size.
func _projectile_screen_position(projection: Dictionary) -> Vector2:
	return _projectile_screen_position_continuous(projection).round()                          # Snap only the final displayed projectile point, never the direction-measurement inputs.


# _character_sprite_for_current_view: Finds the exact animated PNG currently visible for one world player in this camera.
func _character_sprite_for_current_view(owner: int) -> AnimatedSprite2D:
	if owner == active_player_index:
		return player_sprite
	if active_player_index < 0 or active_player_index >= player_views.size():
		return null
	var opponents: Dictionary = player_views[active_player_index].get("opponent_sprites", {})
	var opponent: Variant = opponents.get(owner, null)
	return opponent as AnimatedSprite2D


# _screen_muzzle_anchor_offset: Converts an authored PNG pixel directly into this view's displayed sprite space.
# The gameplay ray remains wall-safe in world space; this correction only owns the visual emission point.
func _screen_muzzle_anchor_offset(owner: int, muzzle_hand: StringName, baseline_screen_position: Vector2) -> Vector2:
	var character := _character_sprite_for_current_view(owner)
	if not _character_has_muzzle_anchor(character, muzzle_hand):
		return Vector2.ZERO
	var anchor: Variant = _muzzle_anchor_for_animation(character.animation, muzzle_hand)
	var texture := character.sprite_frames.get_frame_texture(character.animation, character.frame)
	if texture == null:
		return Vector2.ZERO
	var local_pixel := Vector2(anchor) + Vector2(0.5, 0.5) - texture.get_size() * 0.5
	var displayed_anchor := character.position + local_pixel * character.scale
	return displayed_anchor - baseline_screen_position


# _character_has_muzzle_anchor: Lets authored sprite data replace, rather than stack with, the old local-barrel correction.
func _character_has_muzzle_anchor(character: AnimatedSprite2D, muzzle_hand: StringName) -> bool:
	return character != null and character.sprite_frames != null and _muzzle_anchor_for_animation(character.animation, muzzle_hand) is Vector2i


# _world_muzzle_anchor: Converts one authored PNG pixel into the one shared world muzzle point used by collision and every camera.
func _world_muzzle_anchor(owner: int, body_position: Vector2, direction: Vector2, muzzle_hand: StringName) -> Dictionary:
	if owner < 0 or owner >= player_views.size():
		return {"position": body_position, "height": 0.72}
	var sprite: AnimatedSprite2D = player_views[owner].get("player_sprite", null)
	if not _character_has_muzzle_anchor(sprite, muzzle_hand):
		return {"position": body_position, "height": 0.72}
	var texture := sprite.sprite_frames.get_frame_texture(sprite.animation, sprite.frame)
	var anchor: Vector2i = _muzzle_anchor_for_animation(sprite.animation, muzzle_hand)
	if texture == null:
		return {"position": body_position, "height": 0.72}
	var lateral_fraction := (float(anchor.x) + 0.5 - texture.get_width() * 0.5) / maxf(float(texture.get_width()), 1.0)
	var lateral := Vector2(-direction.y, direction.x)
	var foot_y := _texture_foot_anchor_y(texture)
	var body_height := maxf(_standard_actor_body_height() if String(sprite.animation).begins_with("Crouch") else _texture_body_height_to_foot(texture), 1.0)
	var height := clampf((foot_y - float(anchor.y)) / body_height, 0.35, 1.10)
	return {"position": body_position + lateral * lateral_fraction * MUZZLE_WORLD_WIDTH, "height": height}


# _muzzle_anchor_for_animation: Normal moving clips use names such as RunN_AimW.
# Their weapon direction is the Aim suffix, so a matching idle anchor remains a
# useful authored fallback until that individual run clip gets its own anchor.
func _muzzle_anchor_for_animation(animation_name: StringName, muzzle_hand: StringName) -> Variant:
	var direct: Variant = MUZZLE_ANCHORS.get_anchor(animation_name, muzzle_hand)
	if direct is Vector2i:
		return direct
	var animation_text := String(animation_name)
	if animation_text.begins_with("CrouchIdle"):
		return MUZZLE_ANCHORS.get_anchor(StringName("CrouchWalk" + animation_text.trim_prefix("CrouchIdle")), muzzle_hand)
	if animation_text.begins_with("CrouchWalkRight"):
		return MUZZLE_ANCHORS.get_anchor(StringName("CrouchWalk" + animation_text.trim_prefix("CrouchWalkRight")), muzzle_hand)
	if animation_text.begins_with("CrouchWalkLeft"):
		return MUZZLE_ANCHORS.get_anchor(StringName("CrouchWalk" + animation_text.trim_prefix("CrouchWalkLeft")), muzzle_hand)
	var aim_marker := animation_text.rfind("_Aim")
	if aim_marker >= 0:
		var aim_direction := animation_text.substr(aim_marker + 4)
		return MUZZLE_ANCHORS.get_anchor(StringName("Idle" + aim_direction), muzzle_hand)
	return null


# _projectile_screen_position_continuous: Preserves subpixel projection data for stable live-vector direction calculations.
func _projectile_screen_position_continuous(projection: Dictionary, projectile_height: float = 0.72) -> Vector2:
	var continuous_height := float(projection.get("continuous_actor_height", projection.get("actor_height", 0.0))) # Prefer the renderer's non-quantized height; retain the legacy fallback only if an alternate renderer omits it.
	return Vector2(float(projection["screen_x"]), float(projection["feet_y"]) - continuous_height * projectile_height) # Keep the physical raised bullet height continuous until the caller deliberately snaps its final screen pixel.


# _projectile_pixel_texture: Creates the single neutral texel used as the exact-color source for all bullet and hot-trail particles.
func _projectile_pixel_texture() -> ImageTexture:
	if projectile_pixel_texture != null:
		return projectile_pixel_texture                                                           # Reuse the one runtime texture rather than allocating during combat rendering.
	var image := Image.create(1, 1, false, Image.FORMAT_RGBA8)                                # Build a true one-square-pixel source image for nearest-neighbor scaling.
	image.fill(Color.WHITE)                                                                     # Tint each individual Sprite2D through self_modulate at render time.
	projectile_pixel_texture = ImageTexture.create_from_image(image)                           # Upload it once for every split-screen view's particle cache.
	return projectile_pixel_texture                                                             # Return the initialized white texel.


# _muzzle_smoke_cloud_texture: Builds one low-resolution alpha-noise cloud card with a white opaque core and a broken transparent pixel edge.
func _muzzle_smoke_cloud_texture(variant: int) -> ImageTexture:
	var normalized_variant := posmod(variant, MUZZLE_SMOKE_CLOUD_VARIANTS)                     # Keep every caller safely inside the small reusable silhouette set.
	var cached: ImageTexture = muzzle_smoke_cloud_textures.get(normalized_variant, null)
	if cached != null:
		return cached                                                                             # Reuse the generated card rather than allocating texture data during every shot.
	var rng := RandomNumberGenerator.new()                                                     # Seed this card once so its noisy silhouette is stable across both player views.
	rng.seed = 6143 + normalized_variant * 7919                                                # Give each variant a deliberately different, deterministic cloud profile.
	var card_center := float(MUZZLE_SMOKE_CLOUD_SIZE) * 0.5                                    # Seed one off-center dominant mass so the card reads as one drifting puff, not a fixed bouquet of balls.
	var blobs: Array[Dictionary] = [{"center": Vector2(card_center + rng.randf_range(-2.8, 2.8), card_center + rng.randf_range(-2.8, 2.8)), "radius": rng.randf_range(8.8, 13.2)}]
	for blob_index in range(3):
		blobs.append({"center": Vector2(rng.randf_range(6.0, 26.0), rng.randf_range(6.0, 26.0)), "radius": rng.randf_range(4.0, 9.6)}) # Distort its outline with only a few nearby lobes, leaving one coherent turbulent puff per card.
	var image := Image.create(MUZZLE_SMOKE_CLOUD_SIZE, MUZZLE_SMOKE_CLOUD_SIZE, false, Image.FORMAT_RGBA8) # Keep the source intentionally low resolution so every edge resolves as pixels.
	image.fill(Color(1.0, 1.0, 1.0, 0.0))                                                       # Leave the card fully transparent outside its noisy powder silhouette.
	for y in range(MUZZLE_SMOKE_CLOUD_SIZE):
		for x in range(MUZZLE_SMOKE_CLOUD_SIZE):
			var point := Vector2(float(x) + 0.5, float(y) + 0.5)                                   # Sample at each source pixel center for a crisp, stable mask.
			var density := 0.0                                                                     # Accumulate overlapping cloud lobe influence into one opaque core.
			for blob in blobs:
				var center: Vector2 = blob["center"]
				var radius := float(blob["radius"])
				density = maxf(density, clampf(1.0 - point.distance_to(center) / radius, 0.0, 1.0)) # Preserve lumpy cloud edges while allowing lobe intersections to remain fully dense.
			var local_noise := rng.randf_range(-0.15, 0.11)                                        # Break up every puff's density independently, avoiding the regular opaque-center/transparent-edge look.
			var alpha := snappedf(clampf((density + local_noise - 0.16) / 0.72, 0.0, 1.0), 0.20)  # Use hard, irregular alpha bands with no directional pattern that could create diagonal streaks.
			if alpha > 0.0:
				image.set_pixel(x, y, Color(1.0, 1.0, 1.0, alpha))                                  # Leave color neutral so individual puffs can be white or pale grey at render time.
	var texture := ImageTexture.create_from_image(image)                                       # Upload the generated card only after its complete alpha mask is authored.
	muzzle_smoke_cloud_textures[normalized_variant] = texture                                  # Cache by variant so every later cloud is effectively free to reuse.
	return texture                                                                              # Return the nearest-filtered card for one smoke puff.


# _muzzle_smoke_card_debug_outline_texture: Builds a transparent 32-pixel card border and center cross for temporary particle-layout inspection.
func _muzzle_smoke_card_debug_outline_texture() -> ImageTexture:
	if muzzle_smoke_card_debug_texture != null:
		return muzzle_smoke_card_debug_texture                                                    # Reuse the one inspection overlay across every visible puff and camera.
	var image := Image.create(MUZZLE_SMOKE_CLOUD_SIZE, MUZZLE_SMOKE_CLOUD_SIZE, false, Image.FORMAT_RGBA8) # Match the exact source dimensions of every generated cloud card.
	image.fill(Color(1.0, 1.0, 1.0, 0.0))                                                       # Keep only the layout marks visible so the smoke cloud itself remains readable underneath.
	var midpoint := int(MUZZLE_SMOKE_CLOUD_SIZE / 2)                                            # Mark the actual sprite origin, not an approximate visual center.
	for coordinate in range(MUZZLE_SMOKE_CLOUD_SIZE):
		image.set_pixel(coordinate, 0, Color.WHITE)                                               # Draw the top card edge.
		image.set_pixel(coordinate, MUZZLE_SMOKE_CLOUD_SIZE - 1, Color.WHITE)                    # Draw the bottom card edge.
		image.set_pixel(0, coordinate, Color.WHITE)                                               # Draw the left card edge.
		image.set_pixel(MUZZLE_SMOKE_CLOUD_SIZE - 1, coordinate, Color.WHITE)                    # Draw the right card edge.
	for offset in range(-2, 3):
		image.set_pixel(midpoint + offset, midpoint, Color.WHITE)                                # Draw a short horizontal origin crossbar.
		image.set_pixel(midpoint, midpoint + offset, Color.WHITE)                                # Draw a short vertical origin crossbar.
	muzzle_smoke_card_debug_texture = ImageTexture.create_from_image(image)                    # Upload the temporary outline once at the same pixel resolution as the smoke.
	return muzzle_smoke_card_debug_texture                                                      # Return it for the separate overlaid debug Sprite2D.


# _wall_debris_shape_texture: Builds and caches tiny white masks for square, domino, block, and L-shaped splinters without adding image assets.
func _wall_debris_shape_texture(shape: String) -> ImageTexture:
	var cached: ImageTexture = wall_debris_shape_textures.get(shape, null)
	if cached != null:
		return cached                                                                             # Reuse the generated procedural mask for every matching chunk.
	var image := Image.create(4 if shape.begins_with("barrel_") else 2, 4 if shape.begins_with("barrel_") else 2, false, Image.FORMAT_RGBA8)                                 # No shape exceeds the requested two-by-two pixel footprint.
	image.fill(Color(1.0, 1.0, 1.0, 0.0))                                                       # Leave every unused texel transparent.
	var filled_pixels: Array[Vector2i] = [Vector2i(0, 0)]                                      # Keep the default shape as one square pixel.
	match shape:
		"barrel_plank": filled_pixels = [Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0), Vector2i(3, 0), Vector2i(1, 1), Vector2i(2, 1), Vector2i(3, 1)]
		"barrel_chip": filled_pixels = [Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0), Vector2i(0, 1), Vector2i(1, 1), Vector2i(1, 2)]
		"barrel_hoop": filled_pixels = [Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0), Vector2i(3, 0), Vector2i(3, 1)]
		"domino_h": filled_pixels = [Vector2i(0, 0), Vector2i(1, 0)]
		"domino_v": filled_pixels = [Vector2i(0, 0), Vector2i(0, 1)]
		"block": filled_pixels = [Vector2i(0, 0), Vector2i(1, 0), Vector2i(0, 1), Vector2i(1, 1)]
		"l": filled_pixels = [Vector2i(0, 0), Vector2i(0, 1), Vector2i(1, 1)]
	for pixel in filled_pixels:
		image.set_pixelv(pixel, Color.WHITE)                                                      # Use white source texels so the sampled wood color can tint every opaque pixel.
	var texture := ImageTexture.create_from_image(image)                                        # Upload the small procedural shape once.
	wall_debris_shape_textures[shape] = texture                                                  # Cache by semantic shape name for later impacts.
	return texture                                                                               # Return the hard-edged generated splinter mask.


# Find the actual darkest and lightest opaque texels of the active directional
# barrel art. The per-texture cache avoids scanning the PNG for every particle.
func _barrel_small_splinter_palette() -> Array[Color]:
	var source_texture := _barrel_texture_for_current_camera()
	var texture_id := source_texture.get_instance_id()
	if barrel_small_splinter_palettes.has(texture_id):
		return barrel_small_splinter_palettes[texture_id]
	var image: Image = barrel_source_images.get(texture_id, null)
	if image == null:
		image = source_texture.get_image()
		if image == null or image.is_empty():
			return [Color.TRANSPARENT, Color.TRANSPARENT]
		barrel_source_images[texture_id] = image
		barrel_source_bounds[texture_id] = image.get_used_rect()
	var darkest := Color.TRANSPARENT
	var lightest := Color.TRANSPARENT
	var min_luminance := INF
	var max_luminance := -INF
	# Prefer opaque pixels; only use translucent pixels for an entirely translucent image.
	for minimum_alpha in [0.99, 0.01]:
		for y in range(image.get_height()):
			for x in range(image.get_width()):
				var color := image.get_pixel(x, y)
				if color.a < minimum_alpha:
					continue
				var luminance := color.get_luminance()
				color.a = 1.0
				if luminance < min_luminance:
					min_luminance = luminance
					darkest = color
				if luminance > max_luminance:
					max_luminance = luminance
					lightest = color
		if max_luminance >= 0.0:
			break
	var palette: Array[Color] = [darkest, lightest]
	barrel_small_splinter_palettes[texture_id] = palette
	return palette


# Keep each tiny silhouette and its one-pixel backing in the barrel's own colors.
func _barrel_small_splinter_texture(shape: String) -> ImageTexture:
	var source_texture := _barrel_texture_for_current_camera()
	var cache_key := "%d:%s" % [source_texture.get_instance_id(), shape]
	var cached: ImageTexture = barrel_small_splinter_textures.get(cache_key, null)
	if cached != null:
		return cached
	var palette := _barrel_small_splinter_palette()
	var source := _wall_debris_shape_texture(shape).get_image()
	var image := Image.create(4, 4, false, Image.FORMAT_RGBA8)
	image.fill(Color.TRANSPARENT)
	for y in range(2):
		for x in range(2):
			if source.get_pixel(x, y).a > 0.5:
				image.set_pixel(x + 2, y + 2, palette[0])
	for y in range(2):
		for x in range(2):
			if source.get_pixel(x, y).a > 0.5:
				image.set_pixel(x + 1, y + 1, palette[1])
	var texture := ImageTexture.create_from_image(image)
	barrel_small_splinter_textures[cache_key] = texture
	return texture


# _runtime_world_sprite_texel_stride: Recreates the supplied eight-level run
# reference procedurally.  The measured authored reductions are 1.00, .90,
# .79, .64, .57, .50, .40, and .29.  Their inverse gives the source-pixel grid
# stride: nearby steps remain subtle while the final distant silhouette uses
# a noticeably coarser grid.  Depth, rather than sprite scale, drives this so
# a small coin in the current cell never gets mistaken for a far coin.
func _runtime_world_sprite_texel_stride(world_view_depth: float) -> float:
	const LOD_STRIDES := [1.0, 1.11, 1.27, 1.56, 1.75, 2.0, 2.5, 3.5]
	if world_view_depth <= 0.96:
		return LOD_STRIDES[0]
	var remote_depth := world_view_depth - 0.96
	var step_index: int
	if remote_depth < 2.0:
		step_index = 1 + int(floorf(remote_depth * 2.0))
	else:
		step_index = 5 + int(floorf((remote_depth - 2.0) * 3.0))
	return float(LOD_STRIDES[clampi(step_index, 0, LOD_STRIDES.size() - 1)])


# _apply_runtime_world_sprite_style: Gives a world-projected sprite its own GPU material, with no object distance darkening.
func _apply_runtime_world_sprite_style(sprite: Node2D, sprite_scale: float, team_index := 0, world_view_depth := 0.0, use_texel_lod := true, apply_green_costume_remap := false) -> void:
	if sprite == null:
		return
	var resolved_team_index: int = int(PLAYER_TEAMS[team_index]) if team_index >= 0 and team_index < PLAYER_TEAMS.size() else team_index # Normalize player indices to their team so normal and hit sprites always share one costume treatment.
	var expected_shader := WORLD_SPRITE_TEAM2_LOD_SHADER if resolved_team_index == 1 else WORLD_SPRITE_LOD_SHADER # Select the Team 2 green-costume shader without altering the underlying SpriteFrames.
	var material := sprite.material as ShaderMaterial                                          # Reuse this sprite's material without sharing per-view uniforms.
	if material == null or material.shader != expected_shader:
		material = ShaderMaterial.new()
		material.shader = expected_shader
		sprite.material = material
	sprite.self_modulate = Color.WHITE                                                        # Preserve every authored PNG color before the optional green-costume remap.
	material.set_shader_parameter("texel_stride", _runtime_world_sprite_texel_stride(world_view_depth) if use_texel_lod else 1.0) # Keep authored coin LOD textures exact while other world sprites retain shader sampling reduction.
	material.set_shader_parameter("apply_green_costume_remap", apply_green_costume_remap and resolved_team_index == 1) # Restrict the value-preserving green remap to Team 2 player fabric; gameplay pickups retain authored color.
	sprite.position = sprite.position.round()                                                   # Keep every world sprite registered on the 160x120 logical pixel grid.


# _environment_depth_light: Matches the stepped distance light used by runtime walls, floors, and ceilings.
func _environment_depth_light(world_view_depth: float) -> float:
	if world_view_depth < 1.35:
		return 1.0
	if world_view_depth < 2.5:
		return 0.78
	if world_view_depth < 3.8:
		return 0.56
	if world_view_depth < 4.8:
		return 0.36
	if world_view_depth < 5.2:
		return 0.22
	return 0.10


# _environment_depth_light_at_pixel: Matches the floor renderer's dithered light at a prop's floor contact point.
func _environment_depth_light_at_pixel(world_view_depth: float, floor_pixel: Vector2) -> float:
	const THRESHOLDS := [1.35, 2.5, 3.8, 4.8, 5.2]
	const NEAR_LIGHTS := [1.0, 0.78, 0.56, 0.36, 0.22]
	const FAR_LIGHTS := [0.78, 0.56, 0.36, 0.22, 0.10]
	const DITHER_STEPS := 4
	var depth_per_pixel := maxf(world_view_depth * world_view_depth / 64.0, 0.0001)             # Mirror the runtime plane's 0.5 camera height and 128 focal length.
	var near_weight := 1.0 - clampf(inverse_lerp(1.35, 5.2, world_view_depth), 0.0, 1.0)
	var half_band := depth_per_pixel * lerpf(1.0, 3.0, near_weight)                            # Preserve the floor's two-to-six-pixel dither transition width.
	var pixel_x := posmod(floori(floor_pixel.x), 2)
	var pixel_y := posmod(floori(floor_pixel.y), 2)
	var bayer_threshold := (float(2 * pixel_x + 3 * pixel_y - 4 * pixel_x * pixel_y) + 0.5) / 4.0
	for index in range(THRESHOLDS.size()):
		var threshold := float(THRESHOLDS[index])
		if world_view_depth < threshold - half_band:
			return float(NEAR_LIGHTS[index])
		if world_view_depth <= threshold + half_band:
			var coverage := clampf((world_view_depth - (threshold - half_band)) / (half_band * 2.0), 0.0, 1.0)
			var scaled_step := coverage * DITHER_STEPS
			var lower_step := clampi(floori(scaled_step), 0, DITHER_STEPS)
			var upper_step := mini(lower_step + 1, DITHER_STEPS)
			var selected_step := upper_step if scaled_step - float(lower_step) >= bayer_threshold else lower_step
			return lerpf(float(NEAR_LIGHTS[index]), float(FAR_LIGHTS[index]), float(selected_step) / DITHER_STEPS)
	return 0.10


# _apply_runtime_world_prop_style: Gives a static prop the same stable source grid and depth light as the environment beneath it.
func _apply_runtime_world_prop_style(sprite: Sprite2D, world_view_depth: float, floor_pixel: Vector2) -> void:
	var material := sprite.material as ShaderMaterial
	if material == null or material.shader != WORLD_PROP_LOD_SHADER:
		material = ShaderMaterial.new()
		material.shader = WORLD_PROP_LOD_SHADER
		sprite.material = material
	sprite.self_modulate = Color.WHITE
	material.set_shader_parameter("sprite_scale", sprite.scale.x)
	material.set_shader_parameter("grid_origin", sprite.position - sprite.texture.get_size() * sprite.scale * 0.5) # Anchor samples to whole playfield pixels, not fractional prop texels.
	material.set_shader_parameter("depth_light", _environment_depth_light_at_pixel(world_view_depth, floor_pixel)) # Read the same dither phase as the floor at the barrel's feet.
	sprite.position = sprite.position.round()


# _clear_runtime_world_sprite_style: Keeps the local player camera-relative body at its authored brightness and source pixel resolution.
func _clear_runtime_world_sprite_style(sprite: CanvasItem) -> void:
	if sprite == null:
		return
	var material := sprite.material as ShaderMaterial
	if material != null and (material.shader == WORLD_SPRITE_LOD_SHADER or material.shader == WORLD_SPRITE_TEAM2_LOD_SHADER):
		sprite.material = null


# _hide_unused_combat_sprites: Keeps cached sprite nodes but hides any that were not used this frame.
func _hide_unused_combat_sprites(used_keys: Dictionary) -> void:
	var view := player_views[active_player_index]                                              # Read the active camera view.
	var nodes: Dictionary = view.get("combat_nodes", {})                                      # Read cached effect sprites.
	for key in nodes.keys():                                                                    # Visit every cached key.
		var node: Sprite2D = nodes[key]                                                           # Read the sprite safely.
		if is_instance_valid(node) and not used_keys.has(key):                                   # Hide stale visual effects without allocating/queue-free churn.
			node.visible = false                                                                     # Keep it ready for a later projectile.


# _hide_unused_muzzle_anchor_debug_sprites: Keeps diagnostic cross pixels alive only while a retained marker uses them.
func _hide_unused_muzzle_anchor_debug_sprites(used_keys: Dictionary) -> void:
	var view := player_views[active_player_index]
	var nodes: Dictionary = view.get("muzzle_anchor_debug_nodes", {})
	for key in nodes.keys():
		var node: Sprite2D = nodes[key]
		if is_instance_valid(node) and not used_keys.has(key):
			node.visible = false



# _update_combat_view: Projects shots, impact flashes, and temporary hit sprites through the same camera model as opponents.
func _update_combat_view() -> void:
	var used: Dictionary = {}                                                                   # Track which cached sprites are active in this camera this frame.
	var muzzle_debug_used: Dictionary = {}                                                      # Track the temporary topmost cross pixels separately from depth-sorted combat VFX.
	var muzzle_debug_view := player_views[active_player_index]                                  # Keep the HUD diagnostic registered to this camera's actual on-window viewport rectangle.
	var muzzle_debug_layer: Node2D = muzzle_debug_view.get("muzzle_anchor_debug_layer", null)
	var view_node: Node2D = muzzle_debug_view.get("maze_viewport", null)
	if muzzle_debug_layer != null and view_node != null:
		muzzle_debug_layer.position = view_node.position                                          # Convert logical 160-by-120 cross coordinates into this view's native-window origin.
		muzzle_debug_layer.scale = view_node.scale                                                # Match the exact integer player-view enlargement so the cross stays on its intended source pixel.
	combat_vfx_render_profile = {"muzzle_smoke_us": 0, "trails_us": 0, "trail_smoke_us": 0, "projectile_hot_us": 0, "wall_dust_us": 0, "blood_us": 0, "debris_us": 0} # Reset this camera's small profiling payload before rendering its current effect passes.
	for barrel in world_barrels:                                                                # Draw every static prop through this view's live wall/floor projection.
		var barrel_position: Vector2 = barrel.get("position", Vector2.ZERO)
		_render_world_barrel("barrel_%d" % int(barrel.get("id", -1)), barrel_position, used)
	var coin_frame_index := _coin_animation_frame_index()                                      # Keep every coin on the same authored spin frame while allowing each depth to choose its own authored silhouette.
	for coin in world_coins:                                                                    # Draw every remaining shared coin through the same camera projection as players and bullets.
		var coin_position: Vector2 = coin.get("position", Vector2.ZERO)                         # Read the shared Vector2 directly instead of reconstructing it from a Variant.
		_render_world_pickup("coin_%d" % int(coin.get("id", -1)), null, coin_position, used, 0.16, 1, true, coin_frame_index, false, 0, float(coin.get("loot_height", 0.0)), "coin") # Use each coin's exact authored LOD frame instead of shader-derived pixel grouping.
	var heart_frame_index := _heart_animation_frame_index()                                    # Keep every heart on the same authored pulse frame while allowing each depth to choose its own silhouette.
	for heart in world_hearts:
		var heart_position: Vector2 = heart.get("position", Vector2.ZERO)
		_render_world_pickup("heart_%d" % int(heart.get("id", -1)), null, heart_position, used, 0.18, 1, false, 0, true, heart_frame_index, float(heart.get("loot_height", 0.0)), "heart") # Use each heart's exact authored LOD pulse frame only in the world pickup view.
	for gun in world_barrel_guns:
		_render_world_pickup("barrel_gun_%d" % int(gun["id"]), _gun_animation_texture(), Vector2(gun["position"]), used, 0.10, 1, false, 0, false, 0, float(gun.get("loot_height", 0.0)), "gun")
	if not machine_gun_pickup.is_empty():                                                       # Draw the contested rapid-fire pickup only while it remains unclaimed.
		var gun_position: Vector2 = machine_gun_pickup.get("position", Vector2.ZERO)            # Read the shared Vector2 directly instead of reconstructing it from a Variant.
		_render_world_pickup("machine_gun_%d" % int(machine_gun_pickup.get("id", -1)), _gun_animation_texture(), gun_position, used, 0.10, 1.0, false, 0, false, 0, 0.0, "gun") # Cycle the authored Gun.tres rotation at its configured speed.
	var muzzle_smoke_started_us := Time.get_ticks_usec()                                       # Measure the complete per-card projection, occlusion, and cached-sprite update pass.
	for particle in active_muzzle_smoke_particles:                                              # Project every individual procedural barrel-smoke puff instead of one authored cloud sprite.
		var smoke_id := int(particle.get("id", -1))                                               # Reuse the stable puff ID for its Sprite2D and its per-camera stepped render state.
		var smoke_key := "muzzle_smoke_%d" % smoke_id                                             # Keep each puff card isolated from wall dust and every other smoke particle.
		var smoke_render_cache_key := "%d:%d" % [active_player_index, smoke_id]                  # The same shared-world puff has an independent screen-space result in each local camera.
		var smoke_visual_frame := int(particle.get("visual_frame", 0))                            # Recompute only when the established 14 FPS display sample advances.
		var cached_smoke_render: Variant = muzzle_smoke_render_cache.get(smoke_render_cache_key, {}) # Read generic cache values safely before deciding whether this frame can reuse the prior Sprite2D state.
		if cached_smoke_render is Dictionary and int(cached_smoke_render.get("visual_frame", -1)) == smoke_visual_frame:
			if bool(cached_smoke_render.get("visible", false)):
				used[smoke_key] = true                                                                 # Preserve the already-configured card without rewriting its texture, material, transform, tint, or z-layer.
				if DEBUG_DRAW_MUZZLE_SMOKE_CARDS:
					used["%s_card_debug" % smoke_key] = true                                             # Preserve the optional matching debug-card state through the same held frame.
			continue                                                                                   # Skip camera projection, line visibility, and Sprite2D work while the visible puff state is held.
		var smoke_world_position: Vector2 = particle.get("display_position", particle.get("position", Vector2.ZERO)) # Render the latest held pixel-animation sample, not sub-frame physics interpolation.
		if not _world_actor_overlaps_current_camera_fan(smoke_world_position, 0.10) or not _world_point_has_clear_camera_line(smoke_world_position):
			muzzle_smoke_render_cache[smoke_render_cache_key] = {"visual_frame": smoke_visual_frame, "visible": false} # Hold the hidden result for this visual frame rather than retesting it every game tick.
			continue                                                                               # Keep smoke hidden outside this camera's real field of view or behind an intervening wall.
		var smoke_projection := _opponent_projection_from_current_camera(smoke_world_position, true, true) # Use the unbounded world-effect projection so drifting smoke does not stop on a camera-cell seam.
		var smoke_sprite := _combat_sprite(smoke_key)                                            # Reuse a hard-edged Sprite2D for this particle in the current view.
		var smoke_height := float(smoke_projection.get("continuous_actor_height", smoke_projection.get("actor_height", 0.0))) # Preserve continuous world depth for the smoke's raised barrel anchor.
		var raw_smoke_screen_position := Vector2(float(smoke_projection["screen_x"]), float(smoke_projection["feet_y"]) - smoke_height * float(particle.get("display_height", particle.get("height", 0.72)))) # Project the existing shared-world puff motion before applying its fixed sprite-origin registration.
		var smoke_spawn_baseline := raw_smoke_screen_position                                      # Default to the physical projection when no authored character anchor exists yet.
		var smoke_spawn_anchor := raw_smoke_screen_position + _screen_muzzle_anchor_offset(int(particle.get("owner", -1)), StringName(particle.get("muzzle_hand", &"right")), raw_smoke_screen_position) # Capture the actual displayed PNG barrel pixel once for this camera and puff.
		var smoke_screen_velocity := Vector2.ZERO                                                  # Store drift in logical pixels so the camera's near-field projection cannot stretch it by grid position.
		if cached_smoke_render is Dictionary and cached_smoke_render.has("spawn_baseline_screen"):
			smoke_spawn_baseline = cached_smoke_render.get("spawn_baseline_screen", raw_smoke_screen_position) # Retain the original world projection rather than recomputing a new local-body offset after the shooter moves.
			smoke_spawn_anchor = cached_smoke_render.get("spawn_anchor_screen", smoke_spawn_anchor) # Keep smoke born at the original gun tip, never at the feet-relative legacy position.
			smoke_screen_velocity = cached_smoke_render.get("screen_velocity", Vector2.ZERO)         # Reuse the launch-time logical velocity for this puff's complete lifetime.
		else:
			var world_velocity: Vector2 = particle.get("velocity", Vector2.ZERO)                    # Retain the authored lateral/forward direction but not the depth-dependent projected magnitude.
			var probe_world_position := smoke_world_position + world_velocity * 0.01                  # Sample a tiny world step only to determine which screen direction this camera sees.
			var probe_projection := _opponent_projection_from_current_camera(probe_world_position, true, true)
			var probe_height := float(probe_projection.get("continuous_actor_height", probe_projection.get("actor_height", 0.0)))
			var probe_screen_position := Vector2(float(probe_projection["screen_x"]), float(probe_projection["feet_y"]) - probe_height * float(particle.get("display_height", particle.get("height", 0.72))))
			var screen_direction := (probe_screen_position - raw_smoke_screen_position).normalized()
			smoke_screen_velocity = screen_direction * world_velocity.length() * MUZZLE_SMOKE_SCREEN_PIXELS_PER_WORLD_UNIT
			smoke_screen_velocity.y -= float(particle.get("vertical_velocity", 0.0)) * MUZZLE_SMOKE_SCREEN_PIXELS_PER_WORLD_UNIT # Preserve a small, equally scaled upward powder rise.
		var smoke_lifetime := maxf(float(particle.get("lifetime", MUZZLE_SMOKE_LIFETIME_MAX)), 0.001) # Normalize this puff's fade against its own intentionally varied life.
		var smoke_age := smoke_lifetime - float(particle.get("timer", 0.0))                       # Advance this visual drift from its own creation time, independent of camera depth.
		var smoke_position := raw_smoke_screen_position                                             # Project the same shared-world puff directly; cameras may show perspective differences but never different world motion.
		if int(particle.get("owner", -1)) == active_player_index and float(particle.get("dual_wield_barrel_sign", 0.0)) <= 0.0 and not _character_has_muzzle_anchor(_character_sprite_for_current_view(int(particle.get("owner", -1))), StringName(particle.get("muzzle_hand", &"right"))):
			smoke_position.x += smoke_height * 0.13                                                # Keep the normal/left local barrel aligned with the same screen correction as its projectile.
		var remaining_fraction := clampf(float(particle.get("timer", 0.0)) / smoke_lifetime, 0.0, 1.0) # Retain opacity while fresh, then thin away as turbulence disperses the cloud.
		var smoke_alpha := minf(float(particle.get("opacity", 1.0)), remaining_fraction / 0.60) # Keep thick inner powder opaque and let the outer edge fade smoothly through transparency.
		var smoke_tone := float(particle.get("tone", 1.0))                                      # Read the preselected white-to-light-grey density variation.
		smoke_sprite.texture = _muzzle_smoke_cloud_texture(int(particle.get("cloud_variant", 0))) # Draw an irregular low-resolution alpha-noise cloud card instead of a rigid square pixel.
		smoke_sprite.material = null                                                              # Preserve exact white/grey particle colors without a palette shader.
		smoke_sprite.self_modulate = Color(smoke_tone, smoke_tone, smoke_tone, smoke_alpha)       # Overlapping opaque white puffs form the dense center while transparent grey puffs form thinning edges.
		smoke_sprite.position = smoke_position.round()                                            # Keep the whole procedural cloud locked to the screen pixel grid.
		var billow_progress := 1.0 - remaining_fraction                                          # Expand the card gradually as its powder loses density and disperses into the air.
		var world_scale := clampf(smoke_height / 42.0, 0.30, 1.0)                                # Preserve perspective: a nearby puff is roughly 32 pixels while a remote one recedes naturally.
		smoke_sprite.scale = Vector2.ONE * float(particle.get("base_scale", 0.6)) * lerpf(0.72, 1.0, billow_progress) * world_scale # Let puffs billow without ever enlarging their 32-pixel source beyond native texel density.
		smoke_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST                          # Keep the 32-by-32 cloud noise sharp and aliased rather than smoothly filtered.
		smoke_sprite.rotation = float(particle.get("display_rotation", 0.0))                    # Rotate each irregular puff through held 90-degree pixel-grid steps so the card reads as turbulent, not merely translated.
		smoke_sprite.z_index = _world_actor_draw_layer(smoke_world_position)                    # Sort smoke by its real muzzle point so it can sit behind/over a body naturally instead of overriding all actors as foreground UI.
		smoke_sprite.visible = true                                                               # Reveal this procedural puff.
		muzzle_smoke_render_cache[smoke_render_cache_key] = {"visual_frame": smoke_visual_frame, "visible": true, "spawn_baseline_screen": smoke_spawn_baseline, "spawn_anchor_screen": smoke_spawn_anchor, "screen_velocity": smoke_screen_velocity} # Keep fixed-pixel drift beside the one-time PNG muzzle registration for this puff's full lifetime.
		used[smoke_key] = true                                                                    # Preserve it until its individual lifetime expires.
		if DEBUG_DRAW_MUZZLE_SMOKE_CARDS:
			var card_debug_sprite := _combat_sprite("%s_card_debug" % smoke_key)                  # Draw a separate transparent overlay so inspecting bounds never changes the cloud's alpha mask.
			card_debug_sprite.texture = _muzzle_smoke_card_debug_outline_texture()                 # Show this particle's full 32-by-32 card rectangle and centered origin cross.
			card_debug_sprite.material = null                                                       # Preserve the literal debug color rather than applying a world-character palette shader.
			card_debug_sprite.self_modulate = Color(1.0, 0.10, 0.75, 0.85)                         # Use bright magenta so the diagnostic card borders are unmistakable over white smoke.
			card_debug_sprite.position = smoke_sprite.position                                      # Match the exact snapped cloud position.
			card_debug_sprite.scale = smoke_sprite.scale                                            # Match the card's complete billow and perspective scale.
			card_debug_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST                   # Keep the diagnostic rectangle as crisp pixel lines.
			card_debug_sprite.rotation = 0.0                                                        # Keep bounds axis aligned with the smoke card.
			card_debug_sprite.z_index = smoke_sprite.z_index + 1                                   # Draw the inspection mark over its cloud, never hidden inside it.
			card_debug_sprite.visible = true                                                        # Reveal this temporary diagnostic overlay.
			used["%s_card_debug" % smoke_key] = true                                               # Retain it through stale-node cleanup only while the debug toggle remains enabled.
	combat_vfx_render_profile["muzzle_smoke_us"] = Time.get_ticks_usec() - muzzle_smoke_started_us
	var trails_started_us := Time.get_ticks_usec()                                             # Measure trail pixels together with their hot projectile head/tail groups, which share the same projection path.
	combat_vfx_render_profile["trail_smoke_us"] = 0                                             # The old persistent grey smoke-particle path has been removed in favor of the compact live tracer.
	var projectile_hot_started_us := Time.get_ticks_usec()                                       # Time the live yellow/white/grey projectile vector.
	for shot in active_projectiles:                                                              # Render the bullet and every attached tracer pixel from one shared, current projectile state.
		var world_position: Vector2 = shot["position"]                                            # Read the authoritative collision point for this live projectile.
		var normally_visible := _world_actor_overlaps_current_camera_fan(world_position, 0.06) and _world_point_has_clear_camera_line(world_position) # Retain strict ordinary world/fan culling for non-threatening side shots.
		var aimed_at_current_viewer := int(shot.get("visual_target_player_index", -1)) == active_player_index # A real player-hit endpoint should remain readable even while its physical lead begins just outside the narrow camera fan.
		var target_world_position: Vector2 = shot.get("visual_target_position", world_position)
		if not normally_visible and (not aimed_at_current_viewer or not _world_point_has_clear_camera_line(target_world_position)):
			continue                                                                                   # Preserve wall occlusion; only retain an off-fan bullet when its known collision ray is truly coming into this viewer.
		var head_projection := _opponent_projection_from_current_camera(world_position, true, true) # Project the head exactly once for this camera and live projectile.
		var shot_id := int(shot.get("id", -1))                                                     # Keep each per-camera muzzle registration tied to this shared projectile ID.
		var launch_cache_key := "%d:%d" % [active_player_index, shot_id]                           # Split-screen cameras need independent sprite-space origins for one physical shot.
