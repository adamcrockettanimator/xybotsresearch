# _add_debug_menu_check: Adds one checkbox and binds it to a named existing debug option.
func _add_debug_menu_check(parent: VBoxContainer, option_key: String, label_text: String) -> void:
	var check := CheckBox.new()                                                                # Create a visible checkbox before the compact option title.
	check.text = label_text                                                                    # Describe the visual diagnostic controlled by the checkbox.
	check.button_pressed = _debug_option_value(option_key)                                    # Match its initial state to the existing inspector/runtime toggle.
	check.toggled.connect(_set_debug_option.bind(option_key))                                 # Apply user clicks through the shared option setter.
	parent.add_child(check)                                                                    # Add the checkbox to the menu's vertical stack.
	debug_menu_checks[option_key] = check                                                     # Save the node so keyboard toggles can refresh it later.



# _add_debug_menu_tuning_spin: Adds one F3-side live numerical control for near-camera investigation.
func _add_debug_menu_tuning_spin(parent: VBoxContainer, option_key: String, label_text: String, minimum: float, maximum: float, step: float) -> void:
	var row := HBoxContainer.new()                                                             # Keep a compact descriptive label and one editable value on a single menu row.
	var label := Label.new()                                                                   # Name the physical/display parameter instead of exposing a source-code identifier.
	label.text = label_text                                                                    # Use the short human-readable label in the diagnostic panel.
	label.custom_minimum_size = Vector2(78.0, 0.0)                                            # Fit labels and values into the narrow left side column.
	row.add_child(label)                                                                      # Add the parameter label before its value control.
	var spin := SpinBox.new()                                                                  # Use Godot's built-in typed numeric field with small arrow buttons.
	spin.min_value = minimum                                                                  # Constrain the control to the same safe range as its exported runtime field.
	spin.max_value = maximum                                                                  # Prevent accidental extreme values from making the near camera unusable.
	spin.step = step                                                                          # Match the source field's intended adjustment increment.
	spin.value = _near_view_tuning_value(option_key)                                          # Initialize from the current live state.
	spin.custom_minimum_size = Vector2(58.0, 0.0)                                             # Leave room for decimals while fitting the compact F3 panel.
	spin.value_changed.connect(_set_near_view_tuning_value.bind(option_key))                  # Apply each arrow/key adjustment immediately, without a game restart.
	row.add_child(spin)                                                                       # Place the editable value beside its label.
	parent.add_child(row)                                                                      # Add this control to the F3 diagnostic stack.
	debug_menu_tuning_spins[option_key] = spin                                                # Retain it so keyboard/menu refreshes reflect Inspector or code changes too.


# _add_debug_menu_layer_tuning_spin: Adds one wall/ceiling layer value to F3
# rather than depending on a fixed-resolution runtime panel.
func _add_debug_menu_layer_tuning_spin(parent: VBoxContainer, option_key: String, label_text: String, minimum: float, maximum: float, step: float) -> void:
	var row := HBoxContainer.new()
	var label := Label.new()
	label.text = label_text
	label.custom_minimum_size = Vector2(78.0, 0.0)
	row.add_child(label)
	var spin := SpinBox.new()
	spin.min_value = minimum
	spin.max_value = maximum
	spin.step = step
	spin.value = _layer_tuning_value(option_key)
	spin.custom_minimum_size = Vector2(58.0, 0.0)
	spin.tooltip_text = "Live runtime layer parallax tuning"
	spin.value_changed.connect(_set_layer_tuning_value.bind(option_key))
	row.add_child(spin)
	parent.add_child(row)
	debug_menu_layer_tuning_spins[option_key] = spin


func _layer_tuning_renderers() -> Array[Node]:
	var renderers: Array[Node] = []
	for renderer in coordinate_renderers:
		if is_instance_valid(renderer) and renderer.has_method("get_parallax_tuning_value") and renderer.has_method("set_parallax_tuning_value"):
			renderers.append(renderer)
	if not renderers.is_empty():
		return renderers
	# Retain the original one-renderer entry scene as a safe fallback. The
	# current continuous-camera scene registers P1/P2/P3/P4 renderers instead.
	var fallback := get_node_or_null("CoordinateFrameRuntimeRenderer")
	if is_instance_valid(fallback) and fallback.has_method("get_parallax_tuning_value") and fallback.has_method("set_parallax_tuning_value"):
		renderers.append(fallback)
	return renderers


func _layer_tuning_value(option_key: String) -> float:
	var renderers := _layer_tuning_renderers()
	if not renderers.is_empty():
		return float(renderers[0].call("get_parallax_tuning_value", option_key))
	return 0.0


func _set_layer_tuning_value(value: float, option_key: String) -> void:
	for renderer in _layer_tuning_renderers():
		renderer.call("set_parallax_tuning_value", option_key, value)



# _near_view_tuning_value: Reads one live near-view parameter for its F3 SpinBox.
func _near_view_tuning_value(option_key: String) -> float:
	match option_key:
		"rear_exit": return near_rear_exit_pixels
		"rear_side_exit": return near_rear_side_exit_pixels
		"side_trigger": return side_transition_trigger_offset
		"side_entry": return side_transition_entry_offset
		"body_scale_depth": return near_body_scale_depth_offset
		"crop_zoom": return near_camera_crop_zoom
		"crop_x": return near_camera_crop_focus_x
		"crop_y": return near_camera_crop_focus_y
		"overscan_x": return near_overscan_pan_limit_x_pixels
		"overscan_y": return near_overscan_pan_limit_y_pixels
		"camera": return near_camera_rear_offset
		"scale": return near_self_scale_multiplier
		"size_cap": return near_body_height_cap_pixels
		"side_keep": return near_side_keep_pixels
		"bottom_keep": return near_bottom_keep_pixels
	return 0.0



# _set_near_view_tuning_value: Applies one F3 live-tuning change and redraws the affected views immediately.
func _set_near_view_tuning_value(value: float, option_key: String) -> void:
	match option_key:
		"rear_exit": near_rear_exit_pixels = value
		"rear_side_exit": near_rear_side_exit_pixels = value
		"side_trigger": side_transition_trigger_offset = value
		"side_entry": side_transition_entry_offset = value
		"body_scale_depth": near_body_scale_depth_offset = value
		"crop_zoom": near_camera_crop_zoom = value
		"crop_x": near_camera_crop_focus_x = value
		"crop_y": near_camera_crop_focus_y = value
		"overscan_x": near_overscan_pan_limit_x_pixels = value
		"overscan_y": near_overscan_pan_limit_y_pixels = value
		"camera": near_camera_rear_offset = value
		"scale": near_self_scale_multiplier = value
		"size_cap": near_body_height_cap_pixels = value
		"side_keep": near_side_keep_pixels = value
		"bottom_keep": near_bottom_keep_pixels = value
	near_view_debug_last_map_frame = -1                                                      # Force one fresh top-down truth redraw after a parameter changes.
	_render_all_player_views()                                                                # Make the screen-space effect visible at the exact adjustment moment.



# _load_near_view_tuning: Restores only a prior deliberate F3 save; missing or malformed entries retain their code defaults.
func _load_near_view_tuning() -> void:
	var config := ConfigFile.new()                                                            # Keep near-view preference data isolated from the scene and project settings.
	if config.load(NEAR_VIEW_TUNING_CONFIG_PATH) != OK:                                      # First launch simply uses the checked-in defaults.
		return
	near_rear_exit_pixels = clampf(float(config.get_value("near_view", "rear_exit", near_rear_exit_pixels)), 0.0, 48.0)
	near_rear_side_exit_pixels = clampf(float(config.get_value("near_view", "rear_side_exit", near_rear_side_exit_pixels)), 0.0, 48.0)
	side_transition_trigger_offset = clampf(float(config.get_value("near_view", "side_trigger", side_transition_trigger_offset)), 0.50, 1.0)
	side_transition_entry_offset = clampf(float(config.get_value("near_view", "side_entry", side_transition_entry_offset)), 0.50, 1.0)
	near_body_scale_depth_offset = clampf(float(config.get_value("near_view", "body_scale_depth", near_body_scale_depth_offset)), 0.0, 1.0)
	near_camera_crop_zoom = clampf(float(config.get_value("near_view", "crop_zoom", near_camera_crop_zoom)), 0.25, 4.0)
	near_camera_crop_focus_x = clampf(float(config.get_value("near_view", "crop_x", near_camera_crop_focus_x)), 0.0, 160.0)
	near_camera_crop_focus_y = clampf(float(config.get_value("near_view", "crop_y", near_camera_crop_focus_y)), 0.0, 120.0)
	near_overscan_pan_limit_x_pixels = clampf(float(config.get_value("near_view", "overscan_x", near_overscan_pan_limit_x_pixels)), 0.0, 80.0)
	near_overscan_pan_limit_y_pixels = clampf(float(config.get_value("near_view", "overscan_y", near_overscan_pan_limit_y_pixels)), 0.0, 80.0)
	near_camera_rear_offset = clampf(float(config.get_value("near_view", "camera_rear", near_camera_rear_offset)), 0.20, 0.70)
	near_self_scale_multiplier = clampf(float(config.get_value("near_view", "player_scale", near_self_scale_multiplier)), 0.50, 1.50)
	near_body_height_cap_pixels = clampf(float(config.get_value("near_view", "near_size_cap", near_body_height_cap_pixels)), 48.0, 192.0)
	near_side_keep_pixels = clampf(float(config.get_value("near_view", "side_keep", near_side_keep_pixels)), 0.0, 96.0)
	near_bottom_keep_pixels = clampf(float(config.get_value("near_view", "bottom_keep", near_bottom_keep_pixels)), 0.0, 96.0)


# _save_near_view_tuning: Persists the complete F3 near-view control set only after the user presses its explicit button.
func _save_near_view_tuning() -> void:
	var config := ConfigFile.new()                                                            # Write a small Godot config in the user's app-data directory.
	config.set_value("near_view", "rear_exit", near_rear_exit_pixels)
	config.set_value("near_view", "rear_side_exit", near_rear_side_exit_pixels)
	config.set_value("near_view", "side_trigger", side_transition_trigger_offset)
	config.set_value("near_view", "side_entry", side_transition_entry_offset)
	config.set_value("near_view", "body_scale_depth", near_body_scale_depth_offset)
	config.set_value("near_view", "crop_zoom", near_camera_crop_zoom)
	config.set_value("near_view", "crop_x", near_camera_crop_focus_x)
	config.set_value("near_view", "crop_y", near_camera_crop_focus_y)
	config.set_value("near_view", "overscan_x", near_overscan_pan_limit_x_pixels)
	config.set_value("near_view", "overscan_y", near_overscan_pan_limit_y_pixels)
	config.set_value("near_view", "camera_rear", near_camera_rear_offset)
	config.set_value("near_view", "player_scale", near_self_scale_multiplier)
	config.set_value("near_view", "near_size_cap", near_body_height_cap_pixels)
	config.set_value("near_view", "side_keep", near_side_keep_pixels)
	config.set_value("near_view", "bottom_keep", near_bottom_keep_pixels)
	var save_result := config.save(NEAR_VIEW_TUNING_CONFIG_PATH)                             # Replace only this user-owned tuning file with the requested current snapshot.
	if save_result != OK:
		push_warning("Could not save near-view tuning to %s (error %d)." % [NEAR_VIEW_TUNING_CONFIG_PATH, save_result])



# _toggle_debug_menu: Opens or closes the debug control panel and refreshes its displayed state.
func _toggle_debug_menu() -> void:
	debug_menu_open = not debug_menu_open                                                      # Flip the menu visibility state once per F3 press.
	if debug_menu_panel != null:                                                               # Guard against calls before _ready has created the panel.
		debug_menu_panel.visible = debug_menu_open                                               # Apply the new panel visibility.
	if debug_menu_right_panel != null:
		debug_menu_right_panel.visible = debug_menu_open                                         # Keep the renderer/debug column paired with the camera column.
	if debug_menu_open:                                                                        # Refresh checkbox state whenever the panel is opened.
		_refresh_debug_menu()                                                                    # Reflect inspector values and F2 toggles in every row.
	_layout_viewport()                                                                         # Reclaim the side gutters immediately when F3 closes, or make room only while it is open.
	_update_status()                                                                           # Update the runtime help text to advertise the current menu state.



# _debug_option_value: Reads one existing debug toggle by its stable menu key.
func _debug_option_value(option_key: String) -> bool:
	match option_key:                                                                          # Resolve the menu key without exposing property names to UI construction.
		"source_map":
			return show_top_down_source_overlay                                                     # Return the logical-map and physical-wall overlay state.
		"rays":
			return show_raycast_debug                                                              # Return the visibility ray overlay state.
		"pickup_range":
			return show_pickup_range_debug                                                         # Return the same-cell collectible footprint diagnostic state.
		"extents":
			return show_perspective_extents_overlay                                                # Return the measured floor/actor extent overlay state.
		"near_view_tuning":
			return show_near_view_tuning_debug                                                     # Return whether live near-camera clamp guides are visible.
		"camera_cutaway":
			return show_camera_cutaway_debug                                                       # Return whether the local wall-fade ray fan is visible on the source map.
		"fan_draw_order":
			return show_fan_draw_order_debug                                                       # Return whether the local player-versus-wall ordering diagnostic is visible.
		"world_footprints":
			return show_world_footprints_debug
		"muzzle_anchors":
			return show_muzzle_anchor_debug                                                        # Return whether the temporary cyan/magenta barrel-origin comparison is enabled.
		"pause_round_timer":
			return pause_round_timer_for_debug                                                     # Return the independent debug pause state for the shared match clock.
		"slot_grid":
			return show_slot_grid_debug                                                            # Return the blue wall-slot audit overlay state.
		"render_walls":
			return render_wall_art                                                                 # Return whether transparent wall overlays are currently visible.
		"music":
			return music_enabled                                                                    # Return the explicit local-test music preference.
		"walk_through_walls":
			return walk_through_walls_cheat                                                        # Return whether only player movement is intentionally allowed through map walls.
		"selected_slots":
			return show_selected_wall_slot_debug                                                   # Return the renderer-selection comparison overlay state.
		"manual_forward":
			return manual_forward_step_enabled                                                      # Return whether Fwd frames wait for repeated forward input.
		"manual_strafe":
			return manual_strafe_step_enabled                                                       # Return whether side-camera frames wait for repeated lateral input.
		"manual_turn":
			return manual_turn_step_enabled                                                         # Return whether 22/66 turn frames wait for repeated turn input.
		"slot_tuner":
			return slot_graph_tuner_enabled                                                        # Return whether the current graph accepts endpoint drags.
		"coordinate_integer_snap":
			var renderer := get_node_or_null("CoordinateFrameRuntimeRenderer")                    # The experimental runtime renderer only exists on its dedicated branch/scene.
			return bool(renderer.integer_uv_scale_snap_enabled) if renderer != null else false     # Keep the ordinary sprite renderer menu safe when the experiment is absent.
		"coordinate_screen_overlay":
			for renderer in coordinate_renderers:
				if is_instance_valid(renderer) and renderer.has_method("set_coordinate_screen_overlay_debug_enabled"):
					return bool(renderer.get("coordinate_screen_overlay_debug_enabled"))
			return false
		"coordinate_wall_ewa":
			var renderer := get_node_or_null("CoordinateFrameRuntimeRenderer")                    # Read the same optional renderer for the filtering comparison state.
			return bool(renderer.wall_ewa_filter_enabled) if renderer != null else false            # Keep this option disabled outside the coordinate-frame experiment.
		"coordinate_wall_parallax":
			var renderer := get_node_or_null("CoordinateFrameRuntimeRenderer")                    # Read the optional depth-map experiment state when this branch is active.
			return bool(renderer.wall_parallax_enabled) and renderer.wall_layer1_image != null and renderer.wall_layer2_image != null if renderer != null else false # Only show checked when both authored runtime wall layers are available.
		"coordinate_ceiling_parallax":
			var renderer := get_node_or_null("CoordinateFrameRuntimeRenderer")                    # Read the optional two-layer ceiling experiment state.
			return bool(renderer.ceiling_parallax_enabled) and renderer.ceiling_layer1_image != null and renderer.ceiling_layer2_image != null if renderer != null else false # Only show checked when both authored ceiling layers are available.
		"coordinate_layer_edge_clamp":
			var renderer := get_node_or_null("CoordinateFrameRuntimeRenderer")                    # Read the independent UV-fringe cleanup mode.
			return bool(renderer.layer_uv_edge_clamp_enabled) if renderer != null else false
		_:
			return false                                                                           # Keep unknown future menu keys safely disabled.



# _set_debug_option: Updates one existing debug toggle, redraws both views, and syncs the menu.
func _set_debug_option(enabled: bool, option_key: String) -> void:
	match option_key:                                                                          # Assign only the existing diagnostic flags selected by the menu.
		"source_map":
			show_top_down_source_overlay = enabled                                                 # Show or hide the top-down wall/contact source map.
		"rays":
			show_raycast_debug = enabled                                                           # Show or hide sampled visibility rays and their hit markers.
			if enabled:
				show_top_down_source_overlay = true                                                  # Make the authoritative map visible whenever ray inspection is requested from F3.
		"pickup_range":
			show_pickup_range_debug = enabled
			if enabled:
				show_top_down_source_overlay = true                                                  # The ellipse is meaningful only on the top-down source map.
		"extents":
			show_perspective_extents_overlay = enabled                                             # Show or hide projected floor and actor-boundary guides.
		"near_view_tuning":
			show_near_view_tuning_debug = enabled                                                  # Show raw/clamped local anchors in every player view and the shared top-down map.
			if enabled:
				show_top_down_source_overlay = true                                                  # The clamp is meaningful only alongside its world-space ground truth.
		"camera_cutaway":
			show_camera_cutaway_debug = enabled                                                    # Show the same visual-only camera fan that drives local wall fades.
			if enabled:
				show_top_down_source_overlay = true                                                  # The cutaway fan is meaningful only alongside the physical wall map.
		"fan_draw_order":
			show_fan_draw_order_debug = enabled                                                    # Show the resulting above/below-player wall layer decision without altering it.
			if enabled:
				show_top_down_source_overlay = true                                                  # The segment/fan relationship is meaningful only alongside the physical wall map.
		"world_footprints":
			show_world_footprints_debug = enabled
			if enabled:
				show_top_down_source_overlay = true
		"muzzle_anchors":
			show_muzzle_anchor_debug = enabled                                                     # Keep the marker diagnostic opt-in and independent of combat.
			if not enabled:
				muzzle_anchor_debug_markers.clear()                                                  # Remove lingering snapshots immediately when the diagnostic closes.
		"pause_round_timer":
			pause_round_timer_for_debug = enabled                                                  # Leave all diagnostics and simulation live; pause only the one shared round countdown.
		"slot_grid":
			show_slot_grid_debug = enabled                                                         # Show or hide the blue numbered wall-slot audit grid.
		"render_walls":
			render_wall_art = enabled                                                              # Hide/reveal only rendered wall overlays; map walls and collision remain active.
		"music":
			music_enabled = enabled
			if music_player != null:
				if music_enabled and match_started:
					music_player.play()
				else:
					music_player.stop()
		"walk_through_walls":
			walk_through_walls_cheat = enabled                                                     # Keep the cheat scoped to player navigation; projectiles and renderer visibility still respect walls.
		"selected_slots":
			show_selected_wall_slot_debug = enabled                                                # Show or hide renderer-selected wall-slot highlights.
		"manual_forward":
			manual_forward_step_enabled = enabled                                                   # Toggle input-driven Fwd 1 -> Fwd 2 -> destination stepping.
		"manual_strafe":
			manual_strafe_step_enabled = enabled                                                    # Toggle input-driven Right 1 -> 2 -> 3 stepping.
		"manual_turn":
			manual_turn_step_enabled = enabled                                                      # Toggle input-driven 22/66 turn stepping.
		"slot_tuner":
			slot_graph_tuner_enabled = enabled                                                     # Toggle direct editing of the graph currently on screen.
			if enabled: show_slot_grid_debug = true                                                 # Ensure the draggable blue endpoints are visible when tuning starts.
		"coordinate_integer_snap":
			var renderer := get_node_or_null("CoordinateFrameRuntimeRenderer")                    # Locate the optional runtime wall experiment without coupling the base renderer to it.
			if renderer != null and renderer.has_method("set_integer_uv_scale_snap_enabled"):
				renderer.set_integer_uv_scale_snap_enabled(enabled)                                  # Apply only the sampling experiment; world/projected geometry remains fixed.
		"coordinate_screen_overlay":
			for renderer in coordinate_renderers:
				if is_instance_valid(renderer) and renderer.has_method("set_coordinate_screen_overlay_debug_enabled"):
					renderer.call("set_coordinate_screen_overlay_debug_enabled", enabled)
		"coordinate_wall_ewa":
			var renderer := get_node_or_null("CoordinateFrameRuntimeRenderer")                    # Locate the same optional renderer for EWA-style wall filtering.
			if renderer != null and renderer.has_method("set_wall_ewa_filter_enabled"):
				renderer.set_wall_ewa_filter_enabled(enabled)                                        # Apply mip-assisted anisotropic wall samples immediately.
		"coordinate_wall_parallax":
			var renderer := get_node_or_null("CoordinateFrameRuntimeRenderer")                    # Locate the runtime wall depth-map experiment without affecting legacy walls.
			if renderer != null and renderer.has_method("set_wall_parallax_enabled"):
				renderer.set_wall_parallax_enabled(enabled)                                          # Switch relief mapping while preserving the current layout and source texture.
		"coordinate_ceiling_parallax":
			var renderer := get_node_or_null("CoordinateFrameRuntimeRenderer")                    # Locate the independent ceiling layer experiment without affecting legacy walls.
			if renderer != null and renderer.has_method("set_ceiling_parallax_enabled"):
				renderer.set_ceiling_parallax_enabled(enabled)                                       # Switch ceiling Layer 2 relief while preserving its mapped cells.
		"coordinate_layer_edge_clamp":
			var renderer := get_node_or_null("CoordinateFrameRuntimeRenderer")                    # Locate the runtime wall layer pass without affecting legacy walls.
			if renderer != null and renderer.has_method("set_layer_uv_edge_clamp_enabled"):
				renderer.set_layer_uv_edge_clamp_enabled(enabled)                                    # Choose edge-clamped or raw transparent UV behavior.
		_:
			return                                                                                # Ignore unsupported keys without redrawing.
	_render_all_player_views()                                                                 # Redraw every local view immediately so changes are visible at once.
	_refresh_debug_menu()                                                                      # Keep all checkbox states synchronized after a click.
	_update_status()                                                                           # Keep the status hint synchronized with the current menu state.



# _refresh_debug_menu: Synchronizes visible menu checkboxes without emitting extra toggle callbacks.
func _refresh_debug_menu() -> void:
	for option_key in debug_menu_checks:                                                       # Visit every checkbox created by _setup_debug_menu.
		var check: CheckBox = debug_menu_checks[option_key]                                      # Read the checkbox stored for this menu key.
		if check != null:                                                                        # Skip a node only if it has been freed during scene teardown.
			check.set_pressed_no_signal(_debug_option_value(String(option_key)))                   # Reflect the current flag without recursively redrawing.
	for option_key in debug_menu_tuning_spins:                                                 # Keep F3 values synchronized after a Remote/inspector edit or map reset.
		var spin: SpinBox = debug_menu_tuning_spins[option_key]                                  # Read the control retained for this stable tuning key.
		if spin != null:
			spin.set_value_no_signal(_near_view_tuning_value(String(option_key)))                  # Update without recursively rerendering during a UI refresh.
	for option_key in debug_menu_layer_tuning_spins:
		var layer_spin: SpinBox = debug_menu_layer_tuning_spins[option_key]
		if layer_spin != null:
			layer_spin.set_value_no_signal(_layer_tuning_value(String(option_key)))
	if debug_combat_hit_label != null:                                                         # Refresh the latest combat result whenever F3 is opened.
		debug_combat_hit_label.text = "LAST COMBAT LOS\n" + last_projectile_hit_debug          # Keep gameplay diagnostics out of the normal split-screen HUD.



# _setup_local_multiplayer: Creates player two's view nodes and initializes two independent local player states.
func _setup_local_multiplayer() -> void:                                                    # Declare this function.
	if TEMP_GRID_AUDIT:                                                                        # Keep this focused slot-grid test free of a second player or second viewport.
		player_views = [{"maze_viewport": maze_viewport, "maze_content": maze_content, "playfield": playfield, "player_sprite": player_sprite, "opponent_sprite": null}] # Retain only player one's existing view nodes.
		player_states = [_make_player_state(0, Vector2i(4, 4), 0)]                               # Place one player at the center of the empty 9x9 grid, facing north.
		_bind_player_context(0)                                                                   # Bind the sole test player into the legacy renderer globals.
		return                                                                                    # Skip creating player two's view and opponent sprites.
	status_label.visible = false                                                                  # The separate player windows use focused HUD elements instead of the old shared debug readout.
	var player_one_window := get_window()                                                        # Treat the existing game window as player one's native display.
	player_windows = [player_one_window]                                                         # Retain player one's host before creating the second display.
	var player_two_window := player_one_window                                                    # All player views share one native game window.
	player_two_window.name = "PlayerTwoWindow"                                                  # Keep the second display identifiable in the remote scene tree.
	player_two_window.title = "XybotsResearch — Player 2"                                      # Make the second monitor unmistakable during local playtests.
	player_two_window.unresizable = false                                                        # Keep the shared display resizable.
	player_windows.append(player_two_window)                                                     # Retain the native player-two window for layout and HUD placement.
	player_sprite.set_meta("team_index", 0)                                                    # Persist Team 1 ownership on the scene-authored player sprite.
	var player_one_opponent := _create_character_sprite("OpponentSprite", 1)                    # Create player one's Team 2 Cowboy1 sprite used for seeing player two.
	player_one_opponent.set_meta("team_index", 1)                                              # This view's opponent is always the Team 2 character.
	maze_content.add_child(player_one_opponent)                                                 # Put the opponent sprite into player one's clipped camera content.
	var player_two_viewport := Node2D.new()                                                     # Create a second cropped playfield container for player two.
	player_two_viewport.name = "MazeViewportP2"                                                 # Name the player-two view for scene-tree inspection.
	add_child(player_two_viewport)                                                                # Attach Player 2 beside the scene-owned Player 1 camera in the shared window.
	var player_two_hud := CanvasLayer.new()                                                      # Give player two a dedicated HUD canvas inside their native window.
	player_two_hud.name = "PlayerTwoHud"                                                       # Keep the second display's UI easy to inspect.
	add_child(player_two_hud)                                                                     # Keep the HUD in the same scene tree as the other split-screen overlays.
	var player_two_content := _ensure_viewport_clipper(player_two_viewport)                     # Give player two the same 160x120 camera clipper.
	var player_two_playfield := Sprite2D.new()                                                   # Create player two's transition-frame sprite.
	player_two_playfield.name = "Playfield"                                                     # Match player one's child naming convention.
	player_two_playfield.centered = false                                                       # Anchor player two's playfield from its top-left corner.
	player_two_playfield.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST                     # Preserve the cropped pixel art.
	player_two_content.add_child(player_two_playfield)                                          # Add the playfield to player two's clipped camera content.
	var player_two_sprite := _create_character_sprite("PlayerSprite", 1)                        # Create player two's own Team 2 Cowboy1 character sprite.
	player_two_sprite.set_meta("team_index", 1)                                                # Persist Team 2 ownership independently of whichever view is currently bound.
	player_two_content.add_child(player_two_sprite)                                             # Add player two's self sprite to the clipped camera content.
	var player_two_opponent := _create_character_sprite("OpponentSprite", 0)                    # Create player two's Team 1 Cowboy2 sprite used for seeing player one.
	player_two_opponent.set_meta("team_index", 0)                                              # This view's opponent is always the Team 1 character.
	player_two_content.add_child(player_two_opponent)                                           # Add player two's opponent sprite to the clipped camera content.
	player_views = [                                                                            # Store view-node bundles for each local player.
		{"maze_viewport": maze_viewport, "maze_content": maze_content, "playfield": playfield, "player_sprite": player_sprite, "opponent_sprite": player_one_opponent, "hud_layer": canvas_layer, "player_window": player_one_window}, # Store player one's existing view nodes.
		{"maze_viewport": player_two_viewport, "maze_content": player_two_content, "playfield": player_two_playfield, "player_sprite": player_two_sprite, "opponent_sprite": player_two_opponent, "hud_layer": player_two_hud, "player_window": player_two_window}, # Store player two's native-window nodes.
	]                                                                                           # Close the local-player view list.
	for player_index in range(2, 4):
		player_views.append(_create_single_window_player_view(player_index))
	player_states = _make_start_player_states()                                                 # Create initial player-state records for both local players.
	_setup_all_view_opponent_sprites()
	_bind_player_context(0)                                                                     # Bind player one back into the legacy globals after setup.


func _create_single_window_player_view(player_index: int) -> Dictionary:
	var view_root := Node2D.new()
	view_root.name = "MazeViewportP%d" % (player_index + 1)
	add_child(view_root)
	var hud := CanvasLayer.new()
	hud.name = "PlayerHudP%d" % (player_index + 1)
	add_child(hud)
	var content := _ensure_viewport_clipper(view_root)
	var field := Sprite2D.new()
	field.name = "Playfield"
	field.centered = false
	field.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	content.add_child(field)
	var self_sprite := _create_character_sprite("PlayerSprite", PLAYER_TEAMS[player_index])
	self_sprite.set_meta("team_index", PLAYER_TEAMS[player_index])
	content.add_child(self_sprite)
	var opponent := _create_character_sprite("OpponentSprite", PLAYER_TEAMS[0])
	opponent.set_meta("team_index", PLAYER_TEAMS[0])
	content.add_child(opponent)
	return {"maze_viewport": view_root, "maze_content": content, "playfield": field, "player_sprite": self_sprite, "opponent_sprite": opponent, "hud_layer": hud, "player_window": get_window()}


func _setup_all_view_opponent_sprites() -> void:
	for viewer_index in range(player_views.size()):
		var view := player_views[viewer_index]
		var sprites := {}
		var retained: AnimatedSprite2D = view.get("opponent_sprite", null)
		var retained_target := 1 if viewer_index == 0 else 0
		if retained != null:
			retained.set_meta("player_index", retained_target)
			sprites[retained_target] = retained
		var content: Node2D = view.get("maze_content", null)
		for target_index in range(4):
			if target_index == viewer_index or sprites.has(target_index):
				continue
			var sprite := _create_character_sprite("OpponentP%d" % (target_index + 1), PLAYER_TEAMS[target_index])
			sprite.set_meta("player_index", target_index)
			sprite.set_meta("team_index", PLAYER_TEAMS[target_index])
			content.add_child(sprite)
			sprites[target_index] = sprite
		view["opponent_sprites"] = sprites
		player_views[viewer_index] = view


# _activate_player_two_window: Opens two ordinary OS windows that players can drag and resize onto any monitor.
func _activate_player_two_window(player_one_window: Window, player_two_window: Window) -> void:
	var screen_count := DisplayServer.get_screen_count()                                         # Use a second display only as the initial placement convenience.
	if not player_one_window.is_embedded():                                                      # Native game windows can be freely resized by the operating system.
		player_one_window.mode = Window.MODE_WINDOWED                                               # Never force player one into fullscreen.
		player_one_window.unresizable = false                                                       # Let the user resize player one's window as desired.
	player_two_window.mode = Window.MODE_WINDOWED                                                # Keep player two in a normal movable, resizable OS window as well.
	player_two_window.unresizable = false                                                        # Do not lock player two's window size.
	if screen_count > 1:
		player_two_window.current_screen = 1                                                       # Initially place player two on the second monitor when one exists.
	else:
		player_two_window.position = player_one_window.position + Vector2i(56, 56)                # Offset the second window so both are reachable on one monitor.
	player_two_window.visible = true                                                             # Explicitly surface the deferred native window after it joins the tree.



# _make_start_player_states: Returns the normal gameplay start or the pinned slot-audit start.
func _make_start_player_states() -> Array[Dictionary]:                                    # Declare this function.
	if AUDIT_START_ENABLED:                                                                    # Use the deterministic correction frame while auditing the slot grid.
		return [                                                                                  # Return the two-player audit state list.
			_make_audit_player_state(0, AUDIT_P1_CELL, AUDIT_P1_FACING, AUDIT_P1_TURN_45_DIRECTION, AUDIT_P1_LOCAL_POSITION), # Start player one on the NE guide panel state.
			_make_audit_player_state(1, AUDIT_P2_CELL, AUDIT_P2_FACING, AUDIT_P2_TURN_45_DIRECTION, AUDIT_P2_LOCAL_POSITION), # Start player two on the north guide panel state.
		]                                                                                         # Close the audit state list.
	return [                                                                                    # Return the normal two-player gameplay state list.
		_make_player_state(0, Vector2i(0, MAP_HEIGHT - 1), 0),                                    # Start player one in the southwest corner facing north.
		_make_player_state(1, Vector2i(MAP_WIDTH - 1, 0), 2),                                     # Start player two in the northeast corner facing south.
		_make_player_state(2, Vector2i(MAP_WIDTH - 1, MAP_HEIGHT - 1), 0),
		_make_player_state(3, Vector2i(0, 0), 2),
	]                                                                                           # Close the normal state list.


# _apply_session_roster: Makes title-menu players human-controlled and fills every remaining combat slot with a bot.
func _apply_session_roster() -> void:
	var session := get_node_or_null("/root/GrudgeSession")
	var roster_slots: Array = [false, false, false, false]
	var roster_devices: Array = [-1, -1, -1, -1]
	# Prefer the SceneTree handoff created by the lobby. Unlike a live autoload
	# read, it cannot be replaced while the coordinate-frame wrapper instantiates
	# main.tscn during the scene change.
	if get_tree().has_meta("grudge_match_human_slots"):
		roster_slots = get_tree().get_meta("grudge_match_human_slots")
		roster_devices = get_tree().get_meta("grudge_match_device_ids")
	elif session != null:
		roster_slots = session.get("human_slots")
		roster_devices = session.get("slot_device_ids")
	var has_human_selection := false
	for player_index in range(4):
		has_human_selection = has_human_selection or bool(roster_slots[player_index])
	for player_index in range(mini(4, player_joined.size())):
		var human := bool(roster_slots[player_index])
		# Running main.tscn directly from the editor skips the title-menu handoff.
		# Preserve one controllable keyboard player in that workflow instead of
		# silently converting every slot into an NPC.
		if not has_human_selection and player_index == 0:
			human = true
		player_bots[player_index] = not human
		player_device_ids[player_index] = int(roster_devices[player_index]) if human else -1
		player_joined[player_index] = true                                                       # Bots are full participants: visible, hittable, scoreable, and able to collect pickups.
	player_two_joined = true                                                                    # Preserve the legacy P2 combat guard while either a human or a bot occupies slot two.
	match_started = true


# _is_human_controlled_slot: Uses the immutable match-start roster, not a live
# autoload that may be recreated as Godot replaces the title scene.
func _is_human_controlled_slot(player_index: int) -> bool:
	return player_index >= 0 and player_index < player_bots.size() and not player_bots[player_index]


# _is_bot_controlled_slot: A human lobby claim always wins, even if an earlier setup pass marked the slot as a bot.
func _is_bot_controlled_slot(player_index: int) -> bool:
	return player_index >= 0 and player_index < player_bots.size() and player_bots[player_index] and not _is_human_controlled_slot(player_index)


# _update_bot_input: A deliberately simple hunter: face the closest enemy, advance when aligned, and fire only down a clear corridor.
func _update_bot_input(player_index: int) -> void:
	bot_inputs.erase(player_index)
	if not bots_enabled:
		return
	if not _is_bot_controlled_slot(player_index) or player_index >= player_states.size():
		return
	var state: Dictionary = player_states[player_index]
	var origin := _player_state_world_position(state)
	var target_index := -1
	var target_distance := INF
	for other_index in range(player_states.size()):
		if other_index == player_index or not player_joined[other_index] or PLAYER_TEAMS[other_index] == PLAYER_TEAMS[player_index] or bool(player_states[other_index].get("is_dying", false)):
			continue
		var distance := origin.distance_to(_player_state_world_position(player_states[other_index]))
		if distance < target_distance:
			target_distance = distance
			target_index = other_index
	if target_index < 0:
		return
	var target_vector := _player_state_world_position(player_states[target_index]) - origin
	var navigation_vector := _bot_navigation_direction(state, target_vector)
	var virtual_input := {"left": false, "right": false, "forward": false, "fire": false}
	if continuous_third_person_camera:
		var free_forward := _view_forward_vector_for_state(state).normalized()
		var free_target_direction := navigation_vector.normalized()
		var alignment := free_forward.dot(free_target_direction)
		if alignment > 0.985:
			virtual_input["forward"] = true
			virtual_input["fire"] = free_forward.dot(target_vector.normalized()) > 0.96 and _nearest_projectile_wall_distance(origin, free_forward, target_distance) >= target_distance
		elif free_forward.cross(free_target_direction) > 0.0:
			virtual_input["right"] = true
		else:
			virtual_input["left"] = true
		bot_inputs[player_index] = virtual_input
		return
	var wanted_facing := 1 if absf(navigation_vector.x) > absf(navigation_vector.y) and navigation_vector.x > 0.0 else 3 if absf(navigation_vector.x) > absf(navigation_vector.y) else 2 if navigation_vector.y > 0.0 else 0
	var facing := int(state.get("facing", 0))
	var turn := (wanted_facing - facing + 4) % 4
	if turn == 1:
		virtual_input["right"] = true
	elif turn == 3:
		virtual_input["left"] = true
	elif turn == 2:
		virtual_input["right"] = true
	else:
		virtual_input["forward"] = true
		var forward := _view_forward_vector_for_state(state).normalized()
		var target_direction := target_vector.normalized()
		var wall_distance := _nearest_projectile_wall_distance(origin, forward, target_distance)
		virtual_input["fire"] = forward.dot(target_direction) > 0.96 and wall_distance >= target_distance
	bot_inputs[player_index] = virtual_input


# _bot_navigation_direction: Take the open neighboring cell whose direction most closely reduces distance to the target.
# This greedy maze step naturally turns around in dead ends instead of repeatedly pressing into a wall.
func _bot_navigation_direction(state: Dictionary, target_vector: Vector2) -> Vector2:
	var cell: Vector2i = state.get("grid_position", Vector2i(-1, -1))
	var desired := target_vector.normalized()
	var best_direction := desired
	var best_score := -INF
	for direction in [Vector2i(0, -1), Vector2i(1, 0), Vector2i(0, 1), Vector2i(-1, 0)]:
		if not _can_cross_edge(cell, direction):
			continue
		var score := Vector2(direction).normalized().dot(desired)
		if score > best_score:
			best_score = score
			best_direction = Vector2(direction)
	return best_direction



# _make_audit_player_state: Builds a player state and applies fixed local/facing values for the grid-correction screenshot.
func _make_audit_player_state(player_index: int, start_cell: Vector2i, start_facing: int, start_turn_45: int, start_local_position: Vector2) -> Dictionary: # Declare this function.
	var state := _make_player_state(player_index, start_cell, start_facing)                    # Build the normal state record first.
	state["turn_45_direction"] = start_turn_45                                                  # Apply the requested cardinal or halfway-turn view.
	state["turn_step"] = 2 if start_turn_45 != 0 else 0                                         # Keep audit diagonal starts on the 45-degree stage.
	state["local_floor_position"] = start_local_position                                       # Apply the requested in-cell actor position.
	state["world_position"] = _world_position_from_state_fields(start_cell, start_local_position, state) # Make the audit capsule agree with its displayed starting pose.
	state["world_run_dir"] = _direction_string_for_facing(start_facing)                        # Keep the world run direction coherent with the audit facing.
	state["world_aim_dir"] = _direction_string_for_facing(start_facing)                        # Keep the world aim direction coherent with the audit facing.
	return state                                                                               # Return the corrected audit state.



# _create_character_sprite: Builds a character AnimatedSprite2D with the run set assigned to its team.
func _create_character_sprite(sprite_name: String, team_index: int) -> AnimatedSprite2D:   # Declare this function.
	var sprite := AnimatedSprite2D.new()                                                       # Create a fresh animated character sprite.
	sprite.name = sprite_name                                                                   # Name the sprite for scene-tree inspection.
	var frames_path := TEAM_TWO_FRAMES if team_index == 1 else TEAM_ONE_FRAMES                 # Select the shared authored-color Cowboy2 frames for either team.
	var frames := load(frames_path)                                                             # Load that team's SpriteFrames resource.
	if frames is SpriteFrames:
		sprite.sprite_frames = frames.duplicate(true)                                             # Give this sprite its own mutable copy of the team's animations.
	else:
		sprite.sprite_frames = player_sprite.sprite_frames.duplicate(true)                        # Retain the prior player resource as a safe fallback if an asset is missing.
	_add_idle_animations(sprite.sprite_frames)                                                   # Give every player and opponent the same directional idle clips as the primary player.
	_add_crouch_walk_animations(sprite.sprite_frames)
	_add_dual_wield_idle_animations(sprite.sprite_frames)                                       # Add the powered-up idle loops beside, not instead of, the normal idle clips.
	_add_death_animations(sprite.sprite_frames)                                                  # Give every player and opponent the preliminary directional death clips.
	_add_dual_wield_forward_animations(sprite.sprite_frames)                                    # Add the temporary forward-only dual-pistol runs without replacing the base movement set.
	_add_dual_wield_left_animations(sprite.sprite_frames)                                       # Add the temporary left-strafe dual-pistol runs without replacing the base movement set.
	_add_dual_wield_right_animations(sprite.sprite_frames)                                      # Add the temporary right-strafe dual-pistol runs without replacing the base movement set.
	sprite.centered = true                                                                      # Register the sprite from its center like the original player node.
	sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST                                  # Preserve the source sprite pixels when scaled.
	sprite.z_index = 10 if sprite_name == "PlayerSprite" else 9                                 # Give characters a default layer before runtime depth sorting.
	sprite.visible = sprite_name == "PlayerSprite"                                             # Hide opponent sprites until another player is actually visible.
	var respawn_label := Label.new()                                                            # Add a compact world-space countdown for a dead opponent.
	respawn_label.name = "OpponentRespawnCountdown"                                            # Keep the label easy to find without sharing it with the local HUD timer.
	respawn_label.add_theme_font_override("font", pixel_hud_font)                            # Match the existing hard-edged HUD lettering.
	respawn_label.add_theme_font_size_override("font_size", 8)                               # Stay smaller than the coin, heart, and gun pickup presentation.
	respawn_label.add_theme_color_override("font_color", Color(1.0, 0.12, 0.08, 1.0))        # Match the local blackout's clear arcade-red countdown color over the fallen body.
	respawn_label.add_theme_color_override("font_shadow_color", Color.BLACK)                 # Keep the numeral legible against every death frame.
	respawn_label.add_theme_constant_override("shadow_offset_x", 1)                          # Use one source pixel of hard shadow horizontally.
	respawn_label.add_theme_constant_override("shadow_offset_y", 1)                          # Use one source pixel of hard shadow vertically.
	respawn_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER                           # Center the one-digit counter over the body.
	respawn_label.position = Vector2(-4.0, -8.0)                                               # Hold the numeral close to the body rather than floating above the death sprite.
	respawn_label.size = Vector2(8.0, 8.0)                                                     # Keep the label compact before normal character depth scaling.
	respawn_label.mouse_filter = Control.MOUSE_FILTER_IGNORE                                   # Never interfere with gameplay input.
	respawn_label.z_index = 1                                                                  # Draw just above its owning opponent sprite.
	respawn_label.visible = false                                                              # Show only during the opponent's countdown phase.
	sprite.add_child(respawn_label)                                                            # Let the counter follow the body through projection and depth scaling.
	return sprite                                                                               # Return the configured character sprite.



# _make_player_state: Builds one serializable local player state dictionary.
func _make_player_state(player_index: int, start_cell: Vector2i, start_facing: int) -> Dictionary: # Declare this function.
	return {                                                                                    # Return a complete player-state record.
		"player_index": player_index,                                                             # Store this player's local index.
		"active_sequence": [],                                                                     # Store any currently playing captured transition frames.
		"active_sequence_name": "idle",                                                            # Store the current transition or idle label.
		"phase_index": 0,                                                                          # Store the current transition frame index.
		"phase_timer": 0.0,                                                                        # Store elapsed time inside the current transition frame.
		"is_transitioning": false,                                                                 # Store whether this player is in a captured transition.
		"is_turn_passthrough": false,                                                              # Store whether this player is crossing a 22/66 camera stage.
		"turn_passthrough_timer": 0.0,                                                             # Store the elapsed interpolation-frame time.
		"turn_passthrough_target": "",                                                            # Store the interpolation destination.
		"facing": start_facing,                                                                    # Store this player's camera direction.
		"turn_45_direction": 0,                                                                     # Store whether this player is stopped on a halfway turn view.
		"turn_step": 0,                                                                              # Store the current 22/45/66 interpolation stage.
		"continuous_camera_yaw": float(start_facing) * PI * 0.5,                                  # Start the free camera aligned with this player's inherited cardinal heading.
		"forward_step": 0,                                                                           # Store the current Fwd 1/Fwd 2 camera stage.
		"forward_passthrough_timer": 0.0,                                                           # Store elapsed automatic Fwd stage time.
		"forward_transition_name": "",                                                            # Store the pending cell-crossing result after Fwd 2.
		"was_manual_forward_step_pressed": false,                                                   # Store the one-shot forward-step input latch.
		"strafe_step": 0,                                                                            # Store the current Right 1/2/3 camera stage.
		"strafe_passthrough_timer": 0.0,                                                            # Store elapsed automatic side-camera stage time.
		"strafe_transition_name": "",                                                             # Store the pending left/right cell-crossing result after Right 3/1.
		"was_manual_strafe_step_pressed": false,                                                    # Store the one-shot lateral-step input latch.
		"grid_position": start_cell,                                                               # Store this player's source-map cell.
		"local_floor_position": HOME_LOCAL_FLOOR_POSITION,                                        # Store this player's position inside the current cell.
		"world_position": Vector2(float(start_cell.x) + 0.5, float(start_cell.y) + 0.5),            # Store the single authoritative capsule center in world space.
		"run_dir": DIR_N,                                                                          # Store this player's current body movement animation direction.
		"aim_dir": DIR_N,                                                                          # Store this player's current aim animation direction.
		"last_animation": &"",                                                                     # Store this player's last animation name.
		"run_animation_reversed": false,                                                           # Store whether this player currently requests a reversed forward run.
		"last_animation_reversed": false,                                                          # Store the direction of the last started playback.
		"character_is_moving": false,                                                              # Store whether this player is actively running this frame.
		"character_is_crouching": false,
		"world_run_dir": _direction_string_for_facing(start_facing),                                # Store this player's shared-world movement direction.
		"world_aim_dir": _direction_string_for_facing(start_facing),                                # Store this player's shared-world aim direction.
