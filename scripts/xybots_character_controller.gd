func _team_scoreboard_rows(team_name: String, team_score: int, team_deaths: int, members: Array[Dictionary], color: String) -> Array[String]:
	var rows: Array[String] = ["[color=%s]%-8s %5d  %6d[/color]" % [color, team_name, team_score, team_deaths], "[color=%s]---------------------[/color]" % color]
	for member_position in range(members.size()):
		if member_position > 0:
			rows.append("[font_size=2] [/font_size]")                                            # Use a half-height spacer between teammates without changing any column positions.
		var entry: Dictionary = members[member_position]
		var member_index := int(entry["player_index"])
		rows.append("[color=%s]%-8s %5d  %6d[/color]" % [color, PLAYER_NAMES[member_index], int(entry.get("kills", 0)), int(entry.get("deaths", 0))])
	return rows


func _final_scoreboard_text() -> String:
	var lawmen: Array[Dictionary] = []
	var outlaws: Array[Dictionary] = []
	var lawmen_kills := 0
	var lawmen_deaths := 0
	var outlaws_kills := 0
	var outlaws_deaths := 0
	for entry in player_states:
		var entry_index := int(entry["player_index"])
		if entry_index >= player_joined.size() or not player_joined[entry_index]:
			continue
		if PLAYER_TEAMS[entry_index] == 0:
			lawmen.append(entry)
			lawmen_kills += int(entry.get("kills", 0))
			lawmen_deaths += int(entry.get("deaths", 0))
		else:
			outlaws.append(entry)
			outlaws_kills += int(entry.get("kills", 0))
			outlaws_deaths += int(entry.get("deaths", 0))
	var winner_color := "#b31973" if lawmen_kills > outlaws_kills else ("#1b9e38" if outlaws_kills > lawmen_kills else "#f2df47")
	var rows: Array[String] = ["[font_size=24][color=#b31973]LAWMEN %d[/color]   [color=#1b9e38]OUTLAWS %d[/color][/font_size]" % [team_round_wins[0], team_round_wins[1]], "", "[color=%s]%s[/color]" % [winner_color, combat_round_result], "", "         Kills  Deaths"]
	rows.append_array(_team_scoreboard_rows("Lawmen", lawmen_kills, lawmen_deaths, lawmen, "#b31973"))
	rows.append("")
	rows.append_array(_team_scoreboard_rows("Outlaws", outlaws_kills, outlaws_deaths, outlaws, "#1b9e38"))
	rows.append("")
	rows.append("PRESS START FOR NEXT ROUND")
	for row_index in range(rows.size()):
		rows[row_index] = "[center]%s[/center]" % rows[row_index]
	return "\n".join(rows)


func _update_combat_hud() -> void:
	for player_index in range(mini(combat_health_bars.size(), player_states.size())):          # Update only the meters that have a valid player state.
		var meter := combat_health_bars[player_index]                                              # Read this player's retained hatch-bar node.
		if not is_instance_valid(meter):                                                           # Ignore a meter deleted during editor reload.
			continue                                                                                   # Continue to the next player safely.
		var view := player_views[player_index]                                                     # Read the matching split-screen viewport bundle.
		var viewport_node: Node2D = view.get("maze_viewport", null)                              # Use the same display position and scale as the camera image.
		if viewport_node != null:
			meter.position = viewport_node.position + Vector2(5.0, VIEWPORT_SIZE.y * viewport_node.scale.y - 8.0 * viewport_node.scale.y) # Keep the compact meter comfortably inside the lower-left of its camera.
			meter.scale = viewport_node.scale                                                         # Preserve integer nearest-neighbor scaling for pixel hearts.
			if player_index < combat_camera_blood_layers.size() and is_instance_valid(combat_camera_blood_layers[player_index]):
				combat_camera_blood_layers[player_index].position = viewport_node.position             # Anchor the damage overlay to this camera's logical top-left corner.
				combat_camera_blood_layers[player_index].scale = viewport_node.scale                    # Keep blob pixels registered to the same enlarged logical grid as the view below them.
		var state := player_states[player_index]                                                   # Read current combat data.
		if viewport_node != null and player_index < player_join_overlays.size():
			var join_overlay := player_join_overlays[player_index]
			join_overlay.position = viewport_node.position
			join_overlay.size = VIEWPORT_SIZE * viewport_node.scale
			join_overlay.visible = not player_joined[player_index]
			var join_label := player_join_labels[player_index]
			join_label.position = viewport_node.position + Vector2(0.0, VIEWPORT_SIZE.y * 0.5 * viewport_node.scale.y - 10.0)
			join_label.scale = viewport_node.scale
			join_label.visible = not player_joined[player_index]
			var name_label := player_name_labels[player_index]
			name_label.position = viewport_node.position + Vector2(3.0, 2.0) * viewport_node.scale
			name_label.scale = viewport_node.scale
			var input_source := "STATIC"
			if _is_human_controlled_slot(player_index):
				var device_id := _xbox_joypad_id_for_player(player_index)
				input_source = "PAD %d" % device_id if device_id >= 0 else "NO PAD"
			name_label.text = "%s:%d [%s]" % [PLAYER_NAMES[player_index], int(state.get("kills", 0)), input_source]
			var team_one_score := 0
			var team_two_score := 0
			for score_index in range(player_states.size()):
				if PLAYER_TEAMS[score_index] == 0: team_one_score += int(player_states[score_index].get("kills", 0))
				else: team_two_score += int(player_states[score_index].get("kills", 0))
			var team_label := team_score_labels[player_index]
			team_label.position = viewport_node.position + Vector2(3.0, 12.0) * viewport_node.scale
			team_label.scale = viewport_node.scale
			team_label.text = "[color=#b31973]Lawmen:%d[/color]  [color=#1b9e38]Outlaws:%d[/color]" % [team_one_score, team_two_score]
			var board := scoreboard_labels[player_index]
			var board_visible := scoreboard_player_index == player_index
			board.position = viewport_node.position + Vector2(2.0, 28.0) * viewport_node.scale
			board.scale = viewport_node.scale
			board.visible = board_visible
			var shop := scoreboard_shop_labels[player_index]
			shop.position = viewport_node.position + Vector2(60.0, VIEWPORT_SIZE.y - 12.0) * viewport_node.scale # Center the compact A/B purchase cues in the open bottom-HUD space between health and ammunition.
			shop.scale = viewport_node.scale
			shop.visible = player_index < player_joined.size() and player_joined[player_index] and not bool(state.get("is_dying", false)) and not combat_round_complete
			if shop.visible:
				var coins := int(state.get("coins", 0))
				var heart_color := "#ffffff" if coins >= 5 else "#5c5c5c"
				var gun_color := "#ffffff" if coins >= 10 else "#5c5c5c"
				shop.text = "[color=%s]A:[img=5x5]res://assets/Items/Heart/heart.png[/img][/color] [color=%s]B:[img=5x5]res://assets/Items/Gun/gun_01.png[/img][/color]" % [heart_color, gun_color] # Keep the controller cues compact while reusing the crisp heart and gun HUD art.
			if board_visible:
				var lawmen: Array[Dictionary] = []
				var outlaws: Array[Dictionary] = []
				var lawmen_deaths := 0
				var outlaws_deaths := 0
				for entry in player_states:
					var entry_index := int(entry["player_index"])
					if entry_index >= player_joined.size() or not player_joined[entry_index]:
						continue
					if PLAYER_TEAMS[entry_index] == 0:
						lawmen.append(entry)
						lawmen_deaths += int(entry.get("deaths", 0))
					else:
						outlaws.append(entry)
						outlaws_deaths += int(entry.get("deaths", 0))
				# Preserve the roster order: Bart/Hank for Lawmen and Jed/Wyatt for Outlaws.
				var rows: Array[String] = ["         Kills  Deaths"]
				rows.append_array(_team_scoreboard_rows("Lawmen", team_one_score, lawmen_deaths, lawmen, "#b31973"))
				rows.append("")
				rows.append_array(_team_scoreboard_rows("Outlaws", team_two_score, outlaws_deaths, outlaws, "#1b9e38"))
				board.text = "\n".join(rows)
		meter.set_health(int(state.get("health", PLAYER_MAX_HEALTH)), PLAYER_MAX_HEALTH)          # Redraw the requested ten-hatch health value.
		if viewport_node != null and player_index < combat_coin_icons.size() and player_index < combat_coin_labels.size(): # Position the lower-right objective UI in the same camera rectangle.
			var coin_icon := combat_coin_icons[player_index]
			var coin_label := combat_coin_labels[player_index]
			if is_instance_valid(coin_icon) and is_instance_valid(coin_label):
				coin_icon.position = viewport_node.position + Vector2((VIEWPORT_SIZE.x - 30.0) * viewport_node.scale.x, (VIEWPORT_SIZE.y - 8.0) * viewport_node.scale.y)
				coin_icon.scale = viewport_node.scale
				coin_label.position = viewport_node.position + Vector2((VIEWPORT_SIZE.x - 24.0) * viewport_node.scale.x, (VIEWPORT_SIZE.y - 11.0) * viewport_node.scale.y)
				coin_label.scale = viewport_node.scale
				coin_label.text = str(int(state.get("coins", 0)))
		if viewport_node != null and player_index < combat_ammo_icons.size() and player_index < combat_ammo_labels.size(): # Position the pickup counter at the lower center only while armed.
			var ammo_icon := combat_ammo_icons[player_index]
			var ammo_label := combat_ammo_labels[player_index]
			var rounds := int(state.get("machine_gun_ammo", 0))
			if is_instance_valid(ammo_icon) and is_instance_valid(ammo_label):
				ammo_label.position = viewport_node.position + Vector2((VIEWPORT_SIZE.x - 54.0) * viewport_node.scale.x, (VIEWPORT_SIZE.y - 11.0) * viewport_node.scale.y)
				ammo_label.scale = viewport_node.scale
				ammo_icon.position = viewport_node.position + Vector2((VIEWPORT_SIZE.x - GUN_HUD_SIZE.x - 55.0) * viewport_node.scale.x, (VIEWPORT_SIZE.y - GUN_HUD_SIZE.y - 2.0) * viewport_node.scale.y) # Put the half-size gun one logical pixel left of the ammo count and two pixels above the viewport edge.
				ammo_icon.scale = viewport_node.scale
				ammo_label.text = str(rounds)
				ammo_icon.visible = rounds > 0
				ammo_label.visible = rounds > 0
		var dying := bool(state.get("is_dying", false))                                           # Read whether this player is in the staged death sequence.
		var death_phase := String(state.get("death_phase", ""))                                  # Read the visible death stage once for both blackout and label.
		if player_index < combat_respawn_blackouts.size():                                        # Position this local player's camera-sized blackout panel.
			var blackout := combat_respawn_blackouts[player_index]                                    # Read the retained panel.
			if is_instance_valid(blackout) and viewport_node != null:
				blackout.position = viewport_node.position                                                # Align its top-left with this split-screen playfield.
				blackout.scale = viewport_node.scale                                                      # Match the playfield's exact nearest-neighbor scale.
				blackout.visible = dying and death_phase == "countdown"                                  # Black out only after forward Death finishes and before reverse Death begins.
		if player_index < combat_respawn_labels.size():                                           # Update this camera's visible death/countdown message too.
			var respawn_label := combat_respawn_labels[player_index]                                # Read the matching retained UI label.
			if is_instance_valid(respawn_label):                                                    # Avoid errors if the scene tree is rebuilt in the editor.
				if viewport_node != null:
					respawn_label.position = viewport_node.position + Vector2(0.0, 28.0 * viewport_node.scale.y) # Center the large countdown below the playfield's top edge.
					respawn_label.scale = viewport_node.scale                                           # Match the camera's exact nearest-neighbor scale.
				respawn_label.visible = dying and death_phase == "countdown"                            # Show only the requested bare 3/2/1 interval.
				if respawn_label.visible:
					var seconds_left := maxi(1, ceili(DEATH_COUNTDOWN_SECONDS - float(state.get("death_timer", 0.0)))) # Display 3, then 2, then 1.
					respawn_label.text = str(seconds_left)                                                  # Keep the presentation to the single large number.
	for player_index in range(player_views.size()):                                             # Lay the shared round UI out independently in each player's native window.
		var player_window: Window = player_views[player_index].get("player_window", get_window()) # Resolve this player's actual display surface.
		var window_size := Vector2(player_window.size)                                            # Use the native window dimensions rather than the root viewport's old split-screen area.
		if player_index < combat_round_timer_labels.size():                                      # Update this window's timer even while its player is dead or waiting.
			var timer_label := combat_round_timer_labels[player_index]
			if is_instance_valid(timer_label):
				var timer_view: Node2D = player_views[player_index].get("maze_viewport", null)
				if timer_view != null:
					timer_label.position = timer_view.position + Vector2((VIEWPORT_SIZE.x * timer_view.scale.x - timer_label.size.x * timer_view.scale.x) * 0.5, 3.0)
					timer_label.scale = timer_view.scale
				if pause_round_timer_for_debug:
					timer_label.text = "PAUSE"                                                      # Make the separately requested timer pause visible in every player's own HUD.
				elif combat_round_duration_seconds <= 0.0:
					timer_label.text = "∞"
				else:
					var displayed_seconds := maxi(0, ceili(combat_round_time_remaining))
					timer_label.text = "%d:%02d" % [displayed_seconds / 60, displayed_seconds % 60]
		if player_index < combat_round_result_labels.size():                                     # Show the same frozen result on both independent player displays.
			var result_label := combat_round_result_labels[player_index]
			if is_instance_valid(result_label):
				result_label.position = Vector2((window_size.x - result_label.size.x) * 0.5, (window_size.y - result_label.size.y) * 0.5) # Center the end-of-round message in the play screen.
				result_label.visible = false                                                          # The shared full-screen board owns the final result presentation.
	if end_round_overlay != null and end_round_scoreboard != null:
		end_round_overlay.visible = not combat_round_result.is_empty()
		if end_round_overlay.visible:
			end_round_scoreboard.text = _final_scoreboard_text()


# _is_player_fire_pressed_for: Reads a right trigger, or the keyboard fallback, for one player.
func _is_player_crouch_pressed_for(player_index: int) -> bool:
	var joypad_id := _xbox_joypad_id_for_player(player_index)
	return joypad_id >= 0 and Input.get_joy_axis(joypad_id, JOY_AXIS_TRIGGER_LEFT) >= 0.45


func _is_player_fire_pressed_for(player_index: int) -> bool:
	if _is_bot_controlled_slot(player_index):
		return bool(bot_inputs.get(player_index, {}).get("fire", false))
	var keyboard_fire: int = int([KEY_F, KEY_P, KEY_SLASH, KEY_KP_0][player_index])
	if _is_key_down(keyboard_fire):
		return true
	var action_name := ACTION_P2_FIRE if player_index == 1 else ACTION_FIRE                    # Keep each player's fallback key independent.
	if Input.is_action_pressed(action_name):                                                    # Accept the registered keyboard action first.
		return true                                                                                 # Report a held fire request.
	var joypad_id := _xbox_joypad_id_for_player(player_index)                                  # Resolve this local player's assigned Xbox controller.
	return joypad_id >= 0 and Input.get_joy_axis(joypad_id, JOY_AXIS_TRIGGER_RIGHT) >= 0.45    # Use RT as the requested controller fire control.


# _process_combat: Advances shared-world projectiles after movement and resolves all hits deterministically.
func _process_combat(delta: float) -> void:
	_advance_combat_round(delta)                                                               # Advance the one shared match clock before any pickup collection can change its score.
	for player_index in range(player_states.size()):                                            # Cool each active player and read their fire control.
		var state := player_states[player_index]                                                   # Work from the saved shared state.
		if bool(state.get("is_dying", false)):                                                   # Keep a defeated player frozen, untargetable, and unable to fire.
			player_states[player_index] = _advance_combat_death_state(state, delta)                 # Advance fall -> countdown -> reverse-respawn once per shared frame.
			continue                                                                                   # Do not process weapon cooldowns or input while this body is unavailable.
		state["fire_cooldown"] = maxf(float(state.get("fire_cooldown", 0.0)) - delta, 0.0)       # Let the deliberate pistol cadence recover.
		state["hit_timer"] = maxf(float(state.get("hit_timer", 0.0)) - delta, 0.0)               # Let the temporary hit art expire.
		player_states[player_index] = state                                                       # Save timing before potentially firing.
		if player_index == 1 and not player_two_joined:                                           # Do not let an unjoined P2 ghost fire.
			continue                                                                                   # Wait until a person joins P2.
		if float(state["fire_cooldown"]) <= 0.0 and _is_player_fire_pressed_for(player_index):  # Spawn one shot only when the pistol is ready.
			_spawn_pistol_shot(player_index)                                                         # Create a shot using the player's actual current world heading.
	_advance_barrel_loot(delta)                                                               # Move thrown loot in shared world space before testing pickup contact.
	_collect_combat_pickups(delta)                                                              # Pick up coins and the contested gun after all players have finished moving.
	var remaining_shots: Array[Dictionary] = []                                                 # Rebuild the active list so consumed shots disappear cleanly.
	for shot in active_projectiles:                                                             # Advance every live projectile once per shared frame.
		var lifetime := float(shot.get("lifetime", 0.0)) - delta                                # Decrease its maximum travel lifetime.
		if lifetime <= 0.0:                                                                        # Remove a shot that has left the playable space.
			for view_index in range(player_views.size()):
				projectile_launch_render_cache.erase("%d:%d" % [view_index, int(shot.get("id", -1))]) # Release the per-camera muzzle registration with the expired shared projectile.
			continue                                                                                   # Do not retain expired projectile data.
		var origin: Vector2 = shot["position"]                                                    # Read the current world position.
		var direction: Vector2 = shot["direction"]                                                # Read its frozen launch direction.
		var step_distance := PROJECTILE_SPEED * delta                                             # Convert the configured cells-per-second speed to this frame distance.
		var wall_distance := _nearest_projectile_wall_distance(origin, direction, step_distance) # Find the first thin-wall collision in this short path.
		var player_hit := _nearest_projectile_player_hit(int(shot["owner"]), origin, direction, step_distance, bool(shot.get("crouched", false))) # Check the target's current stance against the shot's firing stance.
		var barrel_hit := _nearest_projectile_barrel_hit(origin, direction, step_distance, float(shot.get("height", 0.72))) if bool(shot.get("crouched", false)) else {}
		var hit_distance := wall_distance                                                          # Prefer wall collision unless a player is strictly closer.
		var hit_player_index := -1                                                                 # Track whether this collision was a player.
		var hit_barrel := false
		if not player_hit.is_empty() and float(player_hit["distance"]) < hit_distance:          # A player in front of the wall takes the shot.
			hit_distance = float(player_hit["distance"])                                            # Use the nearer body collision distance.
			hit_player_index = int(player_hit["player_index"])                                     # Remember the struck player.
		if not barrel_hit.is_empty() and float(barrel_hit["distance"]) < hit_distance - PROJECTILE_WALL_EPSILON:
			hit_distance = float(barrel_hit["distance"])
			hit_player_index = -1
			hit_barrel = true
		if hit_distance <= step_distance:                                                         # Resolve any hit inside this frame's travel segment.
			var impact_position := origin + direction * maxf(hit_distance, 0.0)                     # Place the explosion exactly at the contact point.
			var wall_edge_key := _nearest_projectile_wall_edge_key(origin, direction, step_distance) if hit_player_index < 0 and not hit_barrel else ""
			var impact_height := minf(float(shot.get("height", 0.72)), BARREL_PROJECTILE_HEIGHT) if hit_barrel else float(shot.get("height", 0.72))
			_spawn_impact(impact_position, direction, hit_player_index, wall_edge_key, impact_height, hit_barrel, int(barrel_hit.get("id", -1)))
			if hit_barrel:
				_damage_barrel(int(barrel_hit["id"]), direction, impact_position, impact_height)
			if hit_player_index >= 0:                                                               # Apply damage only for body collisions.
				var target_was_dying := bool(player_states[hit_player_index].get("is_dying", false)) # Avoid treating a rejected hit against an already-defeated body as a new killing shot.
				var damage_applied := _apply_projectile_hit(hit_player_index, direction, int(shot["owner"])) # Revalidate the complete owner-to-target path before changing health or emitting a confirmed-body effect.
				if damage_applied:                                                                     # Blood belongs only to a confirmed health-changing hit, never a blocked gameplay path.
					var killing_shot := not target_was_dying and bool(player_states[hit_player_index].get("is_dying", false)) # Only the hit that actually starts death may leave persistent floor blood.
					_spawn_blood_splatter(impact_position, direction, hit_player_index, killing_shot)  # Throw blood through the struck body only after the final authority accepts the hit.
			for view_index in range(player_views.size()):
				projectile_launch_render_cache.erase("%d:%d" % [view_index, int(shot.get("id", -1))]) # The hit consumes this projectile, so its visual muzzle state must not leak to a future ID.
			continue                                                                                   # Remove the consumed projectile.
		shot["position"] = origin + direction * step_distance                                    # Move unhindered shot to its new shared world position.
		shot["lifetime"] = lifetime                                                               # Save remaining life.
		remaining_shots.append(shot)                                                              # Retain it for subsequent frames.
	active_projectiles = remaining_shots                                                        # Replace the active list after safe iteration.
	var remaining_muzzle_debug_markers: Array[Dictionary] = []                                 # Age the temporary placement snapshots independently of projectile impacts.
	for marker in muzzle_anchor_debug_markers:
		marker["timer"] = float(marker.get("timer", 0.0)) - delta                              # Let both crosses remain readable for a short fixed interval after firing.
		if float(marker["timer"]) > 0.0:
			remaining_muzzle_debug_markers.append(marker)                                            # Keep only live debug snapshots; they have no gameplay authority.
	muzzle_anchor_debug_markers = remaining_muzzle_debug_markers                                # Replace the small retained diagnostic list without touching projectile simulation.
	active_projectile_trails.clear()                                                            # Remove the former persistent smoke-particle path; the compact tracer now belongs wholly to its live projectile.
	var remaining_blood_splatters: Array[Dictionary] = []                                      # Advance one-pixel character-hit droplets until their first wall/floor contact, then hold them as stuck marks.
	for blood in active_blood_splatters:
		var persistent_killing_shot_mark := bool(blood.get("persistent_killing_shot", false)) and bool(blood.get("stuck", false)) # Keep every surface mark from a killing shot through that victim's blackout countdown.
		if not persistent_killing_shot_mark:
			blood["timer"] = float(blood.get("timer", 0.0)) - delta                              # Age flying drops and ordinary wall/floor marks with their short visual lifetime.
			if float(blood["timer"]) <= 0.0:
				continue                                                                               # Remove transient blood only after its landing mark has had time to read.
		if not bool(blood.get("stuck", false)):
			var horizontal_velocity: Vector2 = blood.get("horizontal_velocity", Vector2.ZERO)      # Preserve the blood spray's mostly bullet-forward direction plus small side variation.
			var horizontal_distance := horizontal_velocity.length() * delta                          # Limit the wall query to this exact physics tick so a droplet cannot tunnel through thin maze edges.
			if horizontal_distance > 0.000001:
				var horizontal_direction := horizontal_velocity.normalized()                            # Raycast in the actual spray direction rather than assuming the original bullet direction.
				var wall_distance := _nearest_projectile_wall_distance(Vector2(blood.get("position", Vector2.ZERO)), horizontal_direction, horizontal_distance) # Find the first wall surface touched by this droplet.
				if wall_distance <= horizontal_distance:
					blood["position"] = Vector2(blood.get("position", Vector2.ZERO)) + horizontal_direction * maxf(wall_distance, 0.0) # Register the droplet on the exact wall contact point.
					blood["stuck"] = true                                                               # Blood never bounces; the first wall surface permanently captures it.
					blood["stuck_surface"] = "wall"                                                    # Retain wall-only layering metadata for the render pass.
					blood["wall_edge_key"] = _nearest_projectile_wall_edge_key(Vector2(blood.get("position", Vector2.ZERO)) - horizontal_direction * 0.001, horizontal_direction, 0.01) # Retain the touched front face when the visual wall lookup can resolve it.
					blood["timer"] = INF if bool(blood.get("persistent_killing_shot", false)) else BLOOD_SPLATTER_STUCK_LIFETIME # A killing shot's wall drops remain until respawn begins; every other wall mark retains the normal one-second lifetime.
				else:
					blood["position"] = Vector2(blood.get("position", Vector2.ZERO)) + horizontal_velocity * delta # Continue the flying spray only while it remains in open world space.
			var vertical_velocity := float(blood.get("vertical_velocity", 0.0)) - BLOOD_SPLATTER_GRAVITY * delta # Pull blood down in a compact arc, without a bounce impulse.
			var height := float(blood.get("height", 0.72)) + vertical_velocity * delta              # Advance the droplet toward the visible projected floor.
			if height <= 0.0:
				height = 0.0                                                                             # Clamp at the floor exactly once.
				blood["stuck"] = true                                                                   # The floor captures blood immediately; it does not rebound like wood debris.
				blood["stuck_surface"] = "floor"                                                       # Render this landed one-pixel mark at the floor anchor.
				blood["timer"] = INF if bool(blood.get("persistent_killing_shot", false)) else BLOOD_SPLATTER_STUCK_LIFETIME # A killing shot's floor drops remain until respawn begins; every other landing retains the normal one-second mark lifetime.
				vertical_velocity = 0.0                                                                  # Prevent any later motion after floor contact.
			blood["vertical_velocity"] = vertical_velocity                                            # Preserve the falling arc until a surface captures it.
			blood["height"] = height                                                                  # Preserve the final floor height or current airborne height.
		var visual_step_timer := float(blood.get("visual_step_timer", 0.0)) - delta                # Give the visible blood arc the same stepped cadence as smoke and splinters.
		if visual_step_timer <= 0.0:
			blood["display_position"] = blood["position"]                                           # Capture one world position for the full rendered pixel-animation frame.
			blood["display_height"] = blood["height"]                                               # Capture matching vertical movement for the stepped arc.
			visual_step_timer = BLOOD_SPLATTER_VISUAL_FRAME_DURATION                                 # Hold this visible sample until the next effect frame.
		blood["visual_step_timer"] = visual_step_timer                                            # Preserve the shared per-droplet visible-frame clock.
		remaining_blood_splatters.append(blood)                                                    # Retain flying and stuck droplets until their individual timers expire.
	active_blood_splatters = remaining_blood_splatters                                          # Drop expired blood marks only after simulation and rendering have both completed.
	var remaining_wall_debris: Array[Dictionary] = []                                          # Advance square splinters through their shared world-space arc and one bounce.
	for debris in active_wall_debris:
		debris["timer"] = float(debris.get("timer", 0.0)) - delta                                # Let settled chunks fade out after the short requested effect lifetime.
		if float(debris["timer"]) <= 0.0:
			for player_index in range(player_views.size()):
				wall_debris_color_cache.erase("%d:%d" % [player_index, int(debris.get("id", -1))]) # Discard both split-screen palette entries as soon as this short-lived splinter expires.
				wall_debris_render_cache.erase("%d:%d" % [player_index, int(debris.get("id", -1))]) # Discard the corresponding stepped projection/visibility entries with the expired particle.
			continue                                                                                   # Remove particles only after their full arc/rest presentation has completed.
		if bool(debris.get("settled", false)):
			var settled_visual_step_timer := float(debris.get("visual_step_timer", 0.0)) - delta   # Continue ticking the visual frame while fading a resting splinter, so its final alpha remains intentionally stepped too.
			if settled_visual_step_timer <= 0.0:
				debris["visual_frame"] = int(debris.get("visual_frame", 0)) + 1                        # Invalidate the cached screen result only at the established visual cadence.
				settled_visual_step_timer = float(debris.get("visual_frame_duration", 1.0 / WALL_DEBRIS_NEAR_VISUAL_FPS)) # Retain the per-impact LOD cadence while a resting chunk fades.
			debris["visual_step_timer"] = settled_visual_step_timer
			remaining_wall_debris.append(debris)                                                        # Hold the chunk visibly on the floor while its short grounded fade timer expires.
			continue                                                                                   # Do not move or apply gravity after the second floor contact.
		var horizontal_velocity: Vector2 = debris.get("horizontal_velocity", Vector2.ZERO)       # Read the direction away from the struck wall plus the small splinter spread.
		debris["position"] = Vector2(debris.get("position", Vector2.ZERO)) + horizontal_velocity * delta # Advance the chunk away from the physical impact point in shared maze space.
		debris["rotation"] = float(debris.get("rotation", 0.0)) + float(debris.get("angular_velocity", 0.0)) * delta # Spin the square chunk while it is airborne or bouncing.
		var vertical_velocity := float(debris.get("vertical_velocity", 0.0)) - WALL_DEBRIS_GRAVITY * delta # Apply a simple visual gravity to the chunk's screen-height state.
		var height := float(debris.get("height", 0.0)) + vertical_velocity * delta                # Advance its height above the projected floor.
		if height <= 0.0:
			height = 0.0                                                                             # Keep the chunk on the floor after contact instead of letting it sink below it.
			var remaining_bounces := int(debris.get("remaining_bounces", 0))                        # Near/far impact LOD selects how many floor rebounds this shared splinter is allowed to simulate.
			if remaining_bounces > 0:
				vertical_velocity = absf(vertical_velocity) * WALL_DEBRIS_BOUNCE                        # Bounce once with visibly reduced energy.
				debris["remaining_bounces"] = remaining_bounces - 1                                    # Consume one authored bounce; far LOD begins at zero and settles on its first floor contact.
				debris["horizontal_velocity"] = horizontal_velocity * 0.42                             # Lose most lateral energy on the floor impact so the chunk comes to rest.
				debris["angular_velocity"] = float(debris.get("angular_velocity", 0.0)) * 0.38        # Let the first bounce bleed most of the spin energy too.
			else:
				vertical_velocity = 0.0                                                                 # Hold the chunk at rest until its fade timer expires.
				debris["horizontal_velocity"] = Vector2.ZERO                                            # Stop the chunk at its visible floor contact instead of letting it fade while still sliding.
				debris["angular_velocity"] = 0.0                                                        # Leave the square at its final landed rotation during its grounded fade.
				debris["settled"] = true                                                                # Begin the explicit grounded-rest phase after the one allowed bounce.
				debris["timer"] = float(debris.get("ground_fade_seconds", WALL_DEBRIS_NEAR_GROUND_FADE_SECONDS)) # Near chunks linger after landing; far LOD uses zero so it disappears on this settled frame.
		debris["vertical_velocity"] = vertical_velocity                                            # Save the current upward/downward arc velocity.
		debris["height"] = height                                                                  # Save the current height above the projected floor.
		var visual_step_timer := float(debris.get("visual_step_timer", 0.0)) - delta              # Count down independently of physics so the rendered chunk has a deliberate low-frame-rate cadence.
		if visual_step_timer <= 0.0:
			debris["display_position"] = debris["position"]                                         # Capture one shared-world position for this whole visible pixel-animation frame.
			debris["display_height"] = height                                                        # Capture the matching arc height so falling is stepped along with horizontal travel.
			debris["visual_frame"] = int(debris.get("visual_frame", 0)) + 1                        # Invalidate the cached per-camera projection only when this visible pixel-animation sample changes.
			visual_step_timer = float(debris.get("visual_frame_duration", 1.0 / WALL_DEBRIS_NEAR_VISUAL_FPS)) # Hold far LOD samples at their cheaper cadence without changing close-impact motion.
		debris["visual_step_timer"] = visual_step_timer                                            # Preserve the visible-frame clock without compromising continuous collision-free physics.
		remaining_wall_debris.append(debris)                                                        # Retain the active or resting chunk for both player views.
	active_wall_debris = remaining_wall_debris                                                  # Drop only chunks whose effect lifetime has expired.
	var remaining_wall_bullet_holes: Array[Dictionary] = []                                    # Age wall decals separately from the short debris movement.
	for hole in active_wall_bullet_holes:
		hole["timer"] = float(hole.get("timer", 0.0)) - delta                                    # Count down the retained black impact mark.
		if float(hole["timer"]) > 0.0:
			remaining_wall_bullet_holes.append(hole)                                                   # Keep the decal visible until its independent lifetime completes.
	active_wall_bullet_holes = remaining_wall_bullet_holes                                     # Remove expired wall marks.
	var remaining_wall_impact_smokes: Array[Dictionary] = []                                  # Advance each compact wall-dust card independently of muzzle smoke.
	for smoke in active_wall_impact_smokes:
		smoke["timer"] = float(smoke.get("timer", 0.0)) - delta                                  # Age the individual dust card from dense contact debris into transparency.
		if float(smoke["timer"]) > 0.0:
			var elapsed := WALL_IMPACT_SMOKE_LIFETIME - float(smoke["timer"])                      # Use elapsed life for a stable restrained dust drift.
			var velocity: Vector2 = smoke.get("velocity", Vector2.ZERO)                            # Read the short push away from the struck wall.
			velocity += Vector2(smoke.get("turbulence", Vector2.ZERO)) * sin(elapsed * 8.0 + float(smoke.get("id", 0))) * delta # Add a tiny individual billow rather than moving every card identically.
			velocity *= 1.0 - minf(delta * 1.6, 0.22)                                                # Let impact dust quickly lose its explosive momentum.
			smoke["velocity"] = velocity
			smoke["position"] = Vector2(smoke.get("position", Vector2.ZERO)) + velocity * delta  # Keep all card motion in shared world space.
			var vertical_velocity := float(smoke.get("vertical_velocity", 0.0)) * (1.0 - minf(delta * 1.6, 0.22)) # Let the independent vertical burst dissipate with the same restrained air drag as its planar motion.
			smoke["vertical_velocity"] = vertical_velocity
			smoke["height"] = clampf(float(smoke.get("height", 0.0)) + vertical_velocity * delta, -0.30, 0.48) # Allow cards to rise above or dip below the contact point without leaving the small impact volume.
			smoke["rotation"] = float(smoke.get("rotation", 0.0)) + float(smoke.get("angular_velocity", 0.0)) * delta # Let each card turn independently like loose dust.
			var visual_step_timer := float(smoke.get("visual_step_timer", 0.0)) - delta
			if visual_step_timer <= 0.0:
				smoke["display_position"] = smoke["position"]
				smoke["display_height"] = smoke["height"]                                             # Keep vertical burst motion on the same deliberate visual cadence as horizontal drift.
				smoke["display_rotation"] = snappedf(float(smoke["rotation"]), MUZZLE_SMOKE_ROTATION_INCREMENT) # Retain the smoke system's clean pixel-grid quarter turns.
				smoke["visual_frame"] = int(smoke.get("visual_frame", 0)) + 1                         # Invalidate the cached appearance and visibility when the stepped burst sample changes.
				visual_step_timer = MUZZLE_SMOKE_VISUAL_FRAME_DURATION
			smoke["visual_step_timer"] = visual_step_timer
			remaining_wall_impact_smokes.append(smoke)                                                # Retain only wall-contact clouds with visible frames remaining.
		else:
			for player_index in range(player_views.size()):
				wall_impact_smoke_render_cache.erase("%d:%d" % [player_index, int(smoke.get("id", -1))]) # Release both per-camera render states with the expired short-lived impact card.
	active_wall_impact_smokes = remaining_wall_impact_smokes                                   # Drop the completed cloud event after its authored animation duration.
	var remaining_muzzle_smoke_particles: Array[Dictionary] = []                               # Advance the shared-world black-powder puffs independently from the projectile.
	for particle in active_muzzle_smoke_particles:
		particle["timer"] = float(particle.get("timer", 0.0)) - delta                            # Age the puff from opaque fresh smoke into transparent dissipated smoke.
		if float(particle["timer"]) <= 0.0:
			for player_index in range(player_views.size()):
				muzzle_smoke_render_cache.erase("%d:%d" % [player_index, int(particle.get("id", -1))]) # Release the per-view render states as soon as the puff dissipates.
			continue                                                                                   # Release only particles whose individual billow lifetime has completed.
		var elapsed := float(particle.get("lifetime", 0.0)) - float(particle["timer"])           # Use elapsed life as a stable phase for the preselected turbulence direction.
		var velocity: Vector2 = particle.get("velocity", Vector2.ZERO)                           # Read the initial sideward blast plus its evolving airy drift.
		var turbulence: Vector2 = particle.get("turbulence", Vector2.ZERO)                       # Reuse a per-puff random direction so the cloud has variety without noisy frame-to-frame randomness.
		velocity += turbulence * sin(elapsed * 8.0 + float(particle.get("id", 0))) * delta        # Nudge every puff through a very subtle billow instead of a straight mathematical line.
		velocity *= 1.0 - minf(delta * 0.70, 0.18)                                                 # Bleed the explosive launch speed away as black-powder smoke disperses.
		particle["velocity"] = velocity                                                            # Preserve the softened motion for the next shared physics tick.
		particle["position"] = Vector2(particle.get("position", Vector2.ZERO)) + velocity * delta # Move most puffs sideways from the barrel, with the small turbulent curl layered on top.
		particle["height"] = clampf(float(particle.get("height", 0.5)) + float(particle.get("vertical_velocity", 0.0)) * delta, MUZZLE_SMOKE_MIN_HEIGHT, float(particle.get("max_height", MUZZLE_SMOKE_MIN_HEIGHT))) # Limit rise relative to this puff's muzzle-height start while keeping it above the floor.
		particle["rotation"] = float(particle.get("rotation", 0.0)) + float(particle.get("angular_velocity", 0.0)) * delta # Advance a unique turbulent spin under the held pixel-animation frame.
		particle["angular_velocity"] = float(particle.get("angular_velocity", 0.0)) * (1.0 - minf(delta * 0.55, 0.12)) # Let rotation gradually settle as the powder loses its explosive energy.
		var visual_step_timer := float(particle.get("visual_step_timer", 0.0)) - delta            # Hold each screen-visible smoke state for a complete low-frame-rate pixel-animation frame.
		if visual_step_timer <= 0.0:
			particle["display_position"] = particle["position"]                                    # Capture the current billow position rather than rendering every sub-pixel physics update.
			particle["display_height"] = particle["height"]                                        # Keep vertical drift stepped with horizontal smoke motion.
			particle["display_rotation"] = snappedf(float(particle["rotation"]), MUZZLE_SMOKE_ROTATION_INCREMENT) # Display only quarter-turn rotation steps so turbulence never produces filtered diagonal smoke pixels.
			particle["visual_frame"] = int(particle.get("visual_frame", 0)) + 1                   # Invalidate this puff's per-camera render result only as its visible pixel-animation sample advances.
			visual_step_timer = MUZZLE_SMOKE_VISUAL_FRAME_DURATION                                   # Begin the next visible hold interval.
		particle["visual_step_timer"] = visual_step_timer                                         # Retain the per-puff visible-frame clock.
		remaining_muzzle_smoke_particles.append(particle)                                          # Keep this drifting puff for both local views.
	active_muzzle_smoke_particles = remaining_muzzle_smoke_particles                            # Drop only fully dissipated puffs.
	_update_combat_hud()                                                                        # Refresh health fills and their split-screen placement.


# _spawn_pistol_shot: Creates one infinite-ammo pistol bullet from a point just ahead of the real player gun.
func _spawn_pistol_shot(player_index: int) -> void:
	var state := player_states[player_index]                                                    # Read the completed movement state.
	var direction := _view_forward_vector_for_state(state).normalized()                         # Shoot directly along the visible camera/player aim heading.
	var dual_wield_rounds := int(state.get("machine_gun_ammo", 0))                             # Read the optional dual-pistol powerup state once before choosing this shot's muzzle.
	var crouched := bool(state.get("character_is_crouching", false))
	var dual_wield_barrel_sign := 0.0                                                           # Retain the chosen muzzle side so the local screen-space effect can avoid applying a second offset to the right pistol.
	var muzzle_hand: StringName = &"right"                                                     # Normal single-pistol animations use their right/default authored muzzle.
	var body_origin := _player_state_world_position(state)                                      # Keep the simulation rooted at the player's actual collision center, never beyond a wall.
	if dual_wield_rounds > 0:
		var muzzle_side := Vector2(-direction.y, direction.x)                                     # Build a horizontal perpendicular so the two pistols fire from opposite sides of the body.
		var barrel_sign := -1.0 if dual_wield_rounds % 2 == 0 else 1.0                           # Alternate left and right muzzle origins deterministically across all twelve remaining-round values.
		dual_wield_barrel_sign = barrel_sign                                                       # Carry this exact side through to the screen-space shot effect.
		var firing_sprite: AnimatedSprite2D = player_views[player_index].get("player_sprite", null)
		var dual_crouch_art := firing_sprite != null and (String(firing_sprite.animation).begins_with("CrouchWalkDualRight") or String(firing_sprite.animation).begins_with("CrouchWalkDualLeft") or String(firing_sprite.animation).begins_with("CrouchWalkDual") or String(firing_sprite.animation).begins_with("CrouchIdleDual"))
		muzzle_hand = &"left" if barrel_sign < 0.0 and (not crouched or dual_crouch_art) else &"right" # Single-pistol crouch poses still use their one visible gun.
		var muzzle_side_distance := 0.12 if barrel_sign < 0.0 else 0.04                           # Match the authored pose: the right pistol sits much nearer the body center than the left pistol.
		body_origin += muzzle_side * muzzle_side_distance * barrel_sign                           # Offset only the visible/simulated muzzle; the player's collision center remains unchanged.
	var authored_muzzle := _world_muzzle_anchor(player_index, _player_state_world_position(state), direction, muzzle_hand) # Resolve the selected pixel once into the shared map, never into one camera's screen space.
	if _character_has_muzzle_anchor(player_views[player_index].get("player_sprite", null), muzzle_hand):
		body_origin = authored_muzzle.get("position", body_origin)                                # Authored anchor replaces the heuristic left/right body offset when available.
	var muzzle_height := float(authored_muzzle.get("height", 0.72))                            # Carry the PNG vertical location as real raised-effect height for every camera.
	var projectile_height := maxf(muzzle_height - CROUCH_PROJECTILE_HEIGHT_OFFSET, 0.0) if crouched else muzzle_height # Aim down from the authored muzzle over the existing body-to-projectile launch distance.
	var desired_muzzle_distance := 0.34                                                          # Preserve the authored visual separation between body and pistol muzzle when the lane is clear.
	var muzzle_wall_distance := _nearest_projectile_wall_distance(body_origin, direction, desired_muzzle_distance) # Check the short body-to-muzzle segment before placing the bullet.
	if crouched:
		var near_barrel := _nearest_projectile_barrel_hit(body_origin, direction, desired_muzzle_distance, projectile_height)
		if not near_barrel.is_empty():
			muzzle_wall_distance = minf(muzzle_wall_distance, float(near_barrel["distance"]))
	var muzzle_distance := minf(desired_muzzle_distance, maxf(muzzle_wall_distance - PROJECTILE_WALL_EPSILON, 0.0)) # Clamp the muzzle just in front of a wall instead of spawning a shot on its far side.
	var origin := body_origin + direction * muzzle_distance                                      # Start the projectile at the safe, wall-bounded muzzle point.
	var smoke_origin := body_origin + direction * minf(muzzle_distance, .2)                    # Anchor smoke halfway down the gameplay muzzle segment so it reads at the visible raised barrel rather than in front of the projectile.
	var maximum_distance := PROJECTILE_SPEED * PROJECTILE_LIFETIME                               # Determine a stable visual end point for the complete projectile lifetime.
	var wall_distance := minf(_nearest_projectile_wall_distance(origin, direction, maximum_distance), maximum_distance) # Stop the planned visual path at the first static wall, or at max range.
	var player_hit := _nearest_projectile_player_hit(player_index, origin, direction, maximum_distance, crouched) # Predict only players this shot can actually strike.
	var barrel_hit := _nearest_projectile_barrel_hit(origin, direction, maximum_distance, projectile_height) if crouched else {}
	var visual_distance := wall_distance                                                           # Prefer the wall endpoint unless a body is closer.
	var visual_target_player_index := -1                                                         # Preserve a direct incoming-shot relationship for per-camera visibility without changing collision.
	if not player_hit.is_empty() and float(player_hit.get("distance", maximum_distance)) < visual_distance:
		visual_distance = float(player_hit["distance"])                                            # End at the nearer target body.
		visual_target_player_index = int(player_hit.get("player_index", -1))                       # Record the player actually lying at the selected visual/collision endpoint.
	if not barrel_hit.is_empty() and float(barrel_hit["distance"]) < visual_distance - PROJECTILE_WALL_EPSILON:
		visual_distance = float(barrel_hit["distance"])
		visual_target_player_index = -1
	_spawn_muzzle_smoke_particles(smoke_origin, direction, player_index, dual_wield_barrel_sign, muzzle_hand, muzzle_height) # Emit shared-world black-powder smoke from the same authored map point.
	var shot := {"id": next_combat_visual_id, "owner": player_index, "position": origin, "spawn_position": origin, "authored_muzzle_position": body_origin, "muzzle_height": muzzle_height, "visual_target_position": origin + direction * visual_distance, "visual_target_player_index": visual_target_player_index, "visual_total_distance": maxf(visual_distance, 0.001), "last_trail_distance": 0.0, "direction": direction, "height": projectile_height, "dual_wield_barrel_sign": dual_wield_barrel_sign, "muzzle_hand": muzzle_hand, "lifetime": PROJECTILE_LIFETIME} # Store one fixed start/end pair and its selected muzzle side so the rendered particle travels in a single straight line.
	shot["crouched"] = crouched
	next_combat_visual_id += 1                                                                  # Reserve the next unique visual key.
	active_projectiles.append(shot)                                                            # Add it to shared world simulation.
	if show_muzzle_anchor_debug:
		muzzle_anchor_debug_markers.append({"id": int(shot["id"]), "owner": player_index, "authored_muzzle_position": body_origin, "muzzle_height": muzzle_height, "muzzle_hand": muzzle_hand, "timer": MUZZLE_ANCHOR_DEBUG_LINGER_SECONDS}) # Snapshot the spawned shared muzzle so both camera comparisons remain visible after the shot itself is gone.
	if gunshot_player != null:
		gunshot_player.pitch_scale = randf_range(0.78, 1.22)
		gunshot_player.play()
	if dual_wield_rounds > 0:                                                                   # Consume one alternating pistol round only while the dual-wield pickup remains armed.
		var remaining_rounds := dual_wield_rounds - 1                                             # Spend one round while retaining the exact amount for a later dropped pickup.
		state["machine_gun_ammo"] = remaining_rounds
		state["fire_cooldown"] = DUAL_WIELD_FIRE_INTERVAL                                        # Apply the requested twice-normal cadence while alternating the two pistol muzzle origins.
		if remaining_rounds <= 0:
			machine_gun_respawn_timer = MACHINE_GUN_RESPAWN_SECONDS                                # Respawn a fresh contested gun only after the current magazine is exhausted.
	else:
		state["fire_cooldown"] = PISTOL_FIRE_INTERVAL                                            # Keep the regular pistol infinite-ammo and deliberately slower.
	player_states[player_index] = state                                                        # Save the armed cooldown.


# _spawn_muzzle_smoke_particles: Emits a wide, opaque black-powder cloud from the visible fired barrel without using the authored muzzle-smoke sheets.
func _spawn_muzzle_smoke_particles(smoke_origin: Vector2, direction: Vector2, owner: int, dual_wield_barrel_sign: float, muzzle_hand: StringName, muzzle_height: float) -> void:
	var lateral := Vector2(-direction.y, direction.x)                                          # Build the visible left/right emission axis perpendicular to the barrel direction.
	for particle_index in range(MUZZLE_SMOKE_PARTICLE_COUNT):
		var lateral_sign := -1.0 if randf() < 0.5 else 1.0                                       # Throw equal groups to either side so the antique powder burst blooms sideways from the barrel.
		var lateral_velocity := lateral * lateral_sign * randf_range(MUZZLE_SMOKE_LATERAL_SPEED_MIN, MUZZLE_SMOKE_LATERAL_SPEED_MAX) # Keep the sideward burst close to the barrel.
		var forward_velocity := direction * randf_range(MUZZLE_SMOKE_FORWARD_SPEED_MIN, MUZZLE_SMOKE_FORWARD_SPEED_MAX) # Control the forward burst independently of sideways drift.
		var lifetime := randf_range(MUZZLE_SMOKE_LIFETIME_MIN, MUZZLE_SMOKE_LIFETIME_MAX)        # Let each puff thin at a different time around the cloud's edge.
		var base_scale := randf_range(MUZZLE_SMOKE_CARD_SCALE_MIN, MUZZLE_SMOKE_CARD_SCALE_MAX)  # Vary puffs through the named card-scale range beside the rest of the muzzle-smoke tuning controls.
		var initial_position := smoke_origin + lateral * randf_range(-MUZZLE_SMOKE_SPAWN_LATERAL_SPREAD, MUZZLE_SMOKE_SPAWN_LATERAL_SPREAD) # Start tightly at the barrel.
		var initial_height := muzzle_height + randf_range(-MUZZLE_SMOKE_SPAWN_HEIGHT_SPREAD, MUZZLE_SMOKE_SPAWN_HEIGHT_SPREAD) # Vary each puff around the authored barrel height.
		var smoke_tone := randf_range(MUZZLE_SMOKE_TONE_MIN, MUZZLE_SMOKE_TONE_MAX)               # Mix soft grey outer puffs through thick white powder without an image texture.
		var initial_rotation := float(randi() % 4) * MUZZLE_SMOKE_ROTATION_INCREMENT              # Begin every irregular puff on a clean but varied quarter-turn orientation.
		active_muzzle_smoke_particles.append({"id": next_combat_visual_id, "position": initial_position, "display_position": initial_position, "velocity": lateral_velocity + forward_velocity, "turbulence": Vector2(randf_range(-MUZZLE_SMOKE_TURBULENCE, MUZZLE_SMOKE_TURBULENCE), randf_range(-MUZZLE_SMOKE_TURBULENCE, MUZZLE_SMOKE_TURBULENCE)), "height": initial_height, "display_height": initial_height, "max_height": maxf(initial_height, MUZZLE_SMOKE_MIN_HEIGHT) + maxf(MUZZLE_SMOKE_MAX_RISE, 0.0), "vertical_velocity": randf_range(MUZZLE_SMOKE_VERTICAL_SPEED_MIN, MUZZLE_SMOKE_VERTICAL_SPEED_MAX), "rotation": initial_rotation, "display_rotation": initial_rotation, "angular_velocity": randf_range(-MUZZLE_SMOKE_ANGULAR_SPEED_MAX, MUZZLE_SMOKE_ANGULAR_SPEED_MAX), "visual_step_timer": MUZZLE_SMOKE_VISUAL_FRAME_DURATION, "visual_frame": 0, "base_scale": base_scale, "cloud_variant": randi() % MUZZLE_SMOKE_CLOUD_VARIANTS, "tone": smoke_tone, "opacity": randf_range(MUZZLE_SMOKE_OPACITY_MIN, MUZZLE_SMOKE_OPACITY_MAX), "lifetime": lifetime, "timer": lifetime, "owner": owner, "dual_wield_barrel_sign": dual_wield_barrel_sign, "muzzle_hand": muzzle_hand}) # Keep each separately rotating irregular puff in shared world coordinates for the same result in both player views.
		next_combat_visual_id += 1                                                               # Reserve an independent cached Sprite2D for this one procedural puff.


# _nearest_projectile_wall_distance: Finds the first physical maze edge struck inside one projectile segment.
func _nearest_projectile_wall_distance(origin: Vector2, direction: Vector2, maximum_distance: float) -> float:
	var nearest := maximum_distance + 1.0                                                       # Keep a clear-path sentinel safely beyond player-hit contact tolerance.
	for edge in _all_physical_wall_edges():                                                    # Reuse the authoritative thin-wall collision geometry.
		var distance := _ray_segment_hit_distance_limited(origin, direction, Vector2(edge["a"]), Vector2(edge["b"]), maximum_distance) # Test the short segment.
		if distance >= 0.0 and distance < nearest:                                                # Retain the closest edge only.
			nearest = distance                                                                        # Update the nearest contact.
	var topology_distance := _projectile_topology_wall_distance(origin, direction, maximum_distance) # Cross-check against the movement map's exact cell-edge ownership.
	nearest = minf(nearest, topology_distance)                                                  # Let either representation block the shot; topology closes endpoint/parallel-ray gaps.
	return nearest                                                                              # Return greater than max when this path is clear.


# _nearest_projectile_wall_edge_key: Identifies the physical edge selected by a wall impact.
# The regular distance query also has a topology fallback for boundary robustness; this
# key is visual metadata only, so an absent key simply uses the impact's point layer.
func _nearest_projectile_wall_edge_key(origin: Vector2, direction: Vector2, maximum_distance: float) -> String:
	var nearest := maximum_distance + PROJECTILE_WALL_EPSILON                                  # Keep a clear-path sentinel beyond this frame's collision segment.
	var nearest_key := ""                                                                       # Preserve the canonical edge key for the closest physical hit.
	for edge in _all_physical_wall_edges():                                                     # Match the same authoritative thin-wall geometry used by the projectile.
		var distance := _ray_segment_hit_distance_limited(origin, direction, Vector2(edge["a"]), Vector2(edge["b"]), maximum_distance) # Test this candidate wall segment.
		if distance >= 0.0 and distance < nearest:                                                # Retain the first surface struck by this projectile step.
			nearest = distance                                                                        # Save its contact distance.
			nearest_key = String(edge["key"])                                                       # Carry its stable key into the short-lived impact visual.
	return nearest_key                                                                          # Empty means only the topology fallback found the collision.


# _projectile_topology_wall_distance: Walks the ray through maze cells so projectile blocking uses the same edge ownership as movement.
func _projectile_topology_wall_distance(origin: Vector2, direction: Vector2, maximum_distance: float) -> float:
	if maximum_distance <= 0.0 or direction.length_squared() <= 0.000001:                     # Avoid invalid DDA state for zero-length paths.
		return maximum_distance + 1.0                                                             # Treat an empty path as clear.
	var ray_direction := direction.normalized()                                                 # Make DDA distances world-unit distances.
	var sample_origin := origin + ray_direction * 0.0001                                       # Bias inside the forward cell so a muzzle on an edge does not start ambiguously behind it.
	var cell := Vector2i(floori(sample_origin.x), floori(sample_origin.y))                    # Identify the first movement cell traversed by the projectile.
	if not _is_open_cell(cell):                                                                 # A shot starting outside the maze cannot enter through its boundary.
		return 0.0                                                                                # Block immediately at the map boundary.
	var step_x := signi(ray_direction.x)                                                        # Record which vertical grid boundaries the ray crosses.
	var step_y := signi(ray_direction.y)                                                        # Record which horizontal grid boundaries the ray crosses.
	var t_delta_x := absf(1.0 / ray_direction.x) if step_x != 0 else INF                       # Measure distance between successive vertical crossings.
	var t_delta_y := absf(1.0 / ray_direction.y) if step_y != 0 else INF                       # Measure distance between successive horizontal crossings.
	var boundary_x := float(cell.x + 1) if step_x > 0 else float(cell.x)                       # Choose the first vertical boundary in the ray direction.
	var boundary_y := float(cell.y + 1) if step_y > 0 else float(cell.y)                       # Choose the first horizontal boundary in the ray direction.
	var t_max_x := (boundary_x - sample_origin.x) / ray_direction.x if step_x != 0 else INF    # Find distance to the first vertical crossing.
	var t_max_y := (boundary_y - sample_origin.y) / ray_direction.y if step_y != 0 else INF    # Find distance to the first horizontal crossing.
	while minf(t_max_x, t_max_y) <= maximum_distance + PROJECTILE_WALL_EPSILON:                # Visit every cell edge crossed inside this projectile segment.
		if absf(t_max_x - t_max_y) <= PROJECTILE_WALL_EPSILON:                                   # A corner crossing touches both cell edges at the same instant.
			var diagonal_distance := maxf(0.0, t_max_x + 0.0001)                                   # Convert the biased DDA distance back to a non-negative projectile distance.
			if _has_wall_edge(cell, Vector2i(step_x, 0)) or _has_wall_edge(cell, Vector2i(0, step_y)): # A solid edge on either corner branch blocks the diagonal shot.
				return diagonal_distance                                                               # Stop at the first blocked corner contact.
			cell += Vector2i(step_x, step_y)                                                        # Advance through the open diagonal corner.
			t_max_x += t_delta_x                                                                    # Schedule the next vertical crossing.
			t_max_y += t_delta_y                                                                    # Schedule the next horizontal crossing.
		elif t_max_x < t_max_y:                                                                   # The ray next crosses a vertical cell edge.
			var horizontal_distance := maxf(0.0, t_max_x + 0.0001)                                 # Convert its DDA distance into projectile distance.
			var horizontal_delta := Vector2i(step_x, 0)                                             # Express the crossed edge in movement-map coordinates.
			if _has_wall_edge(cell, horizontal_delta):                                              # Use the same wall table as player movement.
				return horizontal_distance                                                             # Stop at the first blocking vertical edge.
			cell += horizontal_delta                                                                # Enter the next open cell.
			t_max_x += t_delta_x                                                                    # Schedule the following vertical crossing.
		else:                                                                                     # The ray next crosses a horizontal cell edge.
			var vertical_distance := maxf(0.0, t_max_y + 0.0001)                                   # Convert its DDA distance into projectile distance.
			var vertical_delta := Vector2i(0, step_y)                                               # Express the crossed edge in movement-map coordinates.
			if _has_wall_edge(cell, vertical_delta):                                                # Use the same wall table as player movement.
				return vertical_distance                                                               # Stop at the first blocking horizontal edge.
			cell += vertical_delta                                                                  # Enter the next open cell.
			t_max_y += t_delta_y                                                                    # Schedule the following horizontal crossing.
	return maximum_distance + 1.0                                                              # No blocking movement edge lies along this projectile segment.


# _ray_segment_hit_distance_limited: Variant of the visibility ray helper without its camera-distance cap.
func _ray_segment_hit_distance_limited(origin: Vector2, ray_direction: Vector2, a: Vector2, b: Vector2, maximum_distance: float) -> float:
	var segment_vector := b - a                                                                 # Compute the candidate wall direction.
	var denominator := _cross2(ray_direction, segment_vector)                                  # Measure ray/segment non-parallelism.
	if absf(denominator) < 0.0001:                                                             # Ignore parallel edges.
		return -1.0                                                                                # Report no intersection.
	var offset := a - origin                                                                    # Measure origin to segment start.
	var ray_t := _cross2(offset, segment_vector) / denominator                                 # Solve distance along projectile ray.
	var segment_t := _cross2(offset, ray_direction) / denominator                              # Solve normalized segment position.
	if ray_t < 0.0 or ray_t > maximum_distance or segment_t < 0.0 or segment_t > 1.0:         # Reject hits outside this projectile path.
		return -1.0                                                                                # Report no usable collision.
	return ray_t                                                                                # Return the valid distance.


# Find the first barrel intersected by the horizontal ray at this shot's height.
func _nearest_projectile_barrel_hit(origin: Vector2, direction: Vector2, maximum_distance: float, height: float) -> Dictionary:
	if height < 0.0 or height > BARREL_PROJECTILE_HEIGHT + BARREL_PROJECTILE_TOP_MARGIN:
		return {}
	var nearest_distance := maximum_distance + 1.0
	var nearest_id := -1
	for barrel in world_barrels:
		var distance := _ray_circle_hit_distance(origin, direction, Vector2(barrel.get("position", Vector2.ZERO)), BARREL_PROJECTILE_RADIUS)
		if distance >= 0.0 and distance <= maximum_distance and distance < nearest_distance:
			nearest_distance = distance
			nearest_id = int(barrel.get("id", -1))
	return {"distance": nearest_distance, "id": nearest_id} if nearest_id >= 0 else {}


# _damage_barrel: Apply each resolved projectile once, then remove the prop and its collision.
func _damage_barrel(barrel_id: int, direction: Vector2, impact_position: Vector2, impact_height: float) -> void:
	for index in range(world_barrels.size()):
		var barrel := world_barrels[index]
		if int(barrel.get("id", -1)) != barrel_id:
			continue
		barrel["hits"] = int(barrel.get("hits", 0)) + 1
		if int(barrel["hits"]) < BARREL_HIT_POINTS:
			world_barrels[index] = barrel
			return
		var position: Vector2 = barrel["position"]
		world_barrels.remove_at(index)
		for hole_index in range(active_wall_bullet_holes.size() - 1, -1, -1):
			if int(active_wall_bullet_holes[hole_index].get("barrel_id", -1)) == barrel_id:
				active_wall_bullet_holes.remove_at(hole_index)
		_spawn_barrel_break(position, direction, impact_position, impact_height)
		_drop_barrel_loot(position)
		return


# Roll a small mix, with a rare empty barrel and rare pistol; spread items around the full circle.
func _drop_barrel_loot(position: Vector2) -> void:
	if randf() < 0.03:
		return
	var coin_roll := randf()
	var coin_count := 0 if coin_roll < 0.14 else (1 if coin_roll < 0.51 else (2 if coin_roll < 0.81 else 3))
	var heart_count := 1 if randf() < 0.28 else 0
	var gun_count := 1 if randf() < 0.07 else 0
	if coin_count + heart_count + gun_count == 0:
		coin_count = 1
	var kinds: Array[String] = []
	for index in range(coin_count):
		kinds.append("coin")
	for index in range(heart_count):
		kinds.append("heart")
	for index in range(gun_count):
		kinds.append("gun")
	var start_angle := randf_range(0.0, TAU)
	for index in range(kinds.size()):
		var angle := start_angle + TAU * float(index) / float(kinds.size()) + randf_range(-0.16, 0.16)
		var speed := randf_range(0.48, 0.82)
		var item := {"id": next_combat_visual_id, "position": position, "loot_airborne": true, "loot_height": randf_range(0.20, 0.35), "loot_vertical_velocity": randf_range(0.95, 1.35), "loot_velocity": Vector2(cos(angle), sin(angle)) * speed, "loot_bounces": 1}
		match kinds[index]:
			"coin":
				item["value"] = 1
				item["footprint_kind"] = "coin"
				world_coins.append(item)
			"heart":
				item["footprint_kind"] = "heart"
				world_hearts.append(item)
			"gun":
				item["footprint_kind"] = "gun"
				world_barrel_guns.append(item)
		next_combat_visual_id += 1


# Coins, hearts and guns use the same short arc and one bounce in the shared maze.
# Stop horizontal travel at physical walls so a throw cannot strand loot across one.
func _advance_barrel_loot(delta: float) -> void:
	for items in [world_coins, world_hearts, world_barrel_guns]:
		for item in items:
			if not bool(item.get("loot_airborne", false)):
				continue
			var position: Vector2 = item["position"]
			var velocity: Vector2 = item["loot_velocity"]
			var travel := velocity * delta
			var distance := travel.length()
			if distance > 0.00001:
				var wall_distance := _nearest_projectile_wall_distance(position, travel / distance, distance + 0.03)
				if wall_distance <= distance + 0.03:
					position += travel.normalized() * maxf(wall_distance - 0.03, 0.0)
					velocity = Vector2.ZERO
				else:
					position += travel
			var footprint_kind := String(item.get("footprint_kind", "coin"))
			item["position"] = _resolve_world_item_placement(_world_item_footprint(footprint_kind, position))
			var vertical_velocity := float(item["loot_vertical_velocity"]) - WALL_DEBRIS_GRAVITY * delta
			var height := float(item["loot_height"]) + vertical_velocity * delta
			if height <= 0.0:
				height = 0.0
				if int(item["loot_bounces"]) > 0:
					item["loot_bounces"] = int(item["loot_bounces"]) - 1
					vertical_velocity = absf(vertical_velocity) * WALL_DEBRIS_BOUNCE
					velocity *= 0.42
				else:
					item["loot_airborne"] = false
					vertical_velocity = 0.0
					velocity = Vector2.ZERO
			item["loot_velocity"] = velocity
			item["loot_vertical_velocity"] = vertical_velocity
			item["loot_height"] = height


