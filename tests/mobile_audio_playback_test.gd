extends SceneTree

func _initialize() -> void:
	set_meta("grudge_mobile_wide", true)
	set_meta("grudge_mobile_audio_test", true)
	set_meta("grudge_public_build", true)
	var game = load("res://main.tscn").instantiate()
	root.add_child.call_deferred(game)
	await process_frame
	assert(int(ProjectSettings.get_setting("audio/general/default_playback_type.web")) == 0)
	for player in [game.gunshot_player, game.coin_pickup_player, game.heart_pickup_player, game.machine_gun_pickup_player, game.bot_bark_player, game.clear_map_result_player]:
		assert(player.playback_type == AudioServer.PLAYBACK_TYPE_SAMPLE)
	assert(game.bot_bark_reverb_player.playback_type == AudioServer.PLAYBACK_TYPE_DEFAULT)
	assert(game.music_player.playback_type == AudioServer.PLAYBACK_TYPE_DEFAULT)
	assert(AudioServer.get_bus_name(0) == "Master")
	assert(AudioServer.get_bus_send(AudioServer.get_bus_index("Music")) == "Master")
	assert(AudioServer.get_bus_send(AudioServer.get_bus_index("NPC Voice")) == "Master")
	assert(AudioServer.get_bus_send(AudioServer.get_bus_index("NPC Voice Reverb")) == "NPC Voice")
	for index in range(4):
		var channel: Dictionary = game._footstep_channel(index)
		assert(channel.player.playback_type == AudioServer.PLAYBACK_TYPE_SAMPLE)
		var bus_index := AudioServer.get_bus_index("Actor Footsteps %d" % index)
		assert(bus_index > 0 and AudioServer.get_bus_send(bus_index) == "Master")
	var footstep: Dictionary = game._footstep_channel(0)
	assert(footstep.player.playback_type == AudioServer.PLAYBACK_TYPE_SAMPLE)
	var previous_count: int = game.get_child_count()
	game._reload_sound("Turn")
	assert(game.get_child_count() == previous_count + 1)
	var reload_player = game.get_child(game.get_child_count() - 1)
	assert(reload_player is AudioStreamPlayer)
	assert(reload_player.playback_type == AudioServer.PLAYBACK_TYPE_SAMPLE)
	game.music_player.play()
	game.music_player.call("set_music_mode", "menu")
	assert(not game.music_player.playing)
	remove_meta("grudge_mobile_wide")
	game.music_player.call("set_music_mode", "menu")
	assert(game.music_player.playing)
	game.music_player.stop()
	print("Mobile music stays silent; sound effects use sample playback")
	game.queue_free()
	quit()
